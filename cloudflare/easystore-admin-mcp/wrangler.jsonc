    "EASYSTORE_STORE_DOMAIN": "cardboardcollective.easy.co",
    "EASYSTORE_POD_ID": "1007",
    "EASYSTORE_ADMIN_AUTH_MODE": "bearer",
    "ENABLE_WRITES": "false"
  },
  "observability": { "enabled": true }
}
