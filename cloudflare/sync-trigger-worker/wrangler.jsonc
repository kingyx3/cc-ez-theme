{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cc-sync-trigger",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Hourly, at minute 0 (timezone-independent).
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "GITHUB_REPOSITORY": "kingyx3/cc-ez-theme",
    "WORKFLOW_FILE": "sync-easystore-customers-hubspot.yml",
    "WORKFLOW_REF": "main",
    "DEPLOYMENT_ENVS": "prod,dev"
  }
}
