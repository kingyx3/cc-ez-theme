<!doctype html>
<html class="no-js" lang="{{ shop.locale | default: 'en' | escape }}">
<head>

  <!-- Basic page needs ================================================== -->
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">

  {% if settings.favicon_img %}
  <link rel="icon" href="{{ settings.favicon_img }}" />
  {% endif %}

  <!-- Title and description ================================================== -->
  <title>
  {{ page_title | escape }}{% if current_tags %}{% assign meta_tags = current_tags | join: ', ' %} &ndash; {{ 'general.meta.tags' | t: meta_tags }}{% endif %}{% if current_page != 1 and current_page != blank %} &ndash; {{ 'general.meta.page' | t: current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name | escape }}{% endunless %}
  </title>

  {% if page_description %}
  <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Social meta ================================================== -->
  {% include 'social-meta-tags' %}

  <!-- Helpers ================================================== -->
  <link rel="canonical" href="{{ canonical_url }}">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.colors_accent_1 }}">
  
  <script
    src="https://code.jquery.com/jquery-3.7.1.min.js"
    integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
    crossorigin="anonymous"
  ></script>
  <script
    src="https://code.jquery.com/jquery-migrate-3.6.0.min.js"
    integrity="sha256-LWwll4H5AAC/20gH21NFgk4rYMvZhvc1KD0c5iG7QvM="
    crossorigin="anonymous"
  ></script>
  
  <!-- Header hook for plugins ================================================== -->
  {{ content_for_header }}
  
  
  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'search-history.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'account-recovery-copy.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'account-otp-copy.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'account-otp-autofill.js' | asset_url }}" defer="defer"></script>

  {% comment %}
    If you store has customer accounts disabled, you can remove the following JS file
  {% endcomment %}
  {% if template contains 'customers' %}
    {{ 'shop_common.js' | global_asset_url | script_tag }}
    {{ 'customer_area.js' | global_asset_url | script_tag }}
  {% endif %}
  {% if GA_code != blank %}
  <script>
  (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
  })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');

  ga('create', '{{ GA_code }}', 'auto','myTracker');
  ga('myTracker.send', 'pageview');

  </script>
  {% endif %}
  
  {{ 'storefront.js' | global_asset_url | script_tag }}
  

  <!-- CSS ================================================== -->
  <style>
      @font-face {
        font-family: '{{ settings.type_body_font.font_family }}';
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: local('{{ settings.type_body_font.font_family }} {{ settings.type_body_font.variant }}'), local('{{ settings.type_body_font.font_family }}-{{ settings.type_body_font.variant }}'), url({{settings.type_body_font.variant_file}}) format('truetype');
      }

      @font-face {
        font-family: '{{ settings.type_header_font.font_family }}';
        font-style: normal;
        font-display: swap;
        font-weight: 400;
        src: local('{{ settings.type_header_font.font_family }} {{ settings.type_header_font.variant }}'), local('{{ settings.type_header_font.font_family }}-{{ settings.type_header_font.variant }}'), url({{settings.type_header_font.variant_file}}) format('truetype');
      }

      :root {
        --font-body-family: '{{ settings.type_body_font.font_family }}', {{ settings.type_body_font.category }};
        --font-body-style: {{ settings.body_font_style }};
        --font-body-weight: {{ settings.body_font_weight }};

        --font-heading-family: '{{ settings.type_header_font.font_family }}', {{ settings.type_header_font.category }};
        --font-heading-style: {{ settings.header_font_style }};
        --font-heading-weight: {{ settings.header_font_weight }};

        --color-heading-text: {{ settings.colors_text | color_extract: 'red' }},{{ settings.colors_text | color_extract: 'green' }},{{ settings.colors_text | color_extract: 'blue' }};
        --color-base-text: {{ settings.colors_text | color_extract: 'red' }},{{ settings.colors_text | color_extract: 'green' }},{{ settings.colors_text | color_extract: 'blue' }};
        --color-base-background-1: {{ settings.colors_background_1 | color_extract: 'red' }},{{ settings.colors_background_1 | color_extract: 'green' }},{{ settings.colors_background_1 | color_extract: 'blue' }};
        --color-base-background-2: {{ settings.colors_background_1 | color_extract: 'red' }},{{ settings.colors_background_1 | color_extract: 'green' }},{{ settings.colors_background_1 | color_extract: 'blue' }};
        
        --color-base-solid-button-labels: {{ settings.colors_solid_button_labels | color_extract: 'red' }},{{ settings.colors_solid_button_labels | color_extract: 'green' }},{{ settings.colors_solid_button_labels | color_extract: 'blue' }};
        --color-base-outline-button-labels: {{ settings.colors_outline_button_labels | color_extract: 'red' }},{{ settings.colors_outline_button_labels | color_extract: 'green' }},{{ settings.colors_outline_button_labels | color_extract: 'blue' }};
        
        --color-base-accent-1: {{ settings.colors_accent_1 | color_extract: 'red' }},{{ settings.colors_accent_1 | color_extract: 'green' }},{{ settings.colors_accent_1 | color_extract: 'blue' }};
        --color-base-accent-2: {{ settings.colors_accent_1 | color_extract: 'red' }},{{ settings.colors_accent_1 | color_extract: 'green' }},{{ settings.colors_accent_1 | color_extract: 'blue' }};
        --payment-terms-background-color: {{ settings.colors_background_1 | color_extract: 'red' }},{{ settings.colors_background_1 | color_extract: 'green' }},{{ settings.colors_background_1 | color_extract: 'blue' }};

        --gradient-base-background-1: {{ settings.colors_background_1 | color_extract: 'red' }},{{ settings.colors_background_1 | color_extract: 'green' }},{{ settings.colors_background_1 | color_extract: 'blue' }};
        --gradient-base-background-2: {{ settings.colors_background_1 | color_extract: 'red' }},{{ settings.colors_background_1 | color_extract: 'green' }},{{ settings.colors_background_1 | color_extract: 'blue' }};
        --gradient-base-accent-1: {{ settings.colors_accent_1 | color_extract: 'red' }},{{ settings.colors_accent_1 | color_extract: 'green' }},{{ settings.colors_accent_1 | color_extract: 'blue' }};
        --gradient-base-accent-2: {{ settings.colors_accent_1 | color_extract: 'red' }},{{ settings.colors_accent_1 | color_extract: 'green' }},{{ settings.colors_accent_1 | color_extract: 'blue' }};

        --page-width: {{ settings.page_width | divided_by: 10 }}rem;
      }

      *,
      *::before,
      *::after {
        box-sizing: inherit;
      }

      html {
        box-sizing: border-box;
        font-size: 62.5%;
        height: 100%;
      }

      body {
        display: grid;
        grid-template-rows: auto auto 1fr auto;
        grid-template-columns: 100%;
        min-height: 100%;
        margin: 0;
        font-size: 1.5rem;
        letter-spacing: 0.06rem;
        line-height: 1.8;
        font-family: var(--font-body-family);
        font-style: var(--font-body-style);
        font-weight: var(--font-body-weight);
        {% if settings.body_bg_image != "" and settings.body_bg_image != null %}
        background-image: url('{{ settings.body_bg_image }}');
        background-position: {{ settings.bg_img_position }};
        {% if settings.bg_img_repeat == false %}
          background-repeat: no-repeat;
        {% endif %}
        {% endif %}
      }

      @media screen and (min-width: 750px) {
        body {
          font-size: 1.6rem;
        }
      }
   </style>
  
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'conversion-theme.css' | asset_url | stylesheet_tag }}

  
  {% app_snippet 'global/head' %}

  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
</head>

<body id="{{ page_title | handle }}" class="{% if customer %}customer-logged-in {% endif %}template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }}" >

  <a class="skip-to-content-link button visually-hidden" href="#MainContent">Skip to content</a>

  {% app_snippet 'global/body_start' %}
	
 	{% section 'header' %}
  <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
    {% app_snippet 'global/content_top' %}
    {{ content_for_layout }}
    {% app_snippet 'global/content_bottom' %}
  </main>
 	{% section 'footer' %}
  

  {% include 'currencies' %}

  {% capture quickview_error_label %}{% include 'translation-fallback', translation_key: 'products.product.quickview_error', fallback: 'Product details could not be loaded. Please try again.' %}{% endcapture %}
  {% capture quantity_exceeded_label %}{% include 'translation-fallback', translation_key: 'products.product.quantity_exceeded', fallback: 'Limit reached: __MAXIMUM__ due to __REASON__.' %}{% endcapture %}
  {% capture quantity_maximum_label %}{% include 'translation-fallback', translation_key: 'products.product.quantity_maximum', fallback: 'Limit: __MAXIMUM__ due to __REASON__.' %}{% endcapture %}
  {% capture add_limit_error_label %}{% include 'translation-fallback', translation_key: 'products.product.add_limit_error', fallback: 'This item cannot be added right now.' %}{% endcapture %}
  {% capture low_inventory_label %}{% include 'translation-fallback', translation_key: 'products.product.low_inventory', fallback: 'Only __COUNT__ left' %}{% endcapture %}
  {% capture inventory_limit_label %}{% include 'translation-fallback', translation_key: 'products.product.inventory_limit', fallback: 'available inventory' %}{% endcapture %}
  {% capture purchase_limit_label %}{% include 'translation-fallback', translation_key: 'products.product.purchase_limit', fallback: 'a purchase limit' %}{% endcapture %}
  {% capture store_limit_label %}{% include 'translation-fallback', translation_key: 'products.product.store_limit', fallback: 'a store limit' %}{% endcapture %}
  {% capture customer_limit_label %}{% include 'translation-fallback', translation_key: 'products.product.customer_limit', fallback: 'a customer limit' %}{% endcapture %}
  {% capture promotion_limit_label %}{% include 'translation-fallback', translation_key: 'products.product.promotion_limit', fallback: 'a promotion limit' %}{% endcapture %}
  {% capture order_limit_label %}{% include 'translation-fallback', translation_key: 'products.product.order_limit', fallback: 'an order limit' %}{% endcapture %}
  {% capture quantity_rule_label %}{% include 'translation-fallback', translation_key: 'products.product.quantity_rule', fallback: 'a quantity rule' %}{% endcapture %}
  {% capture configured_limit_label %}{% include 'translation-fallback', translation_key: 'products.product.configured_limit', fallback: 'a configured limit' %}{% endcapture %}
  {% capture clear_history_label %}{% include 'translation-fallback', translation_key: 'general.search.clear_history', fallback: 'Clear history' %}{% endcapture %}

  <script>

    window.variantStrings = {
      addToCart: {{ 'products.product.add_to_cart' | t | json }},
      updateCart: {{ 'cart.general.update' | t | json }},
      soldOut: {{ 'products.product.sold_out' | t | json }},
      unavailable: {{ 'products.product.unavailable' | t | json }},
      quickviewError: {{ quickview_error_label | strip | json }},
    }

    window.accessibilityStrings = {
      shareSuccess: {{ 'general.social.copied_success_message' | t | json }},
    }
    
    window.promotionStrings = {
      title: {{ 'products.product.promotion' | t | json }},
    }

    window.purchaseStrings = {
      quantityExceeded: {{ quantity_exceeded_label | strip | json }},
      quantityMaximum: {{ quantity_maximum_label | strip | json }},
      addLimitError: {{ add_limit_error_label | strip | json }},
      inventoryLimit: {{ inventory_limit_label | strip | json }},
      lowInventory: {{ low_inventory_label | strip | json }},
      purchaseLimit: {{ purchase_limit_label | strip | json }},
      storeLimit: {{ store_limit_label | strip | json }},
      customerLimit: {{ customer_limit_label | strip | json }},
      promotionLimit: {{ promotion_limit_label | strip | json }},
      orderLimit: {{ order_limit_label | strip | json }},
      quantityRule: {{ quantity_rule_label | strip | json }},
      configuredLimit: {{ configured_limit_label | strip | json }},
    }
    
    window.productSettings = {
      variantOptionsDisplay: {{ settings.sections.main-product.settings.variant_options_display | _default: 'radio' | json }},
    }

    window.searchHistoryConfig = {
      clearLabel: {{ clear_history_label | strip | json }},
      customer: {% if customer %}true{% else %}false{% endif %},
      csrfToken: "{% csrf %}",
    }
  </script>

  {% include 'product-quickview-modal' %}
  {% app_snippet 'global/body_end' %}
</body>
</html>
