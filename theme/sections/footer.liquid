<style>
  .footer{
    background-color: {{section.settings.color_footer_background}};
    color: {{section.settings.color_footer_body_text}};
    --color-foreground: {{ section.settings.color_footer_body_text | color_extract: 'red' }},{{ section.settings.color_footer_body_text | color_extract: 'green' }},{{ section.settings.color_footer_body_text | color_extract: 'blue' }};
  }
  .footer .link--text,
  .footer .list-menu__item--link,
  .footer .footer-block__details-content .list-menu__item--link{
    color: {{section.settings.color_footer_body_text}};
  }
  .footer-block__heading{
    color: {{section.settings.color_footer_heading_text}};
  }
  .rounded{
    border-radius: 10px;
  }
  .object-contain{
    object-fit: contain;
  }
  .shopping-app-border{
    border: 1px #ECECEC solid;
    margin-right: 3px;
  }
  .app-download-badge{
    display: inline-block; 
    margin-right: 3px;
  }
</style>

{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer class="footer color-background-1">
  <div class="footer__content-top page-width">
    <div class="grid grid--1-col grid--2-col-tablet">
      {% for block_handle in section.blocks_order %}
      {% assign blocks = section.blocks %}
      {% assign block = blocks[block_handle] %}
        <div class="grid__item">
          {% case block.type %}
            {% when 'about_us' %}
              <h2 class="footer-block__heading">{{ block.settings.title | escape }}</h2>
              <div class="footer-block__details-content">
                {% if block.settings.email %}
                  <p><a class="link link--text" href="mailto:{{ block.settings.email | escape }}">{{ block.settings.email | escape }}</a></p>
                {% elsif block.settings.text %}
                  <p>{{ block.settings.text }}</p>
                {% endif %}
              </div>
            {% when 'follow_us' %}
              <h2 class="footer-block__heading">{{ block.settings.title | escape }}</h2>
              <ul class="footer__list-social list-unstyled list-social footer-block__details-content" role="list">
                {% if block.settings.twitter %}
                  <li class="list-social__item">
                    <a href="{{ block.settings.twitter }}" class="link link--text list-social__link" aria-label="Cardboard Collective on Twitter" target="_blank" rel="noopener noreferrer">
                      {% include 'svg-definitions' with 'icon-twitter' %}
                    </a>
                  </li>
                {% endif %}
                {% if block.settings.facebook %}
                  <li class="list-social__item">
                    <a href="{{ block.settings.facebook }}" class="link link--text list-social__link" aria-label="Cardboard Collective on Facebook" target="_blank" rel="noopener noreferrer">
                      {% include 'svg-definitions' with 'icon-facebook' %}
                    </a>
                  </li>
                {% endif %}
                {% if block.settings.carousell %}
                  <li class="list-social__item">
                    <a href="{{ block.settings.carousell }}" class="link link--text list-social__link" aria-label="Cardboard Collective on Carousell" target="_blank" rel="noopener noreferrer">
                      {% include 'svg-definitions' with 'icon-carousell' %}
                    </a>
                  </li>
                {% endif %}
                {% if block.settings.tiktok %}
                  <li class="list-social__item">
                    <a href="{{ block.settings.tiktok }}" class="link link--text list-social__link" aria-label="Cardboard Collective on TikTok" target="_blank" rel="noopener noreferrer">
                      {% include 'svg-definitions' with 'icon-tiktok' %}
                    </a>
                  </li>
                {% endif %}
                {% if block.settings.whatsapp %}
                  <li class="list-social__item">
                    <a href="{{ block.settings.whatsapp }}" class="link link--text list-social__link" aria-label="Join Cardboard Collective on WhatsApp" target="_blank" rel="noopener noreferrer">
                      {% include 'svg-definitions' with 'icon-whatsapp' %}
                    </a>
                  </li>
                {% endif %}
                {% if block.settings.line %}
                  <li class="list-social__item">
                    <a href="{{ block.settings.line }}" class="link link--text list-social__link" aria-label="Cardboard Collective on Line" target="_blank" rel="noopener noreferrer">
                      {% include 'svg-definitions' with 'icon-line-footer' %}
                    </a>
                  </li>
                {% endif %}
                {% if block.settings.wechat %}
                  <li class="list-social__item">
                    <a href="{{ block.settings.wechat }}" class="link link--text list-social__link" aria-label="Cardboard Collective on WeChat" target="_blank" rel="noopener noreferrer">
                      {% include 'svg-definitions' with 'icon-wechat' %}
                    </a>
                  </li>
                {% endif %}
                {% if block.settings.youtube %}
                  <li class="list-social__item">
                    <a href="{{ block.settings.youtube }}" class="link link--text list-social__link" aria-label="Cardboard Collective on YouTube" target="_blank" rel="noopener noreferrer">
                      {% include 'svg-definitions' with 'icon-youtube' %}
                    </a>
                  </li>
                {% endif %}
                {% app_snippet 'global/social_link' %}
              </ul>
            {% when 'image' %}
              {% if block.settings.image_link %}<a href="{{ block.settings.image_link }}">{% endif %}
                <img
                  src="{{ block.settings.image }}"
                  style="max-width: min(100%, {{ block.settings.image_width }}px);"
                  alt=""
                  loading="lazy"
                >
              {% if block.settings.image_link %}</a>{% endif %}
            {% when 'shopping_app' %}
              <div>
                <h2 class="footer-block__heading">{{ block.settings.title | escape }}</h2>
                <a class="full-unstyled-link" href="{{ shop.shopping_app.download_url }}" target="_blank" rel="noopener noreferrer">
                  {% if shop.shopping_app.icon_url %}
                    <img
                      src="{{ shop.shopping_app.icon_url }}"
                      width="50"
                      height="50"
                      class="rounded shopping-app-border object-contain mr-2"
                      alt="{{ shop.name }}"
                      loading="lazy"
                    >
                  {% endif %}
                  <img
                    src="https://resources.easystore.co/admin/channels/shopping_app.png"
                    class="rounded"
                    width="50"
                    height="50"
                    alt="{{ shop.name | escape }} app"
                    loading="lazy"
                  >
                </a>
                <p class="mt-1">{{ block.settings.text }}</p>
                <a class="full-unstyled-link" href="{{ shop.shopping_app.download_url }}" target="_blank" rel="noopener noreferrer">
                  <img
                    src="https://resources.easystore.co/email-templates/badges/app-store-badge.png"
                    class="app-download-badge"
                    width="100"
                    height="30"
                    alt="App Store"
                    loading="lazy"
                  >
                  <img
                    src="https://resources.easystore.co/email-templates/badges/play-store-badge.png"
                    class="app-download-badge"
                    width="100"
                    height="30"
                    alt="Play Store"
                    loading="lazy"
                  >
                  <img
                    src="https://resources.easystore.co/email-templates/badges/app-gallery-badge.png"
                    class="app-download-badge"
                    width="100"
                    height="30"
                    alt="App Gallery"
                    loading="lazy"
                  >
                </a>
                <br>
              </div>
          {% endcase %}
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="footer__content-bottom">
    <div class="footer__content-bottom-wrapper page-width">
      <div class="footer__column footer__column--info">

        {% include 'currency-picker', class: 'disclosure mb-1' %}
        
        <div class="footer__copyright caption">
          <div class="copyright__content">{{ copyright }}</div>
        </div>

        <div class="footer__copyright caption">
          {% if contents.terms-policy.links %}
            <div>
            {% assign count = 0 %}
            {% for link in contents.terms-policy.links %}
              {% assign policy_title = link.title | downcase %}
              {% assign policy_url = link.url %}
              {% if link.handle == 'terms-of-service' or policy_title contains 'terms of service' %}
                {% assign policy_url = 'https://cardboard.sg/pages/terms-of-service' %}
              {% endif %}
              {% if count == 0 %}
                <a href="{{ policy_url }}">{{ link.title | escape }}</a>
              {% else %}
                | <a href="{{ policy_url }}">{{ link.title | escape }}</a>
              {% endif %}
              {% assign count = count | plus: 1 %}
            {% endfor %}
            </div>
         {% endif %}
        </div>
        
      </div>
    </div>
  </div>
</footer>


