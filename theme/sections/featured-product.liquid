{{ 'section-featured-product.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<!-- {{ 'component-rte.css' | asset_url | stylesheet_tag }} -->

<style>
  .product__info-wrapper{
    display: flex;
    align-items: center;
    padding: 15px;
  }
    
  .featured-product-section .product__media-item img{
    max-height: 600px;
    width:auto;
    max-width:100%;
    margin:0 auto;
    cursor: zoom-in;
  }
  .featured-product-section .product-media-open {
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
  }
  
  @media screen and (min-width: 750px){
    .featured-product-section .product__media-item {
       width: 100%;
    }
  }
</style>

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{% if section.settings.product__id %}
  <div id="FeaturedProduct-{{ section.__key }}" class="product-section page-width spaced-section">
    {% assign handle = section.settings.product__id %}
    {% assign featured_product = products[handle] %}
    <div class="product grid grid--1-col grid--2-col-tablet">
      {% if featured_product.images.size > 0 %}
        <div class="grid__item product__media-wrapper">
          <div class="image-modal-wrapper">
            <slider-component class="slider-mobile-gutter slider--desktop slider-component">
              <ul id="main-image-wrapper-{{ section.__key }}" class="featured-product-section product__media-list grid grid--peek list-unstyled slider slider--mobile" role="list">
                {% if section.settings.show_selected_variant_image and featured_product.selected_or_first_available_variant.featured_image != null %}
                    <li id="image-item-{{ featured_product.selected_or_first_available_variant.featured_image.id }}" class="main-image product__media-item grid__item slider__slide d-flex flex-align-center" data-image-id="{{ featured_product.selected_or_first_available_variant.featured_image.id }}">
                      {% if featured_product.selected_or_first_available_variant.featured_image.type == "Youtube" %}
                        <iframe title="{{ featured_product.title | escape }} video" width="90%" height="320" src="https://www.youtube.com/embed/{{ featured_product.featured_image.id }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                      {% else %}
                        <button type="button" class="product-media-open js-image-modal-toggle" aria-label="Enlarge {{ featured_product.title | escape }}">
                          <img id="main-image" src="{{ featured_product.selected_or_first_available_variant.featured_image.src | img_url: 'social-share' }}" alt="{{ featured_product.selected_or_first_available_variant.featured_image.alt | _default: featured_product.title | escape }}" width="1200" height="1200" loading="eager">
                        </button>
                      {% endif %}
                    </li>
                {% endif %}
                {% for image in featured_product.images %}
                  {% if section.settings.show_selected_variant_image and image.id != featured_product.selected_or_first_available_variant.featured_image.id or section.settings.show_selected_variant_image == false %}
                    <li id="image-item-{{image.id}}" class="main-image product__media-item grid__item slider__slide d-flex flex-align-center" data-image-id="{{ image.id }}">
                      {% if image.type == "Youtube" %}
                        <iframe title="{{ featured_product.title | escape }} video" width="90%" height="320" src="https://www.youtube.com/embed/{{ image.id }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                      {% else %}
                        <button type="button" class="product-media-open js-image-modal-toggle" aria-label="Enlarge {{ image.alt | _default: featured_product.title | escape }}">
                          <img src="{{ image.src | img_url: 'social-share' }}" alt="{{ image.alt | _default: featured_product.title | escape }}" width="1200" height="1200" loading="lazy">
                        </button>
                      {% endif %}
                    </li>
                  {% endif %}
                {% endfor %}
              </ul>
              <div class="slider-buttons no-js-hidden {% if featured_product.images.size < 2 %} medium-hide small-hide {% endif %}">
                <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'accessibility.previous_slide' | t }}">{% include 'svg-definitions' with 'icon-caret' %}</button>
                <div class="slider-counter caption">
                  <span class="slider-counter--current">1</span>
                  <span aria-hidden="true"> / </span>
                  <span class="slider-counter--total">{{ featured_product.images.size }}</span>
                </div>
                <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'accessibility.next_slide' | t }}">{% include 'svg-definitions' with 'icon-caret' %}</button>
              </div>
            </slider-component>
          </div>
        </div>
      {% endif %}
      <div class="grid__item product__info-wrapper">
        <div id="ProductInfo-{{ section.__key }}" class="product__info-container">
          <div class="product-wrapper_color">
            <h2 class="product__title">
              {{ featured_product.title | escape }}
            </h2>

            <!-- price -->
            <div id="price-{{ section.__key }}">
              {% include 'price', product: featured_product, show_badges: true, price_class: 'price--large', product_template: true %}
            </div>
            
            <product-form class="product-form">
              <form action="/cart/add" method="post" enctype="multipart/form-data" data-addtocart='{{prod_d}}' id="AddToCartForm-{{ section.__key }}">
                <div class="variants-selector-wrapper">
                  <select name="id" id="featured-product-select-{{ section.__key }}" class="hide">
                    {% for variant in featured_product.variants %}
                      {% if variant.available %}
                        <option {% if variant == featured_product.selected_or_first_available_variant %} selected="selected" {% endif %} data-sku="{{ variant.sku }}" value="{{ variant.id }}">{{ variant.title }} - {{ variant.price | money: shop.money_format }}</option>
                      {% else %}
                        <option disabled="disabled">
                          {{ variant.title }} - {{ 'products.product.sold_out' | t }}
                        </option>
                      {% endif %}
                    {% endfor %}
                  </select>
                </div>
                <!-- quantity_selector -->
                <div class="product-form__input product-form__quantity">
                  <label class="form__label" for="FeaturedQuantity-{{ section.__key }}">
                    {{ 'products.product.quantity' | t }}
                  </label>
                  <quantity-input class="quantity">
                    <button class="quantity__button no-js-hidden" name="minus" type="button">
                      {% include 'svg-definitions' with 'icon-minus' %}
                    </button>
                    <input class="quantity__input"
                        type="number"
                        name="quantity"
                        id="FeaturedQuantity-{{ section.__key }}"
                        min="1"
                        value="1"
                      >
                    <button class="quantity__button no-js-hidden" name="plus" type="button">
                      {% include 'svg-definitions' with 'icon-plus' %}
                    </button>
                  </quantity-input>
                </div>

                <div class="product-form__buttons">
                  <button
                    type="submit"
                    name="add"
                    id="AddToCart"
                    class="product-form__submit button button--full-width button--primary btn--radius"
                  {% if featured_product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                  >
                      {% if featured_product.selected_or_first_available_variant.available %}
                        {{ 'products.product.add_to_cart' | t }}
                      {% else %}
                        {{ 'products.product.sold_out' | t }}
                      {% endif %}
                  </button>

                </div>
                
                <div class="form__message hidden" tabindex="-1" role="alert">
                  <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
                  {% include 'svg-definitions' with 'icon-error' %}
                  <div class="js-error-content"></div>
                </div>

              </form>
            </product-form>
            
          </div>
        </div> 
      </div>
    </div>
      <!-- The Modal -->
    <div id="FeaturedProductModal-{{ section.__key }}" class="modal hide" role="dialog" aria-modal="true" aria-label="Product image preview" aria-hidden="true">
      <button type="button" class="js-image-modal-close product-media-modal__toggle product-modal-close" aria-label="{{ 'accessibility.close' | t }}">{% include 'svg-definitions' with 'icon-close' %}</button>
      <img class="modal-content" alt="" width="1200" height="1200">
    </div>
  </div>

  <script>


    document.addEventListener( 'DOMContentLoaded', function() {
      
      let this_el = document.querySelector.bind(document),
      all_this_el = document.querySelectorAll.bind(document),
      is_variants_initial = false,
      variants = {{ featured_product.variants | json }},
      variants_unavailable = variants.filter(value => value.available == false);

      var keyId = "{{ section.__key }}";

      var selectCallback = function(variant, selector) {
        VariantSelector.onVariantChange(variant,keyId);
        if(variants_unavailable && variants_unavailable.length > 0 && VariantSelector.updateVariantsUnavailable) VariantSelector.updateVariantsUnavailable(variants,variants_unavailable);
        
        {% if section.settings.show_selected_variant_image %}
          var img_wrapper = document.getElementById("main-image-wrapper-{{ section.__key }}");
          if(variant.featured_image != null && variant.featured_image.id && is_variants_initial){
            const img_item = document.getElementById("image-item-" + variant.featured_image.id);
            if (img_wrapper && img_item) {
              img_wrapper.insertAdjacentElement("afterbegin", img_item);
              setTimeout(function(){img_item.scrollIntoView({block: 'center'})}, 100);
            }

          }
          is_variants_initial = true
        {% endif %}
      }
      
      new EasyStore.OptionSelectors('featured-product-select-{{ section.__key }}', '{{section.settings.variant_options_display}}', {
          product: {{ featured_product | json }},
          onVariantSelected: selectCallback,
          enableHistoryState: false
      })

      //modal
      const sectionRoot = document.getElementById('FeaturedProduct-{{ section.__key }}');
      var product_modal = document.getElementById("FeaturedProductModal-{{ section.__key }}");
      const body = document.body;
      let modalTrigger = null;
      const closeFeaturedProductModal = () => {
        product_modal.classList.add('hide');
        product_modal.classList.remove('show');
        product_modal.setAttribute('aria-hidden', 'true');
        body.style.overflow = '';
        if (modalTrigger) modalTrigger.focus();
      };
      sectionRoot.querySelectorAll('.js-image-modal-toggle').forEach(imageButton => imageButton.addEventListener("click", ()=>{
        var modalImg = product_modal.querySelector('.modal-content');
        const image = imageButton.querySelector('img');
        modalTrigger = imageButton;
        product_modal.classList.remove("hide");
        product_modal.classList.add("show");
        product_modal.setAttribute('aria-hidden', 'false');
        modalImg.src = image.src;
        modalImg.alt = image.alt;
        body.style.overflow = "hidden";
        product_modal.querySelector('.product-modal-close').focus();
      }))

      var modal_close = product_modal.querySelector('.product-modal-close');
      modal_close.addEventListener('click', closeFeaturedProductModal);
      product_modal.addEventListener('click', (event) => {
        if (event.target === product_modal) closeFeaturedProductModal();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && product_modal.classList.contains('show')) closeFeaturedProductModal();
      });
      
    });
      

      
  </script>
{% else %}
  <div class="page-width spaced-section text-center">
    <img src="{{settings.placeholder.featured_single_product}}" alt="" width="1100" height="700" loading="lazy"/>
  </div>
{% endif %}

{% schema %}
{
  "type": "featured_product",
    "name": {
      "en_US": "Featured Product",
      "zh_CN": "特色商品",
      "zh_TW": "特色商品",
      "ms_MY": "Koleksi"
    },
  	"settings": [
    {
      "type": "product",
      "id": "product__id",
      "label": {
        "en_US": "Product",
        "ja_JP": "コレクション",
        "ko_KR": "컬렉션",
        "ms_MY": "Koleksi",
        "th_TH": "คอลเลกชัน",
        "zh_CN": "目录",
        "zh_TW": "目錄"
      }
    },
    {
      "type": "select",
      "id": "variant_options_display",
      "label": {
        "en_US": "Variant options display",
        "zh_TW": "規格顯示方式", 
        "zh_CN": "规格显示方式", 
        "ms_MY": "Paparan pilihan spesifikasi"
      },
      "default": "radio",
      "options": [
        {
          "value": "radio",
          "label": {
            "en_US": "Tag",
            "zh_TW": "標籤", 
            "zh_CN": "标签", 
            "ms_MY": "Tag"
          }
        },
        {
          "value": "select",
          "label": {
            "en_US": "Select",
            "zh_TW": "下拉選單", 
            "zh_CN": "下拉选单", 
            "ms_MY": "Pilih"
          }
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_selected_variant_image",
      "default": false,
      "label": {
        "en_US": "Display selected product variant image",
        "zh_TW": "顯示選定商品規格的图像", 
        "zh_CN": "显示选定商品规格的图像", 
        "ms_MY": "Paparkan imej spesifikasi produk yang dipilih"
      }
    }
  ],
  "presets": [
    {
      "name": {
        "en_US": "Featured Product",
        "zh_CN": "特色商品",
        "zh_TW": "特色商品",
        "ms_MY": "Koleksi"
      },
      "blocks": [
        {
          "type": "featured-product"
        }
      ]
    }
  ]
}
{% endschema %}
