      <div class="header__left-icon header__icons large-up-hide">
        <header-drawer data-breakpoint="tablet">
          <details class="menu-drawer-container">
            <summary class="header__icon header__icon--menu header__icon--summary link link--text focus-inset" aria-label="Menu" role="button" aria-expanded="false" aria-controls="menu-drawer">
              <span>
                {% include 'svg-definitions' with 'icon-hamburger' %}
                {% include 'svg-definitions' with 'icon-close' %}
              </span>
            </summary>
            <div id="menu-drawer" class="menu-drawer motion-reduce" tabindex="-1">
              <div class="menu-drawer__inner-container">
                <div class="menu-drawer__navigation-container">
                  <nav class="menu-drawer__navigation">
                    <ul class="menu-drawer__menu list-menu" role="list">
                      <li><a href="/collections/the-hobbit" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">Hobbit</a></li>
                      <li><a href="/collections/marvel-super-heroes" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">Marvel</a></li>
                      <li><a href="/collections/secrets-of-strixhaven" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">Strixhaven</a></li>
                      <li><a href="/pages/about-us" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">About Us</a></li>
                    </ul>
                  </nav>
  
                  <div class="menu-drawer__utility-links">
  
                    {% include 'currency-picker', class: 'menu-drawer__account disclosure' %}
  
                    {% if shop.customer_accounts_enabled %}
                    {% if customer %}
                    {% for link in contents.after-login.links %}
                      {% assign navigation_url = link.url | downcase %}
                      {% assign navigation_title = link.title | downcase %}
                      {% unless navigation_url contains 'wishlist' or navigation_title contains 'wishlist' %}
                      <a href="{{link.url}}" class="menu-drawer__account link link--text focus-inset h5">
                        {% if link.url == '/account' %} {% include 'svg-definitions' with 'icon-account' %} {% endif %}
                        {% if link.url == '/account/logout' %} {% include 'svg-definitions' with 'icon-arrow' %} {% endif %}
                        {{link.title}}
                      </a>
                      {% endunless %}
                    {% endfor %}
                    {% else %}
                    {% for link in contents.before-login.links %}
                      {% assign navigation_url = link.url | downcase %}
                      {% assign navigation_title = link.title | downcase %}
                      {% unless navigation_url contains 'wishlist' or navigation_title contains 'wishlist' %}
                      <a href="{{link.url}}" class="menu-drawer__account link link--text focus-inset h5">
                        {% if link.url == '/account/login' %} {% include 'svg-definitions' with 'icon-account' %} {% endif %}
                        {% if link.url == '/account/register' %} {% include 'svg-definitions' with 'icon-plus' %} {% endif %}
                        {{link.title}}
                      </a>
                      {% endunless %}
                    {% endfor %}
                    {% endif %}
                    {% endif %}
                  </div>
                </div>
              </div>
            </div>
          </details>
        </header-drawer>
        {% include 'search-modal', search_id: 'HeaderMobileSearch' %}
      </div>
  
      {% if section.settings.logo %}
        <a href="/" class="header__heading-link link link--text focus-inset" itemprop="url">
          {% if section.settings.transparent_header %}
            <img src="{{ section.settings.logo_secondary }}" class="header__heading-logo header__logo_secondary" alt="{{ shop.name | escape }}" loading="eager">
          {% endif %}
          <img src="{{ section.settings.logo }}" class="header__heading-logo" alt="{{ shop.name | escape }}" loading="eager" fetchpriority="high" itemprop="logo">
        </a>
      {% else %}
        <h1 class="header__heading">
          <a href="/" class="header__heading-link link link--text focus-inset">{{ shop.name | escape }}</a>
        </h1>
      {% endif %}
      <nav class="header__inline-menu">
        <ul class="list-menu list-menu--inline" role="list">
          <li><a href="/collections/the-hobbit" class="header__menu-item list-menu__item link link--text focus-inset">Hobbit</a></li>
          <li><a href="/collections/marvel-super-heroes" class="header__menu-item list-menu__item link link--text focus-inset">Marvel</a></li>
          <li><a href="/collections/secrets-of-strixhaven" class="header__menu-item list-menu__item link link--text focus-inset">Strixhaven</a></li>
          <li class="header__nav-item--about"><a href="/pages/about-us" class="header__menu-item list-menu__item link link--text focus-inset">About Us</a></li>
        </ul>
      </nav>
      <div class="header__icons">
        <div class="medium-hide small-hide">
          {% include 'search-modal', search_id: 'HeaderDesktopSearch' %}
        </div>
        
        {% if shop.customer_accounts_enabled %}
          {% if customer %}
            <div class="header__icon header__icon--account link link--text focus-inset small-hide medium-hide">   
              <details-disclosure>
                <details>
                  <summary class="header__icon link link--text focus-inset p-2" aria-label="Account menu" aria-expanded="false">
                    {% include 'svg-definitions' with 'icon-account' %}
                  </summary>
                  <ul class="header__submenu list-menu list-menu--disclosure caption-large motion-reduce" role="list" tabindex="-1" style="margin-left: -60px;">
                    {% for link in contents.drop-down-after-login.links %}
                      {% assign navigation = 'customer.account.navigation.' | append: link.handle %}
                      {% assign navigation_url = link.url | downcase %}
                      {% assign navigation_title = link.title | downcase %}
                      {% unless navigation_url contains 'wishlist' or navigation_title contains 'wishlist' %}
                      {% if link.url != '/account/logout' %}
                        <li>
                          <a href="{{ link.url }}" class="header__menu-item list-menu__item link link--text focus-inset caption-large">{{ navigation | t }}</a>
                        </li>
                      {% endif %}
                      {% endunless %}
                    {% endfor %}
                    <li>
                      <a href="/account/logout" class="header__menu-item list-menu__item link link--text focus-inset caption-large">{{ "customer.account.navigation.logout" | t }}</a>
                    </li>
                  </ul>
                </details>
              </details-disclosure>
            </div>
          {% else %}
            <div class="header__icon header__icon--account link link--text focus-inset small-hide medium-hide" style="position: relative;">
              <a href="/account/login" class="header__icon link link--text focus-inset p-2">
                {% include 'svg-definitions' with 'icon-account' %}
              </a>

              <!-- Referral Notification Popup for Desktop -->
              <div id="referralNotification" class="referral-notification" style="display: none;">
                <button type="button" class="close-btn" aria-label="Close referral notification" onclick="dismissReferralNotification()">&times;</button>
                <div style="text-align: center; margin-bottom: 16px;">
                  <div style="width: 100px; height: 100px; margin: 0 auto;">
                    <img src="https://resources.easystore.co/storefront/icons/channels/vector_referral_program.svg" alt="" width="100" height="100">
                  </div>
                </div>
                <p id="referralSignupMessage" style="text-align: center; font-size: 14px; color: #666; margin: 0 0 20px 0;">
                  {{ 'customer.account.referral.signup_message' | t }}
                </p>
                <div style="text-align: center;">
                  <button type="button" class="btn" onclick="goToSignupPage()" style="width: 100%;">
                    {{ 'customer.account.referral.signup_button' | t }}
                  </button>
                </div>
              </div>
            </div>
          {% endif %}
        {% elsif contents.extra-account-option.links %}
          <div class="header__icon header__icon--account link link--text focus-inset small-hide medium-hide">
            {% for link in contents.extra-account-option.links %}
              {% assign navigation_url = link.url | downcase %}
              {% assign navigation_title = link.title | downcase %}
              {% unless navigation_url contains 'wishlist' or navigation_title contains 'wishlist' %}
              {% assign navigation = 'customer.account.navigation.' | append: link.handle %}
              <a href="{{ link.url }}" class="header__icon link link--text focus-inset" aria-label="{{ navigation | t }}">
                {% include 'svg-definitions' with 'icon-history' %}
              </a>
              {% endunless %}
            {% endfor %} 
          </div>
        {% endif %}

        <a href="/cart" class="header__icon header__icon--cart link link--text focus-inset" id="cart-icon-bubble">
          {% include 'svg-definitions' with 'icon-cart' %}
          <div class="cart-count-bubble {% if cart.item_count <= 0 or cart.item_count == null %}hidden{% endif %}">
            <span aria-hidden="true" class="js-content-cart-count">{{cart.item_count}}</span>
          </div>
        </a>

        {% if shop.customer_accounts_enabled %}
          {% if customer == null %}
          <!-- Referral Notification Modal for Mobile -->
          <details-modal class="referral-modal" id="referralMobileModal">
            <details>
              <summary class="referral-modal__toggle" aria-haspopup="dialog" aria-label="Open referral modal" style="display: none;">
              </summary>
              <div class="modal-overlay referral-modal-overlay"></div>
              <div class="referral-modal__dialog" role="dialog" aria-modal="true" aria-label="Referral notification">
                <div class="referral-modal__content">
                  <button type="button" class="modal__close-button" aria-label="Close" onclick="closeMobileReferralModal()" style="position: absolute; top: 16px; right: 16px; background: none; border: none; font-size: 24px; cursor: pointer;">
                    &times;
                  </button>
                  
                  <div style="margin-bottom: 24px;">
                    <div style="width: 120px; height: 120px; margin: 0 auto 20px;">
                      <img src="https://resources.easystore.co/storefront/icons/channels/vector_referral_program.svg" alt="" width="120" height="120" style="width: 100%; height: 100%;">
                    </div>
                  </div>
                  
                  <p id="referralSignupMessageMobile" style="font-size: 16px; color: #333; margin: 0 0 30px 0; line-height: 1.5;">
                    {{ 'customer.account.referral.signup_message' | t }}
                  </p>
                  
                  <button type="button" class="btn" onclick="goToSignupPageFromMobile()" style="width: 100%;">
                    {{ 'customer.account.referral.signup_button' | t }}
