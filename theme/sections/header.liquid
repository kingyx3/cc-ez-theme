<link rel="preload" href="{{ 'component-cart-notification.css?v1.1' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>

