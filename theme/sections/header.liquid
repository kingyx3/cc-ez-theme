<div id="easystore-section-header">
  {% if section.settings.message %}
    <div
      class="announcement-bar"
      role="region"
      aria-label="Store announcement"
      style="--announcement-background: {{ section.settings.color_bg }}; --announcement-color: {{ section.settings.announcement_text_color }};"
