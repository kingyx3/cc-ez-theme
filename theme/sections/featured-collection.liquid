{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-product-grid.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{% assign collection_id = section.settings.collection__id %}
{% assign collection = collections[collection_id] %}
{% assign products_to_show = section.settings.products_to_show %}

{% assign products_to_display = collection.product_count | default: 0 %}

{% if products_to_display > products_to_show %}
  {% assign products_to_display = products_to_show %}
  {% assign more_in_collection = true %}
{% endif %}

<div
  id="section-{{ section.__key }}"
  class="sales-collection page-width{% if section.settings.swipe_on_mobile == true and products_to_display > 2 and products_to_show > 2 %} page-width-desktop{% endif %}{% if section.settings.title == '' %} mt-0{% endif %}"
  style="--section-accent: {{ section.settings.accent_color }}; --product-surface: {{ section.settings.product_bg_color }};"
>
  {% include 'featured-collection-header', collection: collection, products_to_display: products_to_display, products_to_show: products_to_show, more_in_collection: more_in_collection %}
  {% include 'featured-collection-products', collection: collection, collection_id: collection_id, products_to_display: products_to_display, products_to_show: products_to_show %}
</div>

{% schema %}
  {
    "name": {
      "en_US": "Featured Collection",
      "zh_TW": "精選商品目錄",
      "zh_CN": "精选商品目录",
      "ms_MY": "Koleksi Terpilih"
    },
    "tag": "section",
    "class": "spaced-section",
    "settings": [
      {
        "type": "text",
        "id": "eyebrow",
        "default": "CURATED FOR YOU",
        "label": {
          "en_US": "Eyebrow"
        }
      },
      {
        "type": "text",
        "id": "title",
        "default": "Featured collection",
        "label": {
          "en_US": "Heading",
          "ja_JP": "見出し",
          "ko_KR": "제목",
          "ms_MY": "Tajuk",
          "th_TH": "ส่วนหัว",
          "zh_CN": "商品分类标题",
          "zh_TW": "商品分類標題"
        }
      },
      {
        "type": "text",
        "id": "subtitle",
        "default": "Discover standout picks from the collection.",
        "label": {
          "en_US": "Supporting text"
        }
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#C44120",
        "label": {
          "en_US": "Accent color"
        }
      },
      {
        "type": "collection",
        "id": "collection__id",
        "default": "feature-on-homepage",
        "label": {
          "en_US": "Collection",
          "ja_JP": "コレクション",
          "ko_KR": "컬렉션",
          "ms_MY": "Koleksi",
          "th_TH": "คอลเลกชัน",
          "zh_CN": "分类",
          "zh_TW": "分類"
        }
      },
      {
        "type": "range",
        "id": "products_per_row",
        "min": 2,
        "max": 5,
        "step": 1,
        "default": 4,
        "label": {
          "en_US": "Collections per row",
          "ja_JP": "行あたりのコレクション数",
          "ko_KR": "열 별 컬렉션",
          "ms_MY": "Koleksi setiap baris",
          "th_TH": "คอลเลกชันต่อแถว",
          "zh_CN": "目录每行显示数量",
          "zh_TW": "目錄每行顯示數量"
        }
      },
      {
        "type": "range",
        "id": "products_to_show",
        "min": 2,
        "max": 20,
        "step": 1,
        "default": 8,
        "label": {
          "en_US": "Products display",
          "ja_JP": "行あたりのコレクション数",
          "ko_KR": "열 별 컬렉션",
          "ms_MY": "Koleksi setiap baris",
          "th_TH": "คอลเลกชันต่อแถว",
          "zh_CN": "商品展示总数",
          "zh_TW": "商品展示總數"
        }
      }, {
        "type": "checkbox",
        "id": "show_view_all",
        "default": true,
        "label": {
          "en_US": "Show all button",
          "zh_TW": "顯示按鈕",
          "zh_CN": "显示按钮",
          "ms_MY": "Tunjukkan semua butang"
        }
      }, {
        "type": "select",
        "id": "image_ratio",
        "options": [
          {
            "value": "portrait",
            "label": {
              "en_US": "Portrait",
              "zh_TW": "直向",
              "zh_CN": "直向",
              "ms_MY": "Potret"
            }
          },
          {
            "value": "landscape",
            "label": {
              "en_US": "Landscape",
              "zh_TW": "橫向",
              "zh_CN": "横向",
              "ms_MY": "Melintang"
            }
          },
          {
            "value": "square",
            "label": {
              "en_US": "Square",
              "zh_TW": "正方形",
              "zh_CN": "正方形",
              "ms_MY": "Segi empat sama"
            }
          },
          {
            "value": "circle",
            "label": {
              "en_US": "Circle",
              "zh_TW": "圓形",
              "zh_CN": "圆形",
              "ms_MY": "Bulat"
            }
          }, {
            "value": "16-9",
            "label": "16:9"
          }
        ],
        "default": "square",
        "label": {
          "en_US": "Image Ratio",
          "zh_TW": "圖片比例",
          "zh_CN": "图片比例",
          "ms_MY": "Nisbah Imej"
        }
      }, {
        "type": "checkbox",
        "id": "show_secondary_image",
        "default": false,
        "label": {
          "en_US": "Show secondary image",
          "zh_TW": "顯示次要圖片",
          "zh_CN": "显示次要图像",
          "ms_MY": "Tunjukkan imej sekunder"
        }
      }, {
        "type": "checkbox",
        "id": "swipe_on_mobile",
        "default": true,
        "label": {
          "en_US": "Swipe on Mobile",
          "zh_TW": "手機版顯示滑動圖片",
          "zh_CN": "手机版显示滑动图片",
          "ms_MY": "Leret pada mudah alih"
        }
      }, {
        "type": "checkbox",
        "id": "center_title",
        "default": false,
        "label": {
          "en_US": "Center Title",
          "zh_TW": "標題置中",
          "zh_CN": "标题置中",
          "ms_MY": "Tajuk Tengah"
        }
      }, {
        "type": "checkbox",
        "id": "show_product_info",
        "default": true,
        "label": {
          "en_US": "Show Product Info",
          "zh_TW": "顯示產品資料",
          "zh_CN": "显示产品资料",
          "ms_MY": "Tunjuk info Produk"
        }
      }, {
        "type": "color",
        "id": "product_bg_color",
        "default": "rgba(245, 245, 245, 1)",
        "label": {
          "en_US": "Product background color",
          "zh_TW": "產品背景色",
          "zh_CN": "产品背景色",
          "ms_MY": "Warna latar belakang produk"
        }
      }
    ],
    "presets": [
      {
        "name": {
          "en_US": "Featured Collection",
          "zh_TW": "精選商品目錄",
          "zh_CN": "精选商品目录",
          "ms_MY": "Koleksi Terpilih"
        }
      }
    ]
  }
{% endschema %}
