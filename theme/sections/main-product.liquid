<!-- {{ 'component-rte.css' | asset_url | stylesheet_tag }} -->
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
{{ 'component-quantity-limit.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<style>
  .product-wrapper_color{
    background-color: {{section.settings.wrapper_bg_color}};
    padding: clamp(1.8rem, 4vw, 3rem);
    border-radius: clamp(1.2rem, 3vw, 2rem);
  }
  .product__info-wrapper .product-card-wrapper{
    background-color: {{section.settings.wrapper_bg_color}};
  }
</style>

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<section class="product-section page-width spaced-section">


  {% app_snippet 'product/content_top' %}
  <div class="product grid grid--1-col grid--2-col-tablet">
    
    {% if product.images.size > 0 %}
      <div class="grid__item product__media-wrapper">
        <div class="image-modal-wrapper">
          <slider-component class="slider-mobile-gutter slider-component">
            <ul id="main-image-wrapper-{{ section.__key }}" class="product__media-list grid grid--peek list-unstyled slider slider--mobile" role="list">
              {% for image in product.images %}
                <li id="image-item-{{image.id}}" class="main-image product__media-item grid__item slider__slide d-flex flex-align-center" data-image-id="{{ image.id }}">
                  {% if image.type == "Youtube" %}
                    <iframe class="product-media-video" title="{{ product.title | escape }} video" width="560" height="315" src="https://www.youtube.com/embed/{{ image.id }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                  {% else %}
                    {% assign product_image_alt = image.alt | _default: product.title %}
                    <button type="button" class="product-media-open js-image-modal-toggle" aria-label="Enlarge {{ product_image_alt | escape }}">
                      <img src="{{ image.src | img_url: 'social-share' }}" alt="{{ product_image_alt | escape }}" width="1200" height="1200" {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}>
                    </button>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
            <div class="slider-buttons no-js-hidden {% if product.images.size < 2 %} medium-hide small-hide {% endif %}">
              <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'accessibility.previous_slide' | t }}">{% include 'svg-definitions' with 'icon-caret' %}</button>
              <div class="slider-counter caption" aria-live="polite">
                <span class="slider-counter--current">1</span>
                <span aria-hidden="true"> / </span>
                <span class="slider-counter--total">{{ product.images.size }}</span>
              </div>
              <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'accessibility.next_slide' | t }}">{% include 'svg-definitions' with 'icon-caret' %}</button>
            </div>
          </slider-component>
          {% app_snippet 'product/content_left' %}
        </div>
      </div>
    {% else %}

      <div class="grid__item product__media-wrapper text-center">
        {% assign featured_image = product.selected_or_first_available_variant.featured_image | default: product.featured_image %}
        <img class="product__media-fallback" src="{{ featured_image | img_url: '1024x' }}" alt="{{ featured_image.alt | _default: product.title | escape }}" width="1024" height="1024" loading="eager" fetchpriority="high">
      </div>
      
    {% endif %}


    <div class="grid__item product__info-wrapper">
      <div id="ProductInfo-{{ section.__key }}" class="product__info-container product__info-container--sticky">
        <div class="product-wrapper_color">
          {% if section.settings.show_product_brand and product.brands[0] %}
            <p class="product__text">
              {{ product.brands[0] }}
            </p>
          {% endif %}

          <h1 class="product__title">
            {{ product.title | escape }}
          </h1>

          <!-- price -->
          <div id="price-{{ section.__key }}">
            {% include 'price', product: product, show_badges: true, price_class: 'price--large', product_template: true %}
          </div>

          <div class="product_upsell-info">
            {% for block_handle in section.blocks_order %}
              {% assign blocks = section.blocks %}
              {% assign block = blocks[block_handle] %}
              <div class="product_upsell-box">
                {% if block.settings.image and block.settings.image != '' %}
                  <div class="product_upsell-icon">
                    <img src="{{ block.settings.image }}" alt="{{ block.settings.text }} | {{ shop.name }}" width="24" height="24" loading="lazy">
                  </div>
                {% endif %}
                {% if block.settings.text != '' %}
                  <div class="product_upsell-text">
                    {{ block.settings.text }}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>

          <product-form class="product-form">
            <form action="/cart/add" method="post" enctype="multipart/form-data" data-addtocart='{{prod_d}}' id="AddToCartForm-{{ section.__key }}">

              {% app_snippet 'product/field_top' %}
              
              <div class="variants-selector-wrapper">
                <select name="id" id="productSelect-{{ section.__key }}" class="hide">
                  {% for variant in product.variants %}
                    {% if variant.available %}

                      <option {% if variant == product.selected_or_first_available_variant %} selected="selected" {% endif %} data-sku="{{ variant.sku }}" data-inventory-quantity="{{ variant.inventory_quantity }}" value="{{ variant.id }}">{{ variant.title }} - {{ variant.price | money: shop.money_format }}</option>

                    {% else %}
                      <option disabled="disabled">
                        {{ variant.title }} - {{ 'products.product.sold_out' | t }}
                      </option>
                    {% endif %}
                  {% endfor %}
                </select>
              </div>

              {% app_snippet 'product/field_middle' %}

              {% include 'low-inventory-notice', low_inventory_variant: product.selected_or_first_available_variant, low_inventory_persist: true %}

              <!-- quantity_selector -->
              <div class="product-form__input product-form__quantity">
                <label class="form__label" for="Quantity-{{ section.__key }}">
                  {{ 'products.product.quantity' | t }}
                </label>

                <quantity-input class="quantity">
                  <button class="quantity__button no-js-hidden" name="minus" type="button">
                    {% include 'svg-definitions' with 'icon-minus' %}
                  </button>
                  <input class="quantity__input"
                      type="number"
                      name="quantity"
                      id="Quantity-{{ section.__key }}"
                      aria-describedby="QuantityLimit-{{ section.__key }}"
                      min="1"
                      value="1"
                    >
                  <button class="quantity__button no-js-hidden" name="plus" type="button">
                    {% include 'svg-definitions' with 'icon-plus' %}
                  </button>
                </quantity-input>
                <p
                  id="QuantityLimit-{{ section.__key }}"
                  class="quantity-limit-message hidden"
                  data-quantity-limit-message
                  role="status"
                  aria-live="polite"
                ></p>
              </div>


              <div class="product-form__buttons">

                {% app_snippet 'product/field_bottom' %}

                <button
                  type="submit"
                  name="add"
                  id="AddToCart"
                  class="product-form__submit product-form__submit--accent-outline button button--full-width button--secondary btn--radius"
                {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                >
                    {% if product.selected_or_first_available_variant.available %}
                      {{ 'products.product.add_to_cart' | t }}
                    {% else %}
                      {{ 'products.product.sold_out' | t }}
                    {% endif %}
                </button>

                <button
                  type="button"
                  name="buy_now"
                  data-buy-now
                  class="product-form__submit product-form__buy-now button button--full-width button--primary btn--radius"
                {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                >
                  {% include 'translation-fallback', translation_key: 'products.product.buy_now', fallback: 'Buy now' %}
                </button>

                {% app_snippet 'product/button' %}

              </div>
              
              <div class="form__message hidden" tabindex="-1" role="alert">
                <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
                {% include 'svg-definitions' with 'icon-error' %}
                <div class="js-error-content"></div>
              </div>

            </form>

            <form action="/cart" method="post" data-buy-now-checkout-form hidden>
              <input type="hidden" name="_token" value="{% csrf %}">
              <input type="hidden" name="current_currency" value="{{ shop.selected_currency }}">
              <input type="hidden" name="checkout" value="true">
            </form>

            <dialog
              class="buy-now-limit-modal"
              data-checkout-limit-modal
              aria-modal="true"
              aria-labelledby="BuyNowLimitTitle-{{ section.__key }}"
              aria-describedby="BuyNowLimitDescription-{{ section.__key }}"
            >
              <div class="buy-now-limit-modal__content">
                <button
                  type="button"
                  class="buy-now-limit-modal__close"
                  data-checkout-limit-cancel
                  aria-label="{{ 'accessibility.close' | t }}"
                >
                  {% include 'svg-definitions' with 'icon-close' %}
                </button>

                <h2 id="BuyNowLimitTitle-{{ section.__key }}" class="buy-now-limit-modal__title">
                  {% include 'translation-fallback', translation_key: 'products.product.continue_without_item', fallback: 'Continue without this item?' %}
                </h2>

                <div id="BuyNowLimitDescription-{{ section.__key }}">
                  <p class="buy-now-limit-modal__reason" data-checkout-limit-message></p>
                  <p class="buy-now-limit-modal__text">
                    {% include 'translation-fallback', translation_key: 'products.product.not_added_checkout_current_cart', fallback: 'The item was not added to your cart. You can adjust your selection, or continue to checkout with your current cart.' %}
                  </p>
                </div>

                <div class="buy-now-limit-modal__actions">
                  <button
                    type="button"
                    class="button button--secondary btn--radius"
                    data-checkout-limit-cancel
                  >
                    {% include 'translation-fallback', translation_key: 'products.product.stay_on_product_page', fallback: 'Stay on product page' %}
                  </button>
                  <button
                    type="button"
                    class="button button--primary btn--radius"
                    data-checkout-limit-continue
                  >
                    {% include 'translation-fallback', translation_key: 'products.product.continue_to_checkout', fallback: 'Continue to checkout' %}
                  </button>
                </div>
              </div>
            </dialog>
          </product-form>


          <div>
            {% include 'social-sharing', share_id: section.__key %}
          </div>

        
        </div>

        {% app_snippet 'product/description_top' %}

        {% if product.description != blank %}
          <div class="product-description product__description rte" itemprop="description">
            {{ product.description }}
          </div> 
        {% endif %}


      </div> 
      {% app_snippet 'product/content_right' %}
    </div>
  </div>

  {% app_snippet 'product/description_bottom' %}

  {% app_snippet 'product/content_bottom' %}
  
    <!-- The Modal -->
  <div id="product-modal" class="modal hide" role="dialog" aria-modal="true" aria-label="Product image preview" aria-hidden="true">
    <button type="button" class="js-image-modal-close product-media-modal__toggle product-modal-close" aria-label="{{ 'accessibility.close' | t }}">{% include 'svg-definitions' with 'icon-close' %}</button>
    <img class="modal-content" id="modal-img" alt="" width="1200" height="1200">
  </div>

</section>

{% if settings.product_related_enable %}
  <section class="product-section page-width spaced-section">
    {% include 'related-products' %}
  </section>
{% endif %}

<script type="application/ld+json">
  {{ product | structured_data: shop }}
</script>


<script>
  let this_el = document.querySelector.bind(document),
      all_this_el = document.querySelectorAll.bind(document),
      is_variants_initial = false,
      variants = {{ product.variants | json }},
      variants_unavailable = variants.filter(value => value.available == false);
      
  window.addEventListener('load', () => {
    const imageWrapper = document.getElementById("main-image-wrapper-{{ section.__key }}");
    if (imageWrapper) imageWrapper.scrollTo({left: 0, behavior: "smooth"});
  });

  document.addEventListener( 'DOMContentLoaded', function() {

    var selectCallback = function(variant, selector) {
      VariantSelector.onVariantChange(variant,"{{ section.__key }}");
      if(variants_unavailable && variants_unavailable.length > 0 && VariantSelector.updateVariantsUnavailable) VariantSelector.updateVariantsUnavailable(variants,variants_unavailable);
      
      {% if section.settings.show_selected_variant_image %}
        var img_wrapper = document.getElementById("main-image-wrapper-{{ section.__key }}");
        if(variant.featured_image != null && variant.featured_image.id && is_variants_initial){
          const img_item = document.getElementById("image-item-" + variant.featured_image.id);
          if (img_wrapper && img_item) {
            img_wrapper.insertAdjacentElement("afterbegin", img_item);
            img_wrapper.scrollTo({left: 0, behavior: "smooth"});
          }
        }
        is_variants_initial = true
      {% endif %}

    }

    new EasyStore.OptionSelectors('productSelect-{{ section.__key }}', '{{section.settings.variant_options_display}}', {
        product: {{ product | json }},
        onVariantSelected: selectCallback,
        enableHistoryState: false
    })

    //modal
    var product_modal = document.getElementById("product-modal");
    const body = document.body;
    let modalTrigger = null;
    const closeProductModal = () => {
      product_modal.classList.add('hide');
      product_modal.classList.remove('show');
      product_modal.setAttribute('aria-hidden', 'true');
      body.style.overflow = '';
      if (modalTrigger) modalTrigger.focus();
    };

    all_this_el('.js-image-modal-toggle').forEach(imageButton => imageButton.addEventListener("click", ()=>{
      var modalImg = document.getElementById("modal-img");
      const image = imageButton.querySelector('img');
      modalTrigger = imageButton;
      product_modal.classList.remove("hide");
      product_modal.classList.add("show");
      product_modal.setAttribute('aria-hidden', 'false');
      modalImg.src = image.src;
      modalImg.alt = image.alt;
      body.style.overflow = "hidden";
      product_modal.querySelector('.product-modal-close').focus();
    }))

    var modal_close = document.getElementsByClassName("product-modal-close")[0];
    if (modal_close) modal_close.addEventListener('click', closeProductModal);
    product_modal.addEventListener('click', (event) => {
      if (event.target === product_modal) closeProductModal();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && product_modal.classList.contains('show')) closeProductModal();
    });
  
  });

  // Keep a small, valid product history without breaking the product page when
  // storage is unavailable or EasyStore omits view_history.
  (() => {
    const storageKey = 'productViewHistory';
    const currentViewedProduct = {{ product.view_history | json }};
    if (!currentViewedProduct || typeof currentViewedProduct !== 'object' || currentViewedProduct.product_id == null) return;

    try {
      const storedHistory = JSON.parse(localStorage.getItem(storageKey) || '[]');
      const productViewHistoryData = (Array.isArray(storedHistory) ? storedHistory : [])
        .filter((item) => item && typeof item === 'object' && item.product_id != null);
      const existingProduct = productViewHistoryData.find((item) => String(item.product_id) === String(currentViewedProduct.product_id));

      if (existingProduct) {
        Object.assign(existingProduct, currentViewedProduct);
      } else {
        productViewHistoryData.unshift(currentViewedProduct);
      }

      productViewHistoryData.sort((firstProduct, secondProduct) => {
        const firstViewedAt = Date.parse(firstProduct.viewed_at) || 0;
        const secondViewedAt = Date.parse(secondProduct.viewed_at) || 0;
        return secondViewedAt - firstViewedAt;
      });

      localStorage.setItem(storageKey, JSON.stringify(productViewHistoryData.slice(0, 20)));
    } catch (error) {
      // Private browsing and strict storage policies should not block shopping.
    }
  })();

</script>


{% schema %}
{
  "name": {
    "en_US": "Product",
    "zh_TW": "商品", 
    "zh_CN": "商品", 
    "ms_MY": "Produk"
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_product_brand",
      "default": false,
      "label": {
        "en_US": "Show product brand",
        "zh_TW": "展示產品品牌", 
        "zh_CN": "展示产品品牌", 
        "ms_MY": "Tunjukkan jenama produk"
      }
    },
    {
      "type": "checkbox",
      "id": "show_selected_variant_image",
      "default": false,
      "label": {
        "en_US": "Display selected product variant image",
        "zh_TW": "顯示選定商品規格的图像", 
        "zh_CN": "显示选定商品规格的图像", 
        "ms_MY": "Paparkan imej spesifikasi produk yang dipilih"
      }
    },
    {
      "type": "select",
      "id": "variant_options_display",
      "label": {
        "en_US": "Variant options display",
        "zh_TW": "規格顯示方式", 
        "zh_CN": "规格显示方式", 
        "ms_MY": "Paparan pilihan spesifikasi"
      },
      "options": [
        {
          "value": "radio-img",
          "label": {
            "en_US": "Tag with variant image",
            "zh_TW": "標籤與規格照片", 
            "zh_CN": "标签与规格照片", 
            "ms_MY": "Tag dengan imej"
          }
        },
        {
          "value": "radio",
          "label": {
            "en_US": "Tag",
            "zh_TW": "標籤", 
            "zh_CN": "标签", 
            "ms_MY": "Tag"
          }
        }
      ]
    },
    {
      "type": "color",
      "id": "wrapper_bg_color",
      "label": { "en_US": "Text background color", "zh_TW": "文字背景顏色", "zh_CN": "文字背景颜色", "ms_MY": "Warna latar belakang teks" }
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": { "en_US": "Icon with text", "zh_TW": "圖標和文字", "zh_CN": "图标和文字", "ms_MY": "ikon dan teks" },
      "settings": [
        {
          "type": "image",
          "id": "image",
          "label": { "en_US": "Image", "zh_TW": "圖片", "zh_CN": "图片", "ms_MY": "Imej" }
        },
        {
          "type": "text",
          "id": "text",
          "label": { "en_US": "Text", "zh_TW": "文字", "zh_CN": "文字", "ms_MY": "Teks" }
        }
      ]
    }
  ]
}
{% endschema %}
