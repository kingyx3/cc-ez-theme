  "max_blocks": 6,
  "blocks": [
    {
      "type": "banner",
      "name": { "en_US": "Banner", "zh_TW": "橫幅區塊", "zh_CN": "横幅区块", "ms_MY": "Banner" },
      "settings": [
        {
          "type": "color",
          "id": "color_promotion_background",
          "label": {
            "en_US": "Background",
            "ja_JP": "背景",
            "ko_KR": "배경",
            "th_TH": "พื้นหลัง",
            "vi": "Nền",
            "zh_CN": "背景颜色",
            "zh_TW": "背景色"
          },
          "default": "#515432"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": { "en_US": "Color","zh_CN": "文字颜色", "zh_TW": "文字色", "ms_MY": "Warna Teks" },
          "default": "#FFF"
        },
        {
          "type": "text",
          "id": "title",
          "default": { "en_US": "Column", "zh_TW": "格框", "zh_CN": "格框", "ms_MY": "Kolum" },
          "label": { "en_US": "Title", "zh_TW": "標題", "zh_CN": "标题", "ms_MY": "tajuk" }
        },
        {
          "type": "text",
          "id": "text",
          "default": { 
            "en_US": "Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.", 
            "zh_TW": "將文本與圖像配對，以專注於您選擇的產品、收藏或博客文章。添加有關可用性、樣式的詳細信息，甚至提供評論。", 
            "zh_CN": "将文本与图像配对，以专注于您选择的产品、收藏或博客文章。添加有关可用性、样式的详细信息，甚至提供评论。", 
            "ms_MY": "Gandingkan teks dengan imej untuk memfokuskan pada produk, koleksi atau siaran blog pilihan anda. Tambahkan butiran tentang ketersediaan, gaya atau bahkan berikan ulasan." 
          },
          "label": { "en_US": "Text", "zh_TW": "文字", "zh_CN": "文字", "ms_MY": "Teks" }
        },
        {
          "type": "text",
          "id": "button_label",
          "label": { "en_US": "Button Label", "zh_TW": "連結文字", "zh_CN": "连结文字", "ms_MY": "Teks pautan" }
        },
        {
          "type": "text",
          "id": "button_link",
          "label": { "en_US": "Button Link", "zh_TW": "連結", "zh_CN": "连结", "ms_MY": "URL pautan" }
        }
      ]
    },
    {
      "type": "block",
      "name": { "en_US": "Block", "zh_TW": "方形區塊", "zh_CN": "方形區塊", "ms_MY": "Blok" },
      "settings": [
        {
          "type": "color",
          "id": "color_promotion_background",
          "label": {
            "en_US": "Background",
            "ja_JP": "背景",
            "ko_KR": "배경",
            "th_TH": "พื้นหลัง",
            "vi": "Nền",
            "zh_CN": "背景颜色",
            "zh_TW": "背景色"
          },
          "default": "#282828"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": { "en_US": "Color","zh_CN": "文字颜色", "zh_TW": "文字色", "ms_MY": "Warna Teks" },
          "default": "#FFF"
        },
        {
          "type": "text",
          "id": "top_text",
          "default": { "en_US": "Top Text", "zh_TW": "頂端文字", "zh_CN": "顶端文字", "ms_MY": "Teks Atas" },
          "label": { "en_US": "Texts on the top", "zh_TW": "頂端的文字", "zh_CN": "顶端的文字", "ms_MY": "Teks di Atas"}
        },
        {
          "type": "text",
          "id": "center_text",
          "default": { "en_US": "Center Text", "zh_TW": "中間文字", "zh_CN": "顶端文字", "ms_MY": "Teks Tengah" },
          "label": { "en_US": "Texts in the center", "zh_TW": "中間文字", "zh_CN": "中間文字", "ms_MY": "Teks Tengah"}
        },
        {
