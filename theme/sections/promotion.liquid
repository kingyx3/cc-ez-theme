<link rel="preload" href="{{ 'section-promotion.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">

<style>
  {% for block_handle in section.blocks_order %}
    {% assign blocks = section.blocks %}
    {% assign block = blocks[block_handle] %}
    {% assign promotion = block.settings %}
    [id="promotion-section-{{ section.__key }}-{{ forloop.index }}"].promotion-banner{
      background-color: {{promotion.color_promotion_background}};
      color: {{promotion.text_color}};
    }
    [id="promotion-section-{{ section.__key }}-{{ forloop.index }}"].promotion-banner .btn{
      background-color: {{promotion.text_color}};
      border-color: {{promotion.text_color}};
      color: {{promotion.color_promotion_background}};
    }
    [id="promotion-section-{{ section.__key }}-{{ forloop.index }}"].promotion-wrapper .promotion-block{
      background-color: {{promotion.color_promotion_background}};
      color: {{promotion.text_color}};
    }
  {% endfor %}
</style>

<link rel="preload" href="{{ 'component-slider.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<div class="section-collection-list spaced-section page-width page-width-desktop">
  <div class="promotion-section-container">
    {% for block_handle in section.blocks_order %}
    {% assign blocks = section.blocks %}
    {% assign block = blocks[block_handle] %}
      {% if block.type == 'banner' %}
        <div id="promotion-section-{{ section.__key }}-{{ forloop.index }}" class="promotion-banner">
            <div class="promotion-banner-title">{{block.settings.title}}</div>
            <div class="promotion-banner-description"><p style="margin: 7.5px 10px;">{{block.settings.text}}</p></div>
            <a href="{{block.settings.button_link}}" class="btn">{{block.settings.button_label}}</a>
        </div>
      {% else %}
        <a id="promotion-section-{{ section.__key }}-{{ forloop.index }}" href="{{block.settings.link_url}}" class="promotion-wrapper">
            <div class="promotion-block">
                <div class="promotion-block-text">
                <p class="top-text">{{block.settings.top_text}}</p>
                <span class="center-text">{{block.settings.center_text}}</span>
                <p class="bottom-text">{{block.settings.bottom_text}}</p>
                </div>
                <div class="promotion-block-img">
                  {% if block.settings.promotion_image_1 != '' %}
                  <div class="img-wrapper">
                      <img src="{{block.settings.promotion_image_1 | img_url: '550x' }}" alt="{{ shop.name }}"/>
                  </div>
                  {% endif %}
                  {% if block.settings.promotion_image_2 != '' %}
                  <div class="img-wrapper">
                      <img src="{{block.settings.promotion_image_2 | img_url: '550x' }}" alt="{{ shop.name }}"/>
                  </div>
                  {% endif %}
                </div>
            </div>
        </a>
      {% endif %}
    {% endfor %}
      </div>
</div>


{% schema %}
{
