          "id": "link_url",
          "label": { "en_US": "Link URL", "zh_TW": "連結", "zh_CN": "连结", "ms_MY": "URL pautan" }
        }
      ]
    }
  ],
  "presets": [
    {
      "name": { "en_US": "Promotion Section", "zh_TW": "促銷版位", "zh_CN": "促销版位", "ms_MY": "Bahagian Promosi" },
      "blocks": [
        {
