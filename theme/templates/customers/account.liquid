{{ 'customer.css' | asset_url | stylesheet_tag }}
<style>input::-webkit-calendar-picker-indicator{display: none;}</style>
<style>
  @media screen and (min-width: 990px) {
    :is(.account, .order) > div:nth-of-type(2) > div:first-of-type + div{
      min-width: 350px;
      max-width: 380px;
    }
    .order-grid .grid__item:nth-child(3) {
      display: none;
    }
  }
  @media screen and (max-width: 990px) {
    .section-wrapper{
      display: flex;
      flex-wrap: wrap-reverse;
    }
    .section-wrapper > div{
      width: 100%;
    }
  }
  .small-text {
    font-size: 85%;
  }
  .complete-form {
    margin-top: 40px;
  }
  @media screen and (max-width: 749px) {
    .complete-form {
      margin-top: 0;
    }
    
    .order-grid.grid--1-col .grid__item {
      width: 90%;
    }
  }
  .mb-30 {
    margin-bottom: 30px;
  }
  .customer .heading-nav_link{
    display: inline-flex;
    align-items: center;
  }
  .customer .heading-nav_link + .heading-nav_link{
    margin-left: 15px;
  }
  .card-image{
    margin-bottom: 15px;
  }
  .card-image img{
    width: 100%; 
    aspect-ratio: 5/3; 
    object-fit: cover; 
    background-color: white;
    box-shadow: 0 0 5px 1px rgba(18, 18, 18, 0.05);
    border-radius: 10px;
  }

  .member-card-wrapper{
    max-width: 400px;
    margin: auto;
  }
  .member-card{
    position: relative;
    width: 100%;
    padding-bottom: 60%;
    margin-bottom: 15px;
    border-radius: 10px;
    line-height: 1.2;
    box-shadow: 0 0 5px 1px rgba(18, 18, 18, 0.05);
    background-color: white;
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center center;
  }

  .member-card_title{
    font-size: 30px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    max-width: 220px;
    display: inline-block;
    line-height: 1;
  }

  .card-type_simple{
    background-color: #323131;
    color: #fff;
    background-color: {{customer.membership.membership_tier.card_background_color_code}};
    color: {{customer.membership.membership_tier.card_font_color_code}};
  }

  .card-type_simple *{
    color: #fff;
    color: {{customer.membership.membership_tier.card_font_color_code}};
  }
  
  .card-type_customize{
    background-image: url('{{ customer.membership.membership_tier.card_image_url }}');
  }
  
  .card-type_customize .qr-modal-toggle{
    background: #fff;
    color: #000;
    padding: 2px;
    border-radius: 5px;
    box-shadow: 0 0 5px 1px rgba(18, 18, 18, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .member-card_detail{
    position: absolute;
    left: 20px;
    right: 20px;
    display:flex;
    justify-content: space-between;
    align-items: flex-end;
  }
  .member-card_detail:first-child{
    top: 20px;
  }
  .member-card_detail:last-child{
    bottom: 20px;
    column-gap: 5px;
  }
  .membership-upgrade-progress {
    border-radius: 5px; 
    overflow: hidden; 
    height: 8px; 
    width: 100%;
    background-color: rgb(var(--color-foreground), 0.1);
  }
  .membership-progress {
    width: 0;
    height: 10px;
    display: block !important;
    background-color: rgb(var(--color-foreground));
    transition: width 0.5s ease-in-out;
  }
  .credit-point-wrapper .svg-icon{
    margin-right: 0;
  }
  
  .point-info {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tooltip {
    position: relative;
    margin-left: 5px;
  }
  .tooltip .svg-icon {
    height: 16px;
    width: 16px;
    fill: #888;
    color: #888;
  }
  .tooltip .tooltip-content {
    display: none;
    z-index: -2;
    opacity: 0;
    position: absolute;
    bottom: calc(100% + 5px);
    left: 50%;
    transform: translate(-50%, 0);
    margin: 0;
    background-color: rgba(0, 0, 0, 0.8);
    color: #fff;
    padding: 7px 10px;
    line-height: 1.3;
    font-size: 13px;
    border-radius: 3px;
    min-width: 200px;
  }
  .tooltip .tooltip-content::before {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 50%;
    transform: translate(-50%, 0);
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid rgba(0, 0, 0, 0.8);
  }
  .tooltip:hover .tooltip-content,
  .tooltip:active .tooltip-content,
  .tooltip:focus .tooltip-content {
    display: block;
    opacity: 1;
    z-index: 3;
  }
</style>

{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{{ 'qr-modal.css' | global_asset_url | stylesheet_tag }}

<div class="customer account">
  <div class="mb-30">
    <h1>{{ 'customer.account.title' | t }}</h1>
    <div>
      {% for link in contents.after-login.links %}
        {% if link.url == '/account/logout' %}
          <a href="{{link.url}}" class="heading-nav_link">
            <svg data-name="Layer 2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15"><path d="M.57,7.36A.64.64,0,0,0,1.2,8H9L7.21,9.85a.63.63,0,0,0,0,.89h0a.63.63,0,0,0,.9,0L11,7.84A.63.63,0,0,0,11,7h0L8.11,4a.64.64,0,0,0-.91.89h0L9,6.72H1.2A.64.64,0,0,0,.57,7.36Z"/><path d="M12.67.52H2.33A1.83,1.83,0,0,0,.5,2.3V4.7a.64.64,0,1,0,1.27,0V2.3a.55.55,0,0,1,.55-.55H12.67a.56.56,0,0,1,.56.54h0V12.65a.56.56,0,0,1-.56.56H2.33a.56.56,0,0,1-.56-.56V10A.64.64,0,1,0,.5,10v2.64a1.83,1.83,0,0,0,1.83,1.83H12.67a1.83,1.83,0,0,0,1.83-1.83V2.3A1.83,1.83,0,0,0,12.67.52Z"/></svg>
            {{ 'customer.account.navigation.logout' | t }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>


  <div class="section-wrapper">
    <div>
      <h2 class="small-hide">{{ 'customer.account.hi' | t }} {{ customer.name }}.</h2>
      <div class="card-box mb-30">
		<div class="account-navigation__list">
          {% for link in contents.account_navigation.links %}
            {% assign navigation_url = link.url | downcase %}
            {% assign navigation_title = link.title | downcase %}
            {% unless navigation_url contains 'wishlist' or navigation_title contains 'wishlist' or link.handle contains 'wishlist' %}
            <a class="navigation-item heading-nav_link" href="{% if link.handle == 'orders' %}{{ link.url }}?filter=to_pay{% else %}{{ link.url }}{% endif %}">
              <span class="navigation-icon d-flex">
                {% if link.handle == 'details' %}{% include 'svg-definitions' with 'icon-profile' %}
                {% elsif link.handle == 'addresses' %}{% include 'svg-definitions' with 'icon-book' %}
                {% elsif link.handle == 'orders' %}{% include 'svg-definitions' with 'icon-order' %}
                {% elsif link.handle == 'vouchers' %}{% include 'svg-definitions' with 'icon-discount' %}
                {% elsif link.handle == 'recently_view' %}{% include 'svg-definitions' with 'icon-history' %}
                {% else %}{% include 'svg-definitions' with 'icon-love' %}
                {% endif %}
              </span>
              {% assign navigation = 'customer.account.navigation.' | append: link.handle %}
              <div class="navigation-title">{{ navigation | t }}</div>
              <span class="chevron d-flex">{% include 'svg-definitions' with 'icon-chevron-right' %}</span>
            </a>
            {% endunless %}
          {% endfor %}
        </div>
      </div>
      
      
      <h2 class="d-flex flex-wrap flex-space-between flex-align-center">
        {{ "customer.account.recent_orders" | t }}
        {% if customer.orders.size != 0 %}
          <a href="/account/orders?filter=to_pay">{{ "customer.account.view_all" | t }}</a>
        {% endif %}
      </h2>
      {% if customer.orders.size != 0 %}
      <slider-component class="slider-mobile-gutter">
      	<ul class="order-grid grid grid--1-col grid--2-col-tablet slider slider--tablet py-1">
          {% for order in customer.recent_incomplete_order %}
          <li class="grid__item slider__slide mt-0">
            <a class="card-box order-card__wrapper full-unstyled-link" href="{{ order.customer_url }}">
              <div>
                {% if order.name != order.order_number %}
                  <div class="small-text color-light-text">
                    {{ order.order_number | escape }}
                  </div>
                {% endif %}
                <div class="d-flex flex-wrap flex-space-between flex-align-center gap-x-2 gap-y-2">
                <div class="d-flex flex-align-center gap-x-2">
                  <div class="h3">{{ order.name }}</div>
                  <div class="small-text color-light-text">{{ order.created_at | date: "%b %d, %Y" }}</div>
                </div>
                <div class="order-status d-flex gap-x-2">
                  {% if order.is_cancelled == 1%}
                    <span class="small-text label-tag label-tag-alert">{{ "customer.fulfillment_activity.cancelled" | t }}</span>
                  {% else %}
                    {% if order.financial_status_label == "Paid" %}
                      <span class="small-text label-tag label-tag-success">{{ 'customer.financial_status.paid' | t }}</span>
                    {% elsif order.financial_status_label == "Refunded" %}
                      <span class="small-text label-tag label-tag-info">{{ 'customer.financial_status.refunded' | t }}</span>
                    {% elsif order.financial_status_label == "Pending" %}
                      <span class="small-text label-tag label-tag-pending">{{ 'customer.financial_status.pending' | t }}</span>
                    {% elsif order.financial_status_label == "Partially_paid" %}
                      <span class="small-text label-tag label-tag-pending">{{ 'customer.financial_status.partially_paid' | t }}</span>
                    {% elsif order.financial_status_label == "Authorized" %}
                      <span class="small-text label-tag label-default-dark">{{ 'customer.financial_status.authorized' | t }}</span>
                    {% else %}
                      <span class="small-text label-tag label-tag-warning">{{ 'customer.financial_status.unpaid' | t }}</span>
                    {% endif %}

                    {% if order.fulfillment_status_label == "Fulfilled" %}
                      <span class="small-text label-tag label-tag-success">{{ 'customer.fulfillment_status.fulfilled' | t }}</span>
                  	{% elsif order.fulfillment_status_label == "Returned" %}
                      <span class="small-text label-tag label-tag-info">{{ 'customer.fulfillment_status.returned' | t }}</span>
                    {% elsif order.fulfillment_status_label == "Partially fulfilled" %}
                      <span class="small-text label-tag label-tag-pending">{{ 'customer.fulfillment_status.partially_fulfilled' | t }}</span>
                    {% elsif order.fulfillment_status_label == "To process" %}
                      <span class="small-text label-tag label-tag-pending">{{ 'customer.fulfillment_status.to_process' | t }}</span>
                    {% elsif order.fulfillment_status_label == "Processed" %}
                      <span class="small-text label-tag label-tag-pending">{{ 'customer.fulfillment_status.processed' | t }}</span>
                    {% elsif order.fulfillment_status_label == "Packed" %}
                      <span class="small-text label-tag label-tag-pending">{{ 'customer.fulfillment_status.packed' | t }}</span>
                    {% elsif order.fulfillment_status_label == "Shipped" %}
                      <span class="small-text label-tag label-tag-pending">{{ 'customer.fulfillment_status.shipped' | t }}</span>
                    {% elsif order.fulfillment_status_label == "Ready for pickup" %}
                      <span class="small-text label-tag label-tag-success">{{ 'customer.fulfillment_status.ready_for_pickup' | t }}</span>
                    {% elsif order.fulfillment_status_label == "Delivered" %}
                      <span class="small-text label-tag label-tag-success">{{ 'customer.fulfillment_status.delivered' | t }}</span>
                    {% elsif order.fulfillment_status_label == "Customer picked up" %}
                      <span class="small-text label-tag label-tag-success">{{ 'customer.fulfillment_status.customer_picked_up' | t }}</span>
                    {% elsif order.fulfillment_status_label == "Partially shipped" %}
                      <span class="small-text label-tag label-tag-pending">{{ 'customer.fulfillment_status.partially_shipped' | t }}</span>
                    {% elsif order.fulfillment_status_label == "Partially packed" %}
                      <span class="small-text label-tag label-tag-pending">{{ 'customer.fulfillment_status.partially_packed' | t }}</span>
                    {% elsif order.fulfillment_status_label == "Partially processed" %}
                      <span class="small-text label-tag label-tag-pending">{{ 'customer.fulfillment_status.partially_processed' | t }}</span>
                    {% elsif order.fulfillment_status_label == "Partially delivered" %}
                      <span class="small-text label-tag label-tag-pending">{{ 'customer.fulfillment_status.partially_delivered' | t }}</span>
                    {% else %}
                      <span class="small-text label-tag label-tag-warning">{{ 'customer.fulfillment_status.unfulfilled' | t }}</span>
                    {% endif %}
                  {% endif %}
                </div>
              </div>
                {% if order.type == 'pickup' %}<div class="mt-1 small-text color-light-text d-flex flex-align-center" style="display: flex;gap: 3px;">{% include 'svg-definitions' with 'icon-location' %} {{ "checkout.detail.pickup" | t }}</div>{% endif %}

                <div class="d-flex mt-3 mb-3 order-images__wrapper">
                {% for item in order.images limit: 4 %}
                <div class="order-image">
                  <div class="media media--square" style="width: 100%; height: 100%;">
                    {% if item.image == null %}
                      <img src="/assets/images/products/no_image.png" alt="Order item" width="100" height="100" loading="lazy">
                    {% else %}
                      <img src="{{ item.image }}" alt="Order item" width="100" height="100" loading="lazy">
                    {% endif %}
                  </div>
                </div>
                {% endfor %}
              </div>
              </div>

              <div class="h5 text-right">{{ 'customer.orders.total' | t }}: {{ order.total_price | money: order.currency_format }}</div>
            </a>
          </li>
          {% endfor %}
        </ul>
        <div class="slider-buttons no-js-hidden{% if customer.recent_incomplete_order.size < 2 %} hide{% endif %} medium-hide small-hide slider-btn-margin-bottom">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'accessibility.previous_slide' | t }}">{% include 'svg-definitions' with 'icon-caret' %}</button>
          <div class="slider-counter caption hide">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true">
              /
            </span>
            <span class="visually-hidden">{{ 'accessibility.of' | t }}</span>
            <span class="slider-counter--total">{{ customer.recent_incomplete_order.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'accessibility.next_slide' | t }}">{% include 'svg-definitions' with 'icon-caret' %}</button>
        </div>
      </slider-component>
      {% else %}
      <div class="card-box center" style="padding-top: 30px; padding-bottom: 45px;">
        <div style="width: 130px; height: 130px; margin: 25px auto;">
          <svg id="Layer_1" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 182.72 196.97">
            <ellipse cx="91.36" cy="172.57" rx="91.36" ry="24.4" style="fill: #f5f5f5; stroke-width: 0px;"/>
            <path d="m34.35,80.71h118.53v91.16c0,.18-.07.36-.21.49-.13.13-.31.21-.49.21H35.05c-.19,0-.36-.07-.49-.21-.13-.13-.21-.31-.21-.49v-91.16Z" style="fill: #e5e5e5; stroke-width: 0px;"/>
            <path d="m123.15,44.99h-55.11l-33.68,35.72h118.53l-29.73-35.72h-.01Z" style="fill: #dadada; stroke-width: 0px;"/>
            <path d="m45.58,30.7l22.45,14.29-33.68,35.72-25.52-19.39,36.74-30.62h.01Z" style="fill: #ececec; stroke-width: 0px;"/>
            <path d="m145.6,30.7l-22.45,14.29,29.74,35.72,29.46-19.39-36.74-30.62h0Z" style="fill: #ececec; stroke-width: 0px;"/>
            <path d="m82.51,31.43c.63-.3,1.13-.83,1.38-1.49s.24-1.38-.04-2.03l-10.1-23.82c-.14-.34-.35-.64-.62-.9s-.58-.45-.92-.58c-.34-.13-.71-.19-1.07-.18-.37,0-.73.1-1.06.26l-1.95.92c-.33.16-.63.38-.87.65-.24.27-.43.59-.54.94-.12.35-.16.72-.13,1.08.03.37.13.72.3,1.04l12.05,22.9c.33.62.88,1.09,1.55,1.31.66.22,1.39.18,2.02-.12v.02Z" style="fill: #e5e5e5; stroke-width: 0px;"/>
            <path d="m95.18,29.13c.46-.03.89-.24,1.2-.58s.47-.79.46-1.25l-.5-16.96c0-.24-.06-.48-.16-.69-.1-.22-.24-.41-.42-.57s-.39-.28-.62-.36-.47-.11-.71-.09l-1.41.1c-.24.02-.47.08-.69.19-.21.11-.4.26-.56.45-.15.18-.27.4-.34.63s-.09.47-.06.71l1.91,16.86c.05.46.28.88.63,1.17s.81.44,1.27.41v-.02Z" style="fill: #e5e5e5; stroke-width: 0px;"/>
            <path d="m104.95,35.39c1.26.73,3.03.06,4.01-1.52l17.44-28.01c1.04-1.67.79-3.71-.54-4.49l-1.86-1.08c-1.34-.77-3.23.03-4.16,1.77l-15.57,29.09c-.88,1.64-.57,3.51.69,4.24h-.01Z" style="fill: #e5e5e5; stroke-width: 0px;"/>
          </svg>
        </div>
        <p class="color-light-text mb-0">{{ 'customer.orders.none' | t }}</p>
        <a class="btn" href="/collections/all">{{ 'products.product.continue_shopping' | t }}</a>
      </div>
      {% endif %}
    </div>
    
    
    <div>
      {% if customer.is_optional_fields_filled == false %}
        <div class="card card-box background-secondary mb-30 complete-form">
          <div id="customer-attr-wrapper" style="max-width: 600px;margin: 0 auto;">
            <h2 class="mb-0">{{ 'customer.setup.complete_profile' | t }}</h2>
            <p>{{ 'customer.setup.complete_detail' | t }}</p>
            <div id="error-content"></div>
            <form action='/account/details' method='post' id='customer-attr-form' style="margin-top: 0;">
              <input type="hidden" name="_token" value="{% csrf %}">
              <div class="grid grid--2-col-desktop grid--1-col mb-0">
                <div class="grid__item sm-mt-1">
                  <div class="field on_focus">
                    <div class="select">
                      <select name="details[gender]" id="DetailGender" required>
                        <option value disabled {% if customer.gender == blank %}selected{% endif %}>{{ 'customer.register.gender' | t }}</option>
                        <option value="male" {% if customer.gender == 'male' %}selected{% endif %}>{{ 'customer.register.male' | t }}</option>
                        <option value="female" {% if customer.gender == 'female' %}selected{% endif %}>{{ 'customer.register.female' | t }}</option>
                      </select>
                    </div>
                    <label for="DetailGender">{{ 'customer.register.gender' | t }}</label>
                  </div>
                </div>
                <div class="grid__item sm-mt-1">
                  <div class="field">
                    <input type="date" name="details[birthdate]" id="DetailBirthdate" value="{{customer.birthdate}}" placeholder="{{ 'customer.register.birthdate' | t }}" max="{{ "now" | date: "%Y%m%d" }}" {% if customer.birthdate_editable == false %}disabled{% endif %} required>
                    <label for="DetailBirthdate">{{ 'customer.register.birthdate' | t }}</label>
                  </div>
                </div>
                {% for attribute_setting in shop.attribute_settings %}
                  {% if attribute_setting.input_type == "dropdown" %}
                    <div class="grid__item sm-mt-1">
                      <div class="field select on_focus">
                        <select name="details[attributes][{{ attribute_setting.id }}]" id="DetailAttribute{{ attribute_setting.id }}" {% if attribute_setting.is_required %}required{% endif %}>
                          {% assign select_title = attribute_setting.title | downcase  %}
                          <option disabled {% if attribute_setting.value == blank %}selected{% endif %}>{{ 'customer.register.select_custom_attr' | t: select_title }}</option>
                          {% for options in attribute_setting.options %}
                            <option value="{{ options.value }}" {% if attribute_setting.value == options.value %}selected{% endif %}>{{ options.value }}</option>
                          {% endfor %}
                        </select>
                        <label for="DetailAttribute{{ attribute_setting.id }}">{{ attribute_setting.title }}</label>
                      </div>
                    </div>
                  {% elsif attribute_setting.input_type == "date" %}
                    <div class="grid__item sm-mt-1" id="attribute-date-toggle-{{ attribute_setting.id }}">
                      <div class="field">
                        <input type="text" name="details[attributes][{{ attribute_setting.id }}]" id="DetailAttribute{{ attribute_setting.id }}" value="{{ attribute_setting.value }}" placeholder="Select {{ attribute_setting.title | downcase }}" max="{{ " now" | date: "%Y-%m-%d" }}" class="input-datepicker" {% if attribute_setting.is_required %}required{% endif %}>
                        <label for="DetailAttribute{{ attribute_setting.id }}">{{ attribute_setting.title }}</label>
                      </div>
                    </div>
                  {% else %}
                    <div class="grid__item sm-mt-1">
                      <div class="field">
                        <input type="text" id="DetailAttribute{{ attribute_setting.id }}" class="address_form" name="details[attributes][{{ attribute_setting.id }}]" value="{{ attribute_setting.value | escape }}" placeholder="{{ attribute_setting.title | downcase }}" autocapitalize="words" {% if attribute_setting.is_required %}required{% endif %}>
                        <label for="DetailAttribute{{ attribute_setting.id }}">{{ attribute_setting.title }}</label>
                      </div>  
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
              <div class="text-right">
                <button id="submit-btn" type="submit" class="btn button mt-0">
                  {{ 'customer.setup.complete' | t }}
                </button>
              </div>
            </form>
          </div>
        </div>
        
        {{ 'flatpickr.min.css' | asset_url | stylesheet_tag }}
        {{ 'flatpickr.min.js' | asset_url | script_tag }}
        <script>
          let attr_form = document.querySelector('#customer-attr-form'),
              attr_wrapper = document.querySelector('#customer-attr-wrapper'),
              submit_button = document.querySelector('#submit-btn'),
              error_content = document.querySelector('#error-content');
          attr_form.addEventListener('submit', function (e) {
            e.preventDefault();
            error_content.innerHTML = '';
            submit_button.classList.add('btn--loading');
    
            let formData = new FormData(attr_form), 
                data = {};
            formData.forEach((value, key) => {
              const keys = key.split(/\[|\]/).filter(Boolean);
    
              let current = data;
              for (let i = 0; i < keys.length - 1; i++) {
                const subKey = keys[i];
                current[subKey] = current[subKey] || {};
                current = current[subKey];
              }
    
              current[keys[keys.length - 1]] = value;
            });
    
            let jsonData = JSON.stringify(data);
    
            fetch('/account/details', {
              method: 'POST',
              body: jsonData, // Convert object to JSON string
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              }
            })
              .then(response => response.json())
              .then(data => {
                if (data.status === "success") {
                  const successWrapper = document.createElement('div');
                  successWrapper.className = 'text-center';

                  const successIcon = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
                  successIcon.setAttribute('fill', '#13ce66');
                  successIcon.setAttribute('width', '100');
                  successIcon.setAttribute('height', '100');
                  successIcon.setAttribute('viewBox', '0 0 24 24');
                  successIcon.setAttribute('aria-hidden', 'true');
                  successIcon.innerHTML = '<path d="M10.29 18.46a.59.59 0 0 0 .45-.21l8.71-9.63a.66.66 0 0 0 0-.92.65.65 0 0 0-.92 0l-8.27 9.14-4.82-4.32a.65.65 0 0 0-.88 1l5.29 4.81a.66.66 0 0 0 .44.13z"/><path d="M12 23.65A11.65 11.65 0 1 0 .35 12 11.67 11.67 0 0 0 12 23.65zm0-22A10.35 10.35 0 1 1 1.65 12 10.36 10.36 0 0 1 12 1.65z"/>';

                  const successMessage = document.createElement('h3');
                  successMessage.textContent = data.message || '';
                  successWrapper.append(successIcon, successMessage);
                  attr_wrapper.replaceChildren(successWrapper);
                } else {
                  submit_button.classList.remove('btn--loading');
                  if (data.errors) {
                    const errorList = document.createElement('div');
                    errorList.className = 'errors note';
                    data.errors.forEach((message) => {
                      const errorItem = document.createElement('div');
                      errorItem.textContent = message;
                      errorList.appendChild(errorItem);
                    });
                    error_content.replaceChildren(errorList);
                  }
                }
              })
              .catch(error => {
                submit_button.classList.remove('btn--loading');
                if (error && error.message) {
                  const errorItem = document.createElement('div');
                  errorItem.className = 'errors note';
                  errorItem.textContent = error.message;
                  error_content.replaceChildren(errorItem);
                }
              });
          });
    
          
          flatpickr.localize({% include 'flatpickr-locale' %})
          
          let input_birthdate = flatpickr("#DetailBirthdate",{
            maxDate: "today",
            disableMobile: "true",
            allowInput:true,
            onOpen: function(selectedDates, dateStr, instance) {
                document.querySelector("#DetailBirthdate").setAttribute('readonly', true);
            },
            onClose: function(selectedDates, dateStr, instance) {
                document.querySelector("#DetailBirthdate").removeAttribute('readonly');
                document.querySelector("#DetailBirthdate").blur();
            }
          });
          
