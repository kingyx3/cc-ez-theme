{{ 'qr_modal.js' | global_asset_url | script_tag }}

<script>
  var progress = document.getElementById("memberProgress");

  if (progress) {
    setTimeout(function() {
        progress.style.width = {{ customer.membership.upgrade_progress }} + "%";
    }, 300);
  }
  
  function shareReferralLink(action = 'share') {
    const referralInput = document.getElementById('ReferralLinkInput');
    const copyMessage = document.getElementById('copy-message');
    const copyMessageText = document.getElementById('copy-message-text');
    const successIcon = document.getElementById('success-icon');
    const errorIcon = document.getElementById('error-icon');
    const referralUrl = referralInput ? referralInput.value : "{{ customer.customer_referral.referral_url }}";
    const shareTitle = "{{ shop.name }}";

    if (action === 'copy') {
      if (referralInput && copyMessage && copyMessageText) {
        navigator.clipboard.writeText(referralUrl).then(function() {
        copyMessageText.textContent = {{ 'customer.account.referral.copy_success' | t | json }};
          copyMessage.classList.remove('hidden');
          copyMessage.style.color = '#28a745'; 
          
          if (successIcon) successIcon.style.display = 'block';
          if (errorIcon) errorIcon.style.display = 'none';
          
          setTimeout(function() {
            copyMessage.classList.add('hidden');
            if (successIcon) successIcon.style.display = 'none';
          }, 3000);
        }).catch(function(error) {
        copyMessageText.textContent = {{ 'customer.account.referral.copy_error' | t | json }};
          copyMessage.classList.remove('hidden');
          copyMessage.style.color = '#dc3545'; 
          
          if (errorIcon) errorIcon.style.display = 'block';
          if (successIcon) successIcon.style.display = 'none';
          
          setTimeout(function() {
            copyMessage.classList.add('hidden');
            if (errorIcon) errorIcon.style.display = 'none';
          }, 3000);
        });
      }
    } else if (action === 'share' && navigator.share) {
    const shareMessage = {{ 'customer.account.referral.share_message' | t: '__SHOP_NAME__' | json }};
      navigator.share({
        title: shareTitle,
        text: shareMessage.replace('__SHOP_NAME__', shareTitle),
        url: referralUrl
      }).catch(function(error) {
      });
    } else {
      shareReferralLink('copy');
    }
  }
  
  function loadReferralRewards() {
    fetch('/customer/referral_program/campaigns/{{ customer.customer_referral.referral_code }}' , {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(response => response.json())
    .then(data => {
      updateRewardHistory(data);
    })
    .catch(error => {
      console.error('Error loading referral rewards:', error);
    });
  }

  function updateRewardHistory(data) {
    const rewardHistorySection = document.getElementById('reward-history-section');
    
    if (data && data.data.campaign) {
      const campaign = data.data.campaign;
      const totalReferees = campaign.total_referees || 0;
      const creditAmount = campaign.rewards && campaign.rewards.credit ? campaign.rewards.credit.amount || 0 : 0;
      
      // Update step descriptions with actual values
      updateStepDescriptions(campaign);
      
      // Hide reward history if no referees and no rewards
      if (totalReferees === 0 && creditAmount === 0) {
        if (rewardHistorySection) {
          rewardHistorySection.style.display = 'none';
        }
        return;
      }
      
      // Show reward history section if it was hidden
      if (rewardHistorySection) {
        rewardHistorySection.style.display = 'block';
      }
      
      // Update friends referred count
      const friendsCountElement = document.getElementById('friends-referred-count');
      if (friendsCountElement) {
        friendsCountElement.textContent = totalReferees;
      }
      
      // Update credit earned amount by replacing the entire innerHTML
      const creditAmountElement = document.getElementById('credit-earned-amount');
      if (creditAmountElement) {
        // Create a temporary element to get properly formatted money string
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = "{{ 0 | money: shop.money_format }}";
        const zeroFormatted = tempDiv.textContent;
        const formattedAmount = zeroFormatted.replace(0, creditAmount);
        
        creditAmountElement.textContent = formattedAmount;
      }
    } else {
      // Hide section if no data
      if (rewardHistorySection) {
        rewardHistorySection.style.display = 'none';
      }
    }
  }

  function updateStepDescriptions(campaign) {
    const step1Element = document.getElementById('step1-description');
    const step2Element = document.getElementById('step2-description');
    const step3Element = document.getElementById('step3-description');
    
    if (campaign && campaign.referral_rules) {
      // Find referee credit amount (what friends get)
      const refereeRule = campaign.referral_rules.find(rule => 
        rule.target_type === 'referee' && 
        rule.event_name === 'customer/create' && 
        rule.entitlement && 
        rule.entitlement.type === 'credit'
      );
      
      // Find referrer credit amount (what customer gets)
      const referrerRule = campaign.referral_rules.find(rule => 
        rule.target_type === 'referrer' && 
        rule.event_name === 'order/create' && 
        rule.entitlement && 
        rule.entitlement.type === 'credit'
      );
      
      // Find minimum spend requirement
      const minSpendRule = campaign.referral_rules.find(rule => 
        rule.target_type === 'referrer' && 
        rule.event_name === 'order/create' && 
        rule.prerequisite && 
        rule.prerequisite.value
      );
      
      const refereeCreditAmount = refereeRule ? refereeRule.entitlement.amount : 0;
      const referrerCreditAmount = referrerRule ? referrerRule.entitlement.amount : 0;
      const minSpend = minSpendRule ? minSpendRule.prerequisite.value : 0;
      
      // Format amounts with currency
      const formatMoney = (amount) => {
        const tempDiv = document.createElement('div');
        tempDiv.innerHTML = "{{ 0 | money: shop.money_format }}";
        const zeroFormatted = tempDiv.textContent;
        return zeroFormatted.replace('0', amount);
      };

      // Update step 1 description
      if (step1Element) {
      const step1Template = {{ 'customer.account.referral.modal.step1_description' | t: '__REFEREE_CREDIT__' | json }};
        const step1Text = step1Template.replace('__REFEREE_CREDIT__', formatMoney(refereeCreditAmount));
        step1Element.textContent = step1Text;
      } 
      
      // Update step 2 description
      if (step2Element) {
        if (minSpend > 0) {
        const step2Template = {{ 'customer.account.referral.modal.step2_description' | t: '__MIN_SPEND__' | json }};
          const step2Text = step2Template.replace('__MIN_SPEND__', formatMoney(minSpend));
          step2Element.textContent = step2Text;
        } else {
        step2Element.textContent = {{ 'customer.account.referral.modal.step2_description2' | t | json }};
        }
      }
      
      // Update step 3 description
      if (step3Element) {
      const step3Template = {{ 'customer.account.referral.modal.step3_description' | t: '__REFERRER_CREDIT__' | json }};
        const step3Text = step3Template.replace('__REFERRER_CREDIT__', formatMoney(referrerCreditAmount));
        step3Element.textContent = step3Text;
      }
    }
  }
</script>
