{{ 'customer.css' | asset_url | stylesheet_tag }}
<style>input::-webkit-calendar-picker-indicator{display: none;}</style>

{% app_snippet 'register/content_top' %}



<div class="customer register">
  <h1>
    {{ 'customer.register.title' | t }}
  </h1>
  <form id="form-register" method="post" action="/account/register">
    <input type="hidden" name="_token" value="{% csrf %}">
    
    {% if form.errors %}
      {{ form.errors | default_errors }}
    {% endif %}
    <div class="grid grid--2-col mb-0">
      <div class="grid__item pb-0">
        <div class="field">      
          <input
            type="text"
            name="customer[first_name]"
            id="RegisterForm-FirstName"
            {% if form.first_name %}value="{{ form.first_name }}"{% endif %}
            autocomplete="given-name"
            placeholder="{{ 'customer.register.first_name' | t }}"
            required
          >
          <label for="RegisterForm-FirstName">
            {{ 'customer.register.first_name' | t }}
          </label>
        </div>
      </div>
      <div class="grid__item pb-0">
        <div class="field">
          <input
            type="text"
            name="customer[last_name]"
            id="RegisterForm-LastName"
            {% if form.last_name %}value="{{ form.last_name }}"{% endif %}
            autocomplete="family-name"
            placeholder="{{ 'customer.register.last_name' | t }}"
            required
          >
          <label for="RegisterForm-LastName">
            {{ 'customer.register.last_name' | t }}
          </label>
        </div>
      </div>
    </div>

    


    <div class="field">
      <div class="select">
        <select name="customer[gender]" id="RegisterForm-Gender" autocomplete="gender">
          <option value disabled selected>{{ 'customer.register.gender' | t }}</option>
          <option value="male">{{ 'customer.register.male' | t }}</option>
          <option value="female">{{ 'customer.register.female' | t }}</option>
        </select>
      </div>
    </div>
    <div class="field">
      <input type="text" name="customer[birthdate]" id="RegisterForm-Birthdate" autocomplete="birthdate" placeholder="{{ 'customer.register.birthdate' | t }}" max="{{ "now" | date: "%Y%m%d" }}">
      <label for="RegisterForm-Birthdate">{{ 'customer.register.birthdate' | t }}</label>
    </div>


    {% for attribute_setting in shop.attribute_settings %}
      <div class="field {% if attribute_setting.input_type == "dropdown" %}select on_focus{% endif %}">
        {% if attribute_setting.input_type == "dropdown" %}
          <select name="customer[attributes][{{ attribute_setting.id }}]" id="DetailAttribute{{ attribute_setting.id }}" {% if attribute_setting.is_required %}required{% endif %}>
            {% assign select_title = attribute_setting.title | downcase  %}
            <option value disabled selected>{{ 'customer.register.select_custom_attr' | t: select_title }}</option>
            {% for option in attribute_setting.options %}
            <option value="{{ option.value }}">{{ option.value }}</option>
            {% endfor %}
          </select>
          <label for="DetailAttribute{{ attribute_setting.id }}" class="label--hidden">{{ attribute_setting.title }}</label>
        {% elsif attribute_setting.input_type == "date" %}
          <input type="text" name="customer[attributes][{{ attribute_setting.id }}]" id="DetailAttribute{{ attribute_setting.id }}" placeholder="{{ attribute_setting.title }}" max="{{ " now" | date: "%Y-%m-%d" }}" class="input-datepicker" {% if attribute_setting.is_required %}required{% endif %}>
          <label for="DetailAttribute{{ attribute_setting.id }}" class="label--hidden">{{ attribute_setting.title }}</label>
        {% else %}
          <input type="text" name="customer[attributes][{{ attribute_setting.id }}]" id="DetailAttribute{{ attribute_setting.id }}" placeholder="{{ attribute_setting.title }}" autocapitalize="words" {% if attribute_setting.is_required %}required{% endif %}>
          <label for="DetailAttribute{{ attribute_setting.id }}" class="label--hidden">{{ attribute_setting.title }}</label>
        {% endif %}
      </div>
    {% endfor %}

    {% comment %}
      The account field's title comes through translation-fallback, not a bare
      `| t`: an empty store translation renders an empty placeholder and an
      empty label, which is how the email field on /account/details ended up
      showing an address with nothing naming it.

      `autocomplete` follows the same switch. With phone accounts on, this one
      field is the account identifier and a mobile number is the value that gets
      an OTP, so it must not be advertised as an email field: browsers and
      password managers offer a saved address, and a shopper who accepts that
      suggestion signs up with an email the store cannot text. `username` is the
      token for an identifier that may be either.
    {% endcomment %}
    {% assign account_placeholder = 'customer.register.email' %}
    {% assign account_fallback = 'Email' %}
    {% assign account_autocomplete = 'email' %}
    {% if shop.phone_account_enabled == true %}
      {% assign account_placeholder = 'customer.register.email_or_phone' %}
      {% assign account_fallback = 'Email or mobile number' %}
      {% assign account_autocomplete = 'username' %}
    {% endif %}

    <div class="field">
      <input
        type="text"
        name="customer[email_or_phone]"
        id="RegisterForm-EmailOrPhone"
        spellcheck="false"
        autocapitalize="off"
        autocomplete="{{ account_autocomplete }}"
        placeholder="{% include 'translation-fallback', translation_key: account_placeholder, fallback: account_fallback, escape_output: true %}"
        required
        {% if form.errors contains "email_or_phone" %} class="error"{% elsif form.email_or_phone %} value="{{ form.email_or_phone }}"{% endif %}
      >
      {% comment %}
        `for` names the input's real id. It read `RegisterForm-email`, an id no
        element on the page has, so the account field's title pointed at nothing:
        tapping it did not focus the field and assistive tech announced the
        signup form's one identifier input unnamed.
      {% endcomment %}
      <label for="RegisterForm-EmailOrPhone">
        {% include 'translation-fallback', translation_key: account_placeholder, fallback: account_fallback, escape_output: true %}
      </label>
    </div>
    <div class="field">     
      <input
        type="password"
        name="customer[password]"
        id="RegisterForm-password"
        placeholder="{{ 'customer.register.password' | t }}"
        required
      >
      <label for="RegisterForm-password">
        {{ 'customer.register.password' | t }}
      </label>
    </div>

    <input type="text" name="customer[display_name]" id="displayName" class="hide hidden" tabindex="-1" autocomplete="off">
    <input type="password" name="customer[confirm_password]" id="confirmPassword" class="hide hidden" tabindex="-1" autocomplete="off">
    <input type="email" name="customer[confirm_email]" id="confirmEmail" class="hide hidden" tabindex="-1" autocomplete="off">

    <div>
      <button type="submit" class="btn">
        {{ 'customer.register.submit' | t }}
      </button>
    </div>

    <a href="/account/login" class="mb-2">
      {{ 'customer.login.sign_in' | t }}
    </a>
    
    <div>
      {% app_snippet 'register/button' %}
    </div>

    <p>
      <small>
        {{ shop.name | register_tos: contents.terms-policy.links }}
      </small>
    </p>


  </form>
</div>


{{ 'flatpickr.min.css' | asset_url | stylesheet_tag }}
{{ 'flatpickr.min.js' | asset_url | script_tag }}

<script>
  document.querySelector('#form-register').addEventListener('submit', (event)=>{
    document.querySelector('#form-register .btn').classList.add('btn--loading','loading');
  });

  flatpickr.localize({% include 'flatpickr-locale' %})

  let input_birthdate = flatpickr("#RegisterForm-Birthdate",{
    maxDate: "today",
    disableMobile: "true",
    onOpen: (selectedDates, dateStr, instance)=>{
      input_birthdate.setDate('{{ "now" | date: "%Y" | minus: 18 }}{{ "now" | date: "-%m-%d" }}')
    }
  });

  flatpickr(".input-datepicker",{
    disableMobile: "true",
    allowInput:true
  });
</script>

{% app_snippet 'register/content_bottom' %}
