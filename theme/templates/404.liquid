{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-product-grid.css' | asset_url | stylesheet_tag }}
<div style="text-align: center; display: flex; flex-direction: column; align-items: center; margin: 0rem 2rem;">
  <h1>{{ 'general.404.oops' | t }}</h1>
  <p>{{ 'general.404.oops_description' | t }}</p>
  
  <p>{{ 'general.404.search_description' | t }}</p>
  <div class="template-search__search" style="width: 100%; max-width: 500px;">
    <form action="/search" method="get" role="search" class="search" data-search-history-form>
      <div class="field">
        <input
          class="search__input field__input"
          id="Search-In-Template"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="Search-In-404-History"
          data-search-history-input
        >
        <label class="field__label" for="Search-In-Template">{{ 'general.search.placeholder' | t }}</label>
        <div class="search-history" data-search-history-panel hidden>
          <div id="Search-In-404-History" role="listbox" aria-label="Recent searches" data-search-history-list></div>
          <button type="button" class="search-history__clear" data-search-history-clear>Clear history</button>
        </div>
        <input type="hidden" name="search_history" class="hidden_search_history">

        <button type="submit" class="search__button field__button" aria-label="{{ 'general.search.placeholder' | t }}">
          <svg class="icon icon-search"><use xlink:href="#icon-search"></svg>
        </button>
      </div>
    </form>
  </div>
</div>
{% assign product_count = top_products | size %}
{% if product_count > 0 %}
  <section class="product-section page-width spaced-section">
    <product-recommendations>
      <h2 class="product-recommendations__heading" style="text-align: center;">
        {{ 'general.404.top_products_title' | t }}
      </h2>
      <ul class="grid grid--2-col product-grid grid--3-col-desktop grid--one-third-max" role="list">
        {% for i in (1..product_count) %}
          {% assign index = i | minus: 1 %}
          {% assign product = top_products[index] %}
         <li class="grid__item">
            {% include 'product-card' with 'related-products', show_product_info: true %}
          </li>
        {% endfor %}
      </ul>
    </product-recommendations>
  </section>
{% endif %}
