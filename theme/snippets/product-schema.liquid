{% comment %}
  Use `_default`, not `default`, for text fallbacks: on EasyStore `default`
  does not replace an empty string, so an empty meta description stayed empty.

  Product structured data for Google Search and merchant listings.

  This replaces EasyStore's `product | structured_data: shop` output, which:
    - marked pre-orders as InStock,
    - used the store name as the brand on every bundle,
    - left out the barcode, shipping and return details Google asks for.

  Facts below come from the store's own policies (policies/pages):
    - Delivery within Singapore: S$10 below S$500, free from S$500.
    - Handling 0-5 working days; transit 1-3 working days.
    - No change-of-mind returns (faulty items are replaced or refunded).
  Update them here if the shipping or refund policy changes.

  Promotion pages that are set up as products with a S$0 price get no
  Product markup: a free product would be wrong in Shopping results.
{% endcomment %}
{% assign product_schema_variant = product.selected_or_first_available_variant %}
{% assign product_schema_price = product.price | money_without_currency | strip_html | remove: ',' | strip %}
{% assign product_schema_price_value = product_schema_price | plus: 0 %}

{% if product_schema_price_value > 0 %}
  {% assign product_schema_brand = product.brands.first | _default: shop.name %}
  {% if product.tags contains 'MTG' %}
    {% assign product_schema_brand = 'Magic: The Gathering' %}
  {% endif %}

  {% assign product_schema_availability = 'https://schema.org/OutOfStock' %}
  {% if product.available %}
    {% if product.tags contains 'Pre-order' %}
      {% assign product_schema_availability = 'https://schema.org/PreOrder' %}
    {% else %}
      {% assign product_schema_availability = 'https://schema.org/InStock' %}
    {% endif %}
  {% endif %}

  {% assign product_schema_shipping = '10' %}
  {% if product_schema_price_value >= 500 %}
    {% assign product_schema_shipping = '0' %}
  {% endif %}

  {% assign product_schema_description = page_description | _default: product.description | strip_html | strip_newlines | truncate: 4900, '' %}
  {% assign product_schema_barcode = product_schema_variant.barcode | strip %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ canonical_url | append: '#product' | json }},
  "name": {{ product.title | strip_html | json }},
  "url": {{ canonical_url | json }},
  "description": {{ product_schema_description | json }},
  {% comment %}EasyStore leaves forloop.last unset, so the separator goes before every image but the first.{% endcomment %}
  {% assign product_schema_image_separator = '' %}
  "image": [{% for image in product.images limit: 5 %}{{ product_schema_image_separator }}{{ image.src | json }}{% assign product_schema_image_separator = ', ' %}{% endfor %}],
  "brand": {
    "@type": "Brand",
    "name": {{ product_schema_brand | json }}
  },
  {% if product.collections.first.title != blank %}"category": {{ product.collections.first.title | json }},{% endif %}
  "productID": {{ product.id | append: '' | json }},
  {% if product_schema_variant.sku != blank %}"sku": {{ product_schema_variant.sku | json }},{% endif %}
  {% if product_schema_barcode != blank %}"gtin": {{ product_schema_barcode | json }},{% endif %}
  "offers": {
    "@type": "Offer",
    "url": {{ canonical_url | json }},
    "priceCurrency": {{ shop.currency | json }},
    "price": {{ product_schema_price | json }},
    "availability": "{{ product_schema_availability }}",
    "itemCondition": "https://schema.org/NewCondition",
    "seller": {
      "@id": "https://cardboard.sg/#organization"
    },
    "shippingDetails": {
      "@type": "OfferShippingDetails",
      "shippingRate": {
        "@type": "MonetaryAmount",
        "value": "{{ product_schema_shipping }}",
        "currency": "SGD"
      },
      "shippingDestination": {
        "@type": "DefinedRegion",
        "addressCountry": "SG"
      },
      "deliveryTime": {
        "@type": "ShippingDeliveryTime",
        "handlingTime": {
          "@type": "QuantitativeValue",
          "minValue": 0,
          "maxValue": 5,
          "unitCode": "DAY"
        },
        "transitTime": {
          "@type": "QuantitativeValue",
          "minValue": 1,
          "maxValue": 3,
          "unitCode": "DAY"
        }
      }
    },
    "hasMerchantReturnPolicy": {
      "@type": "MerchantReturnPolicy",
      "applicableCountry": "SG",
      "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted",
      "merchantReturnLink": "https://cardboard.sg/pages/refund-policy"
    }
  }
}
</script>
{% endif %}
