{% comment %}
  One per-order purchase limit selector.

  Input:  order_limit_handle   Exact EasyStore product handle/SKU, or a trailing
                               wildcard prefix such as `MTG-HOB-*`. Blank
                               disables the row. A wildcard is only supported at
                               the end; regex-style patterns are deliberately not
                               accepted so matching stays predictable.
          order_limit_maximum  units of each matched SKU allowed in one
                               order/cart. 0 disables the row.

  The row only publishes configuration. Cart quantities are published once by
  customer-order-limit-config.liquid, so adding a large selector matrix does not
  re-walk the cart once per rule.
{% endcomment %}
{% assign per_order_limit_row_selector = order_limit_handle | default: '' | append: '' | strip | downcase %}
{% assign per_order_limit_row_maximum = order_limit_maximum | default: 0 | plus: 0 %}
{% if per_order_limit_row_selector != '' and per_order_limit_row_maximum > 0 %}
  <script>
    window.perOrderLimitsV1.rules[{{ per_order_limit_row_selector | json }}] = {
      maximum: {{ per_order_limit_row_maximum | json }}
    };
  </script>
{% endif %}
{% assign order_limit_handle = '' %}
{% assign order_limit_maximum = 0 %}
