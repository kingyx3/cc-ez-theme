{% assign customer_order_limit_rule_handle = rule_handle | default: '' | append: '' | strip | downcase %}
{% assign customer_order_limit_rule_maximum = rule_maximum | default: 0 | plus: 0 %}
{% assign customer_order_limit_rule_purchased = rule_purchased | default: 0 | plus: 0 %}
{% assign customer_order_limit_rule_cart_quantity = rule_cart_quantity | default: 0 | plus: 0 %}
{% assign customer_order_limit_rule_refresh_at = rule_refresh_at | default: '' | strip %}
{% assign customer_order_limit_rule_window_label = rule_window_label | default: '' | append: '' | strip %}
{% assign customer_order_limit_rule_window_start = rule_window_start | default: 0 | plus: 0 %}
{% if customer_order_limit_rule_handle != '' and customer_order_limit_rule_maximum > 0 %}
  {% comment %}
    A refresh date is store configuration, not something a shopper needs to
    reason about, so no message names it. The resolved window still travels on
    the rule as refreshAt and limitWindowLabel for console verification.

    Limits are per-customer totals across orders, so they can only be measured
    for a signed-in customer. When login is required the storefront sends the
    shopper to sign in instead of enforcing an allowance against a guest.
  {% endcomment %}
  {% assign customer_order_limit_rule_login_required = true %}
  {% if rule_customer_authenticated %}
    {% assign customer_order_limit_rule_login_required = false %}
  {% endif %}

  {% assign customer_order_limit_rule_allowed_cart_quantity = customer_order_limit_rule_maximum | minus: customer_order_limit_rule_purchased %}
  {% if customer_order_limit_rule_allowed_cart_quantity < 0 %}
    {% assign customer_order_limit_rule_allowed_cart_quantity = 0 %}
  {% endif %}

  {% assign customer_order_limit_rule_remaining = customer_order_limit_rule_allowed_cart_quantity | minus: customer_order_limit_rule_cart_quantity %}
  {% if customer_order_limit_rule_remaining < 0 %}
    {% assign customer_order_limit_rule_remaining = 0 %}
  {% endif %}

  {% assign customer_order_limit_rule_cart_exceeded = false %}
  {% if customer_order_limit_rule_cart_quantity > customer_order_limit_rule_allowed_cart_quantity %}
    {% assign customer_order_limit_rule_cart_exceeded = true %}
  {% endif %}

  {% comment %}
    Mirrors messageFor and cartMessageFor in customer-order-limits.js, which
    replace this the moment the script runs. An allowance spent entirely on past
    orders leaves nothing to reduce to, so that case says remove rather than
    telling a shopper to "reduce this item to 0".
  {% endcomment %}
  {% capture customer_order_limit_rule_message %}
    {% if customer_order_limit_rule_login_required %}
      Sign in to buy this item. Limit: {{ customer_order_limit_rule_maximum }} per customer.
    {% elsif customer_order_limit_rule_cart_exceeded %}
      {% if customer_order_limit_rule_allowed_cart_quantity == 0 %}
        Limit reached: {{ customer_order_limit_rule_maximum }} per customer. You have already ordered {{ customer_order_limit_rule_purchased }}, so remove this item to check out.
      {% elsif customer_order_limit_rule_purchased > 0 %}
        Reduce this item to {{ customer_order_limit_rule_allowed_cart_quantity }} to check out ({{ customer_order_limit_rule_maximum }} per customer, {{ customer_order_limit_rule_purchased }} already ordered).
      {% else %}
        Reduce this item to {{ customer_order_limit_rule_allowed_cart_quantity }} to check out.
      {% endif %}
    {% elsif customer_order_limit_rule_remaining == 0 %}
      {% if customer_order_limit_rule_purchased > 0 and customer_order_limit_rule_cart_quantity > 0 %}
        Limit reached: {{ customer_order_limit_rule_maximum }} per customer. You have {{ customer_order_limit_rule_purchased }} ordered and {{ customer_order_limit_rule_cart_quantity }} in your cart.
      {% elsif customer_order_limit_rule_cart_quantity > 0 %}
        Limit reached: {{ customer_order_limit_rule_maximum }} per customer. You have {{ customer_order_limit_rule_cart_quantity }} in your cart.
      {% elsif customer_order_limit_rule_purchased > 0 %}
        Limit reached: {{ customer_order_limit_rule_maximum }} per customer. You have already ordered {{ customer_order_limit_rule_purchased }}.
      {% else %}
        Limit reached: {{ customer_order_limit_rule_maximum }} per customer.
      {% endif %}
    {% elsif customer_order_limit_rule_purchased > 0 %}
      You can add {{ customer_order_limit_rule_remaining }} more ({{ customer_order_limit_rule_maximum }} per customer, {{ customer_order_limit_rule_purchased }} already ordered).
    {% elsif customer_order_limit_rule_cart_quantity > 0 %}
      You can add {{ customer_order_limit_rule_remaining }} more ({{ customer_order_limit_rule_maximum }} per customer).
    {% else %}
      Limit: {{ customer_order_limit_rule_maximum }} per customer.
    {% endif %}
  {% endcapture %}
  <script>
    window.customerOrderLimitsV2.rules[{{ customer_order_limit_rule_handle | json }}] = {
      maximum: {{ customer_order_limit_rule_maximum | json }},
      purchased: {{ customer_order_limit_rule_purchased | json }},
      cartQuantity: {{ customer_order_limit_rule_cart_quantity | json }},
      allowedCartQuantity: {{ customer_order_limit_rule_allowed_cart_quantity | json }},
      remaining: {{ customer_order_limit_rule_remaining | json }},
      loginRequired: {{ customer_order_limit_rule_login_required | json }},
      cartExceeded: {{ customer_order_limit_rule_cart_exceeded | json }},
      refreshAt: {{ customer_order_limit_rule_refresh_at | json }},
      limitWindowLabel: {{ customer_order_limit_rule_window_label | json }},
      windowStart: {{ customer_order_limit_rule_window_start | json }},
      message: {{ customer_order_limit_rule_message | strip | json }}
    };
  </script>
{% endif %}
