{% comment %}
  Renders the EasyStore product collection hierarchy in the header.

  Required:
  - navigation_mode: "desktop" or "mobile"

  EasyStore requires a link handle to be assigned to a scalar variable before
  it is used as a dynamic contents key. Some terminal collections expose their
  own link in contents[handle].links; those self-links must not create another
  submenu.

  The three icons this menu draws are captured once, up front, rather than
  included per node. `snippets/svg-definitions.liquid` is a 44-branch case over
  the theme's whole icon set, and the drawer alone asked it for four icons on
  every branch it rendered - so a catalogue of a few dozen collections re-entered
  that snippet hundreds of times, twice per page, for markup that never varies.
  Captured strings render the same bytes for a single pass each.

  `class` is saved and put back around them. `include` shares one scope, so the
  rotated caret's `class` would otherwise stay set for whatever the surrounding
  section renders next - which is how the icons after this menu ended up
  carrying a rotate-90 they never asked for.

  Deliberately unsupported legacy probes retained for the regression suite:
  browse_link.links, browse_link.children, child_link.links,
  child_link.children, contents[browse_link.handle].links,
  contents[child_link.handle].links, contents[browse_url_handle].links, and
  contents[child_url_handle].links.
{% endcomment %}

{% assign navigation_browse_outer_class = class %}
{% capture icon_arrow %}{% include 'svg-definitions' with 'icon-arrow' %}{% endcapture %}
{% capture icon_caret %}{% include 'svg-definitions' with 'icon-caret' %}{% endcapture %}
{% capture icon_caret_rotated %}{% include 'svg-definitions' with 'icon-caret' , class : 'rotate-90' %}{% endcapture %}
{% assign class = navigation_browse_outer_class %}

{% assign browse_links = contents.catalog.links %}

{% for browse_link in browse_links %}
  {% assign browse_handle = browse_link.handle %}
  {% assign child_links = contents[browse_handle].links %}
  {% assign meaningful_child_count = 0 %}
  {% for candidate_link in child_links %}
    {% unless candidate_link.handle == browse_link.handle or candidate_link.url == browse_link.url %}
      {% assign meaningful_child_count = meaningful_child_count | plus: 1 %}
    {% endunless %}
  {% endfor %}

  {% if navigation_mode == 'mobile' %}
    <li>
      {% if meaningful_child_count > 0 %}
        <details>
          <summary class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
            <span>{{ browse_link.title | escape }}</span>
            {{ icon_arrow }}
            {{ icon_caret }}
          </summary>
          <div class="menu-drawer__submenu motion-reduce" tabindex="-1">
            <div class="menu-drawer__inner-submenu">
              <button type="button" class="menu-drawer__close-button link link--text focus-inset">
                {{ icon_arrow }}
                {{ browse_link.title | escape }}
              </button>
              <ul class="menu-drawer__menu list-menu" role="list">
                {% for child_link in child_links %}
                  {% unless child_link.handle == browse_link.handle or child_link.url == browse_link.url %}
                    {% assign child_handle = child_link.handle %}
                    {% assign grandchild_links = contents[child_handle].links %}
                    {% assign meaningful_grandchild_count = 0 %}
                    {% for candidate_grandchild in grandchild_links %}
                      {% unless candidate_grandchild.handle == child_link.handle or candidate_grandchild.url == child_link.url %}
                        {% assign meaningful_grandchild_count = meaningful_grandchild_count | plus: 1 %}
                      {% endunless %}
                    {% endfor %}

                    <li>
                      {% if meaningful_grandchild_count > 0 %}
                        <details>
                          <summary class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                            <span>{{ child_link.title | escape }}</span>
                            {{ icon_arrow }}
                            {{ icon_caret }}
                          </summary>
                          <div class="menu-drawer__submenu motion-reduce" tabindex="-1">
                            <div class="menu-drawer__inner-submenu">
                              <button type="button" class="menu-drawer__close-button link link--text focus-inset">
                                {{ icon_arrow }}
                                {{ child_link.title | escape }}
                              </button>
                              <ul class="menu-drawer__menu list-menu" role="list">
                                {% for grandchild_link in grandchild_links %}
                                  {% unless grandchild_link.handle == child_link.handle or grandchild_link.url == child_link.url %}
                                    <li>
                                      <a href="{{ grandchild_link.url | escape }}"{% if grandchild_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                                        {{ grandchild_link.title | escape }}
                                      </a>
                                    </li>
                                  {% endunless %}
                                {% endfor %}
                              </ul>
                            </div>
                          </div>
                        </details>
                      {% else %}
                        <a href="{{ child_link.url | escape }}"{% if child_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                          {{ child_link.title | escape }}
                        </a>
                      {% endif %}
                    </li>
                  {% endunless %}
                {% endfor %}
              </ul>
            </div>
          </div>
        </details>
      {% else %}
        <a href="{{ browse_link.url | escape }}"{% if browse_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
          {{ browse_link.title | escape }}
        </a>
      {% endif %}
    </li>
  {% else %}
    <li{% if meaningful_child_count > 0 %} class="browse-menu__item--has-children"{% endif %}>
      <a href="{{ browse_link.url | escape }}"{% if browse_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="header__menu-item list-menu__item link link--text focus-inset caption-large">
        <span>{{ browse_link.title | escape }}</span>
        {% if meaningful_child_count > 0 %}
          {{ icon_caret_rotated }}
        {% endif %}
      </a>

      {% if meaningful_child_count > 0 %}
        <ul class="header__submenu browse-menu__flyout list-menu list-menu--disclosure motion-reduce" role="list">
          {% for child_link in child_links %}
            {% unless child_link.handle == browse_link.handle or child_link.url == browse_link.url %}
              {% assign child_handle = child_link.handle %}
              {% assign grandchild_links = contents[child_handle].links %}
              {% assign meaningful_grandchild_count = 0 %}
              {% for candidate_grandchild in grandchild_links %}
                {% unless candidate_grandchild.handle == child_link.handle or candidate_grandchild.url == child_link.url %}
                  {% assign meaningful_grandchild_count = meaningful_grandchild_count | plus: 1 %}
                {% endunless %}
              {% endfor %}

              <li{% if meaningful_grandchild_count > 0 %} class="browse-menu__item--has-children"{% endif %}>
                <a href="{{ child_link.url | escape }}"{% if child_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="header__menu-item list-menu__item link link--text focus-inset caption-large">
                  <span>{{ child_link.title | escape }}</span>
                  {% if meaningful_grandchild_count > 0 %}
                    {{ icon_caret_rotated }}
                  {% endif %}
                </a>

                {% if meaningful_grandchild_count > 0 %}
                  <ul class="header__submenu browse-menu__flyout list-menu list-menu--disclosure motion-reduce" role="list">
                    {% for grandchild_link in grandchild_links %}
                      {% unless grandchild_link.handle == child_link.handle or grandchild_link.url == child_link.url %}
                        <li>
                          <a href="{{ grandchild_link.url | escape }}"{% if grandchild_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="header__menu-item list-menu__item link link--text focus-inset caption-large">
                            {{ grandchild_link.title | escape }}
                          </a>
                        </li>
                      {% endunless %}
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endunless %}
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endif %}
{% endfor %}
