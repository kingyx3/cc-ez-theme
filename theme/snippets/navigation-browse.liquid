{% comment %}
  Renders the EasyStore product collection hierarchy in the header.

  Required:
  - navigation_mode: "desktop" or "mobile"

  EasyStore exposes each level as a navigation record. A link's handle resolves
  the record containing its children. The header supports three levels, which
  matches the platform's storefront collection hierarchy.
{% endcomment %}

{% assign browse_links = contents.catalog.links %}

{% for browse_link in browse_links %}
  {% assign child_links = browse_link.links %}
  {% if child_links == blank %}
    {% assign child_links = contents[browse_link.handle].links %}
  {% endif %}

  {% if navigation_mode == 'mobile' %}
    <li>
      {% if child_links != blank %}
          <details>
            <summary class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
              <span>{{ browse_link.title | escape }}</span>
              {% include 'svg-definitions' with 'icon-arrow' %}
              {% include 'svg-definitions' with 'icon-caret' %}
            </summary>
            <div class="menu-drawer__submenu motion-reduce" tabindex="-1">
              <div class="menu-drawer__inner-submenu">
                <button type="button" class="menu-drawer__close-button link link--text focus-inset">
                  {% include 'svg-definitions' with 'icon-arrow' %}
                  {{ browse_link.title | escape }}
                </button>
                <ul class="menu-drawer__menu list-menu" role="list">
                  {% for child_link in child_links %}
                    {% assign grandchild_links = child_link.links %}
                    {% if grandchild_links == blank %}
                      {% assign grandchild_links = contents[child_link.handle].links %}
                    {% endif %}

                    <li>
                      {% if grandchild_links != blank %}
                          <details>
                            <summary class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                              <span>{{ child_link.title | escape }}</span>
                              {% include 'svg-definitions' with 'icon-arrow' %}
                              {% include 'svg-definitions' with 'icon-caret' %}
                            </summary>
                            <div class="menu-drawer__submenu motion-reduce" tabindex="-1">
                              <div class="menu-drawer__inner-submenu">
                                <button type="button" class="menu-drawer__close-button link link--text focus-inset">
                                  {% include 'svg-definitions' with 'icon-arrow' %}
                                  {{ child_link.title | escape }}
                                </button>
                                <ul class="menu-drawer__menu list-menu" role="list">
                                  {% for grandchild_link in grandchild_links %}
                                    <li>
                                      <a href="{{ grandchild_link.url }}"{% if grandchild_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                                        {{ grandchild_link.title | escape }}
                                      </a>
                                    </li>
                                  {% endfor %}
                                </ul>
                              </div>
                            </div>
                          </details>
                      {% else %}
                          <a href="{{ child_link.url }}"{% if child_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                            {{ child_link.title | escape }}
                          </a>
                      {% endif %}
                    </li>
                  {% endfor %}
                </ul>
              </div>
            </div>
          </details>
      {% else %}
          <a href="{{ browse_link.url }}"{% if browse_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
            {{ browse_link.title | escape }}
          </a>
      {% endif %}
    </li>
  {% else %}
    <li>
      {% if child_links != blank %}
          <details-disclosure>
            <details>
              <summary class="header__menu-item list-menu__item link link--text focus-inset">
                <span>{{ browse_link.title | escape }}</span>
                {% include 'svg-definitions' with 'icon-caret' , class : 'rotate-90' %}
              </summary>
              <ul class="header__submenu list-menu list-menu--disclosure motion-reduce" role="list">
                {% for child_link in child_links %}
                  {% assign grandchild_links = child_link.links %}
                  {% if grandchild_links == blank %}
                    {% assign grandchild_links = contents[child_link.handle].links %}
                  {% endif %}

                  <li>
                    {% if grandchild_links != blank %}
                        <details-disclosure>
                          <details>
                            <summary class="header__menu-item list-menu__item link link--text focus-inset caption-large">
                              <span>{{ child_link.title | escape }}</span>
                              {% include 'svg-definitions' with 'icon-caret' , class : 'rotate-90' %}
                            </summary>
                            <ul class="header__submenu list-menu list-menu--disclosure motion-reduce" role="list">
                              {% for grandchild_link in grandchild_links %}
                                <li>
                                  <a href="{{ grandchild_link.url }}"{% if grandchild_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="header__menu-item list-menu__item link link--text focus-inset caption-large">
                                    {{ grandchild_link.title | escape }}
                                  </a>
                                </li>
                              {% endfor %}
                            </ul>
                          </details>
                        </details-disclosure>
                    {% else %}
                        <a href="{{ child_link.url }}"{% if child_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="header__menu-item list-menu__item link link--text focus-inset caption-large">
                          {{ child_link.title | escape }}
                        </a>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </details>
          </details-disclosure>
      {% else %}
          <a href="{{ browse_link.url }}"{% if browse_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="header__menu-item list-menu__item link link--text focus-inset caption-large">
            {{ browse_link.title | escape }}
          </a>
      {% endif %}
    </li>
  {% endif %}
{% endfor %}
