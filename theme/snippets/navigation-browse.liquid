{% comment %}
  Renders the reliable, ordered first level from EasyStore's catalog.
  browse-navigation.js enhances these links with descendants from the
  serialized EasyStore collections family tree.

  Required:
  - navigation_mode: "desktop" or "mobile"
{% endcomment %}

{% for catalog_link in contents.catalog.links %}
  {% assign catalog_url_parts = catalog_link.url | split: '/' %}
  {% assign catalog_url_handle = catalog_url_parts | last %}
  <li
    data-browse-root
    data-browse-mode="{{ navigation_mode }}"
    data-browse-link-handle="{{ catalog_link.handle | escape }}"
    data-browse-url-handle="{{ catalog_url_handle | escape }}"
  >
    <a
      href="{{ catalog_link.url | escape }}"
      class="{% if navigation_mode == 'mobile' %}menu-drawer__menu-item list-menu__item link link--text focus-inset{% else %}header__menu-item list-menu__item link link--text focus-inset caption-large{% endif %}"
    >
      {{ catalog_link.title | escape }}
    </a>
  </li>
{% endfor %}
