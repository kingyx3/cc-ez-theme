{% assign organization_logo = settings.logo_img | default: settings.meta_img %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "OnlineStore",
  "@id": "https://cardboard.sg/#organization",
  "name": {{ shop.name | json }},
  "legalName": "Cardboard Collective Pte. Ltd.",
  "url": "https://cardboard.sg/",
  "description": "Singapore-based online retailer specialising in sealed Magic: The Gathering products and preorders.",
  "logo": {{ organization_logo | json }},
  "email": "contact@cardboard.sg",
  "identifier": {
    "@type": "PropertyValue",
    "propertyID": "Singapore UEN",
    "value": "202635416D"
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "email": "contact@cardboard.sg",
    "availableLanguage": ["English"]
  },
  "sameAs": [
    "https://www.facebook.com/cardboardsg",
    "https://www.carousell.sg/u/cardboard_collective/"
  ],
  "hasMerchantReturnPolicy": {
    "@type": "MerchantReturnPolicy",
    "merchantReturnLink": "https://cardboard.sg/legal/refund-policy"
  }
}
</script>
