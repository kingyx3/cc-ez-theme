<style>
  .breadcrumbs {
    padding-top: clamp(0.8rem, 1.5vw, 1.2rem);
  }

  .breadcrumbs__list {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.45rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    color: rgba(var(--color-base-text), 0.58);
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-style: var(--font-body-style);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.01em;
    list-style: none;
  }

  .breadcrumbs__item {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .breadcrumbs__item:not(:last-child) {
    flex: 0 1 auto;
    max-width: 38%;
  }

  .breadcrumbs__item:last-child {
    flex: 1 1 auto;
  }

  .breadcrumbs__item + .breadcrumbs__item::before {
    content: '›';
    flex: 0 0 auto;
    margin-right: 0.45rem;
    color: rgba(var(--color-base-text), 0.34);
  }

  .breadcrumbs__link,
  .breadcrumbs__current {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .breadcrumbs__link {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumbs__link:hover {
    color: rgba(var(--color-base-text), 0.82);
    text-decoration: underline;
    text-decoration-thickness: 0.1rem;
    text-underline-offset: 0.2rem;
  }

  .breadcrumbs__current {
    color: rgba(var(--color-base-text), 0.68);
  }

  @media screen and (max-width: 749px) {
    .breadcrumbs {
      padding-top: 0.75rem;
    }

    .breadcrumbs__list {
      font-size: 1.15rem;
    }
  }
</style>

<nav class="breadcrumbs page-width" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list">
    <li class="breadcrumbs__item">
      <a class="breadcrumbs__link" href="/">Home</a>
    </li>

    {% if collection and template contains 'collection' %}
      <li class="breadcrumbs__item breadcrumbs__current" aria-current="page">
        {{ collection.title | escape }}
      </li>
    {% elsif product and template contains 'product' %}
      {% if collection and collection.title != blank %}
        <li class="breadcrumbs__item">
          <a class="breadcrumbs__link" href="{{ collection.url }}">{{ collection.title | escape }}</a>
        </li>
      {% endif %}
      <li class="breadcrumbs__item breadcrumbs__current" aria-current="page">
        {{ product.title | escape }}
      </li>
    {% endif %}
  </ol>
</nav>
