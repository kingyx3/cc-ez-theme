{% comment %}
  Resolves one configured refresh timestamp into the window that purchases are
  counted from.

  Input:  window_refresh  slot timestamp, blank to fall back to window_default
          window_default  shared timestamp for slots without their own
          window_now      current time in epoch seconds

  Output: customer_order_limit_window         epoch seconds to count orders from,
                                              0 when every past order still counts
          customer_order_limit_window_label   display date for storefront copy
          customer_order_limit_window_refresh resolved timestamp, even when it is
                                              still in the future

  A refresh timestamp that has not arrived yet leaves the window at 0, so the
  allowance only renews once the timestamp passes.

  Comparisons are against '' on values forced to strings, not against `blank`,
  and the epoch must land past 1970. A live store activated a window at epoch 0
  from an unconfigured slot and told shoppers their limit counted "since Jan 01,
  1970", because `blank` comparisons and numeric coercion do not behave the same
  on every Liquid engine.
{% endcomment %}
{% assign customer_order_limit_window = 0 %}
{% assign customer_order_limit_window_label = '' %}
{% assign customer_order_limit_window_refresh = window_refresh | default: '' | append: '' | strip %}
{% if customer_order_limit_window_refresh == '' %}
  {% assign customer_order_limit_window_refresh = window_default | default: '' | append: '' | strip %}
{% endif %}
{% if customer_order_limit_window_refresh != '' %}
  {% assign customer_order_limit_window_epoch = customer_order_limit_window_refresh | date: '%s' | plus: 0 %}
  {% assign customer_order_limit_window_current = window_now | default: 0 | plus: 0 %}
  {% if customer_order_limit_window_epoch > 86400 and customer_order_limit_window_current >= customer_order_limit_window_epoch %}
    {% assign customer_order_limit_window = customer_order_limit_window_epoch %}
    {% assign customer_order_limit_window_label = customer_order_limit_window_refresh | date: '%b %d, %Y' %}
  {% endif %}
{% endif %}
