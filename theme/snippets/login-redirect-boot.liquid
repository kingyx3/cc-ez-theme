{% comment %}
  Completes the sign-in trip before the landing page paints.

  `assets/account-login-redirect.js` remembers where a shopper was buying from
  and sends them back there once they are signed in, but it is deferred: it runs
  at DOMContentLoaded, by which time EasyStore's own landing page - the order
  history - has already painted. The shopper saw their orders flash past on the
  way to the product they were buying.

  This runs in the head instead, before the body is parsed, so the trip finishes
  without that page appearing. Being inline is the point: an external script
  early enough to beat the paint would block parsing on every page of the store
  to serve one, and this stays small enough to run synchronously.

  Profile completion is a stronger condition than the return redirect. A newly
  authenticated customer who still owes the store their details is kept in the
  account flow while the product/prior-page target remains in sessionStorage.
  Once EasyStore has finished its own first-account step, this theme routes any
  remaining required human details to `/account/details` and locks that form
  until those fields submit successfully.

  The gate deliberately uses only the human fields this store actually requires:
  first name, last name, gender, and birthdate. EasyStore's
  `customer.is_optional_fields_filled` is an aggregate platform flag and may stay
  false because of unrelated optional/custom fields even after those four fields
  are saved. Treating it as a hard requirement can therefore trap a customer on
  `/account/details` forever. Click ID still cannot satisfy the gate because none
  of the four explicit checks use customer attributes.

  A first account password is not a profile update. EasyStore's registration
  contract creates it as `customer[password]`; `/account/details` instead carries
  the later Change password pair `details[password1]` and `details[password2]`.
  Reusing `details[password2]` for an OTP-created account can make a field look
  like "Set password" without actually creating a password that login accepts.

  EasyStore may treat a shopper as `customer` immediately after phone OTP while
  still needing to render its native name/password completion page. Because this
  script runs before the body exists, it must not immediately redirect that first
  post-OTP page to `/account/details`. For an incomplete customer on a non-details
  account page it waits for DOMContentLoaded, leaves any native
  `customer[password]` account-creation form alone, and only redirects to details
  when no such first-password step is present. The deferred login module sees
  `window.ccProfileCompletionRequired` meanwhile and cannot consume the saved
  storefront target.

  The Liquid decision is rendered as a meta marker rather than interpolated into
  JavaScript. `e2e/login-redirect.spec.js` executes this first script directly as
  JavaScript, matching the browser after Liquid has rendered it; keeping Liquid
  tags outside the script preserves that useful behavioural harness.

  The stored target and its half-hour window belong to the deferred module; both
  are named here as well, and tests/test_login_redirect_completion.py pins the two
  copies together.
{% endcomment %}

{% assign cc_profile_completion_required = false %}
{% if customer %}
  {% if customer.first_name == blank or customer.last_name == blank or customer.gender == blank or customer.birthdate == blank %}
    {% assign cc_profile_completion_required = true %}
  {% endif %}
{% endif %}

{% if customer %}
  {% if cc_profile_completion_required %}
    <meta name="cc-profile-completion-required" content="true">
  {% endif %}
  <script>
    (function () {
      'use strict';

      var path = String(window.location.pathname || '');
      var profileRequired = Boolean(document.querySelector('meta[name="cc-profile-completion-required"]'));

      if (profileRequired) {
        window.ccProfileCompletionRequired = true;

        var PROFILE_PATH = '/account/details';
        var KEY = 'cc:pending-login-redirect';
        var MAX_AGE_MS = 1800000;
        var AUTH_PATH = /^\/account\/(login|register|recover|auth|activate|reset)/i;

        // Authentication/OTP is an even earlier mandatory step. Do not leave it
        // or interfere with the target the login module is already carrying.
        if (AUTH_PATH.test(path)) return;

        function safeTarget(value) {
          var target = String(value || '').trim();
          if (!target || target.charAt(0) !== '/') return '';
          if (/^\/[\/\\]/.test(target)) return '';
          if (/[\u0000-\u001f\u007f]/.test(target)) return '';
          if (/^\/account(\/|$)/i.test(target)) return '';
          return target;
        }

        function pendingTarget() {
          var raw = null;
          try {
            raw = window.sessionStorage.getItem(KEY);
          } catch (error) {
            return '';
          }
          if (!raw) return '';
          try {
            var pending = JSON.parse(raw);
            var storedAt = Number(pending && pending.storedAt);
            if (!isFinite(storedAt)) return '';
            if (new Date().getTime() - storedAt > MAX_AGE_MS) return '';
            return safeTarget(pending && pending.target);
          } catch (error) {
            return '';
          }
        }

        function referrerTarget() {
          var referrer = String(document.referrer || '');
          if (!referrer) return '';
          var previous = null;
          try {
            previous = new URL(referrer, window.location.href);
          } catch (error) {
            return '';
          }
          if (previous.origin !== window.location.origin) return '';
          return safeTarget(previous.pathname + previous.search);
        }

        function rememberWhereTheyWere() {
          // A Buy Now/login trip has already stored the product page. Never
          // replace it with `/account`, `/account/details`, or a later click.
          if (pendingTarget()) return;

          var target = safeTarget(path + String(window.location.search || '')) || referrerTarget();
          if (!target) return;

          try {
            window.sessionStorage.setItem(KEY, JSON.stringify({
              target: target,
              storedAt: new Date().getTime()
            }));
          } catch (error) {
            /* navigation is still gated even if storage is unavailable */
          }
        }

        rememberWhereTheyWere();

        function nativeFirstPasswordStep() {
          var password = document.querySelector('input[name="customer[password]"]');
          if (!password) return false;

          var form = password.closest && password.closest('form');
          if (!form) return true;

          var action = String(form.getAttribute('action') || '');
          if (/^\/account\/login(?:[?#]|$)/i.test(action)) return false;
          return true;
        }

        var normalizedPath = path.replace(/\/+$/, '') || '/';
        if (normalizedPath !== PROFILE_PATH) {
          // EasyStore's phone signup can expose `customer` before its native
          // name/password completion markup has rendered. Inspect the body once
          // before redirecting so that real account-creation password POST wins
          // over this theme's later human-profile checkpoint.
          function routeAfterNativeAccountSetup() {
            if (nativeFirstPasswordStep()) return;
            window.location.replace(PROFILE_PATH);
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', routeAfterNativeAccountSetup);
          } else {
            routeAfterNativeAccountSetup();
          }
          return;
        }

        function lockProfileForm() {
          var form = document.getElementById('details_form');
          if (!form) return;

          [
            'details[first_name]',
            'details[last_name]',
            'details[gender]',
            'details[birthdate]'
          ].forEach(function (name) {
            var field = form.querySelector('[name="' + name + '"]');
            if (field) field.setAttribute('required', 'required');
          });

          var allowUnload = false;

          // All storefront navigation stays behind the profile checkpoint. The
          // browser's own back/reload/external-leave controls also get its native
          // confirmation prompt; if the shopper confirms a move to another store
          // page, this head gate immediately returns them here before it paints.
          document.addEventListener('click', function (event) {
            var target = event.target;
            if (!target || !target.closest) return;
            var navigation = target.closest('a[href], [data-theme-action="history-back"]');
            if (!navigation) return;
            event.preventDefault();
            event.stopImmediatePropagation();
            if (form.reportValidity) form.reportValidity();
          }, true);

          window.addEventListener('beforeunload', function (event) {
            if (allowUnload) return;
            event.preventDefault();
            event.returnValue = '';
          });

          form.addEventListener('submit', function (event) {
            if (form.checkValidity && !form.checkValidity()) {
              event.preventDefault();
              if (form.reportValidity) form.reportValidity();
              return;
            }
            // The details form performs a normal POST. Only that valid POST may
            // leave this page without a warning. If EasyStore rejects it, the
            // next response is still incomplete and this guard is installed again.
            allowUnload = true;
          }, true);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', lockProfileForm);
        } else {
          lockProfileForm();
        }
        return;
      }

      // The landing page, and never a step: /account/auth carries the one-time
      // code, and a shopper there is a customer to EasyStore but not yet to us.
      if (!/^\/account(\/|$)/i.test(path)) return;
      if (/^\/account\/(login|register|recover|auth|activate|reset)/i.test(path)) return;

      var raw = null;
      try {
        raw = window.sessionStorage.getItem('cc:pending-login-redirect');
      } catch (error) {
        return;
      }
      if (!raw) return;

      var pending = null;
      try {
        pending = JSON.parse(raw);
      } catch (error) {
        return;
      }

      var storedAt = Number(pending && pending.storedAt);
      if (!isFinite(storedAt) || new Date().getTime() - storedAt > 1800000) return;

      // The same target rules the module applies on the way in and on the way
      // out: a same-origin path, never a protocol-relative or backslash host,
      // and never back into the account area.
      var target = String((pending && pending.target) || '');
      if (target.charAt(0) !== '/') return;
      if (/^\/[\/\\]/.test(target)) return;
      if (/^\/account(\/|$)/i.test(target)) return;

      try {
        window.sessionStorage.removeItem('cc:pending-login-redirect');
      } catch (error) {
        /* the module clears it on the page this lands on */
      }
      window.location.replace(target);
    })();
  </script>
{% endif %}
