{% comment %}
  Stores the latest Cloudflare source click in this browser and binds it to the
  logged-in EasyStore customer when one exists.

  The `cc-attribution` Worker mints a random click id for every tracked entry,
  records the marketing facts in D1, and redirects here with `cb_click_id`. The
  URL wins whenever a new tracked touch arrives, so the browser copy represents
  the latest marketing touch.

  The click id is only a transport key between the browser and Cloudflare. It is
  not written into an EasyStore customer attribute and is not copied to HubSpot.
  When EasyStore exposes `customer.id`, this snippet posts only that numeric id
  plus the click UUID to `go.cardboard.sg/touch`. D1 keeps bindings append-only;
  Contact acquisition and Order attribution later select the eligible touch by
  timestamp. No customer name, email, phone or profile data is sent to the Worker.
{% endcomment %}
<script>
  (function () {
    'use strict';

    var COOKIE = 'cb_click_id';
    var STORAGE_KEY = 'cc:cb_click_id';
    var PARAM = 'cb_click_id';
    var TOUCH_ENDPOINT = 'https://go.cardboard.sg/touch';
    var NINETY_DAYS_SECONDS = 7776000;
    var CLICK_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    var customerId = {{ customer.id | default: '' | json }};

    function valid(value) {
      var text = String(value || '').trim();
      return CLICK_ID.test(text) ? text.toLowerCase() : '';
    }

    function fromCookie() {
      var match = String(document.cookie || '').match(
        new RegExp('(?:^|;\\s*)' + COOKIE + '=([^;]*)')
      );
      return match ? valid(decodeURIComponent(match[1])) : '';
    }

    function fromStorage() {
      try {
        return valid(window.localStorage.getItem(STORAGE_KEY));
      } catch (error) {
        return '';
      }
    }

    function remember(clickId) {
      var attributes =
        '; path=/; max-age=' + NINETY_DAYS_SECONDS + '; samesite=lax';
      if (window.location.protocol === 'https:') {
        attributes += '; secure';
      }
      try {
        document.cookie = COOKIE + '=' + encodeURIComponent(clickId) + attributes;
      } catch (error) {
        /* a browser refusing cookies still has the copy below */
      }
      try {
        window.localStorage.setItem(STORAGE_KEY, clickId);
      } catch (error) {
        /* private browsing: the cookie above is the only copy */
      }
    }

    function bindTouch(clickId) {
      if (!customerId || !clickId || !window.fetch) return;

      var key = 'cc:source-touch:' + String(customerId) + ':' + clickId;
      try {
        if (window.localStorage.getItem(key) === '1') return;
      } catch (error) {
        /* D1 is idempotent, so browsers without storage may retry. */
      }

      window.fetch(TOUCH_ENDPOINT, {
        method: 'POST',
        mode: 'cors',
        credentials: 'include',
        keepalive: true,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          customer_id: String(customerId),
          click_id: clickId
        })
      }).then(function (response) {
        if (!response.ok) return;
        try {
          window.localStorage.setItem(key, '1');
        } catch (error) {
          /* the D1 binding already succeeded */
        }
      }).catch(function () {
        /* retry naturally on the next storefront page */
      });
    }

    var fromUrl = '';
    try {
      fromUrl = valid(new URLSearchParams(window.location.search).get(PARAM));
    } catch (error) {
      fromUrl = '';
    }

    var clickId = fromUrl || fromCookie() || fromStorage();
    if (fromUrl) {
      remember(fromUrl);
    }
    bindTouch(clickId);
  })();
</script>
