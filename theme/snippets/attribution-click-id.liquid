{% comment %}
  Stores the Cloudflare click id so a later sign-up or order can be attributed.

  The `cc-attribution` Worker mints a random click id for every tracked entry,
  records the channel in D1, and redirects here with the id both in the URL as
  `cb_click_id` and in a first-party cookie. The URL wins whenever a new tracked
  touch arrives, so the browser copy represents the latest marketing touch.

  `attribution-click-id-field` still treats the customer's EasyStore `Click ID`
  as write-once, preserving account acquisition. Separately, when EasyStore says
  a customer is logged in, this snippet posts the latest click id plus the scalar
  `customer.id` to `go.cardboard.sg/touch`. D1 keeps those bindings append-only;
  the order-attribution job later chooses the latest eligible binding before each
  order timestamp. No customer name, email, phone, IP address or other profile
  data is sent to the Worker.

  This snippet intentionally does not resolve `shop.attribute_settings` or any
  settings object from the layout head. That lookup previously broke storefront
  pages and remains isolated to the customer templates that already render it.
{% endcomment %}
<script>
  (function () {
    'use strict';

    var COOKIE = 'cb_click_id';
    var STORAGE_KEY = 'cc:cb_click_id';
    var PARAM = 'cb_click_id';
    var TOUCH_ENDPOINT = 'https://go.cardboard.sg/touch';
    var NINETY_DAYS_SECONDS = 7776000;
    var CLICK_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    var customerId = {% if customer %}{{ customer.id | json }}{% else %}null{% endif %};

    function valid(value) {
      var text = String(value || '').trim();
      return CLICK_ID.test(text) ? text.toLowerCase() : '';
    }

    function fromCookie() {
      var match = String(document.cookie || '').match(
        new RegExp('(?:^|;\\s*)' + COOKIE + '=([^;]*)')
      );
      return match ? valid(decodeURIComponent(match[1])) : '';
    }

    function fromStorage() {
      try {
        return valid(window.localStorage.getItem(STORAGE_KEY));
      } catch (error) {
        return '';
      }
    }

    function remember(clickId) {
      var attributes =
        '; path=/; max-age=' + NINETY_DAYS_SECONDS + '; samesite=lax';
      if (window.location.protocol === 'https:') {
        attributes += '; secure';
      }
      try {
        document.cookie = COOKIE + '=' + encodeURIComponent(clickId) + attributes;
      } catch (error) {
        /* a browser refusing cookies still has the copy below */
      }
      try {
        window.localStorage.setItem(STORAGE_KEY, clickId);
      } catch (error) {
        /* private browsing: the cookie above is the only copy */
      }
    }

    function bindTouch(clickId) {
      if (!customerId || !clickId || !window.fetch) return;

      var key = 'cc:order-touch:' + String(customerId) + ':' + clickId;
      try {
        if (window.localStorage.getItem(key) === '1') return;
      } catch (error) {
        /* D1 is idempotent, so browsers without storage may retry. */
      }

      window.fetch(TOUCH_ENDPOINT, {
        method: 'POST',
        mode: 'cors',
        credentials: 'include',
        keepalive: true,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          customer_id: String(customerId),
          click_id: clickId
        })
      }).then(function (response) {
        if (!response.ok) return;
        try {
          window.localStorage.setItem(key, '1');
        } catch (error) {
          /* the D1 binding already succeeded */
        }
      }).catch(function () {
        /* retry naturally on the next storefront page */
      });
    }

    var fromUrl = '';
    try {
      fromUrl = valid(new URLSearchParams(window.location.search).get(PARAM));
    } catch (error) {
      fromUrl = '';
    }

    // The URL wins: it is the marketing touch happening now. The EasyStore
    // acquisition field remains write-once, while D1 keeps every bound touch.
    var clickId = fromUrl || fromCookie() || fromStorage();
    if (fromUrl) {
      remember(fromUrl);
    }

    window.ccSourceClickId = clickId || null;
    bindTouch(clickId);
  })();
</script>
