{% comment %}
  Stores the Cloudflare click id so a later sign-up can be attributed.

  The `cc-attribution` Worker mints a random click id for every /go/* entry,
  records the channel it came from in D1, and redirects here with the id both in
  the URL as `cb_click_id` and in a first-party cookie. Without this the id dies
  on the landing page: a shopper's first tap navigates away from the URL that
  carried it, and `scripts/cloudflare_hubspot_attribution.py` has nothing to join.

  This runs on every page of the store, from the head, because the landing page
  is any page. **It therefore touches no Liquid object at all** - no `shop`, no
  `customer`, no `settings`. Reading a shop object here is what broke the
  storefront once already: `shop.attribute_settings` is populated on the customer
  pages that ask for it, and iterating it from the layout head meant every page,
  including the homepage, resolved it. Whatever this snippet needs, it reads from
  the browser.

  `attribution-click-id-field` does the other half - matching the EasyStore
  customer attribute and filling it - and is included only by the four customer
  templates that render attribute settings, which is where that lookup is known
  to work.

  The id is an opaque random value that identifies a click, not a person. It is
  not joined to an IP address, and the Worker stores no personal data alongside
  it. `tests/test_source_attribution_capture.py` pins the names this snippet, the
  field snippet, the Worker and the join script have to agree on.
{% endcomment %}
<script>
  (function () {
    'use strict';

    var COOKIE = 'cb_click_id';
    var STORAGE_KEY = 'cc:cb_click_id';
    var PARAM = 'cb_click_id';
    var NINETY_DAYS_SECONDS = 7776000;
    // The Worker mints a UUID and nothing else is accepted. A value from the
    // query string is shopper-supplied, so anything that is not the shape the
    // Worker produces is discarded rather than stored and shipped to the CRM.
    var CLICK_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

    function valid(value) {
      var text = String(value || '').trim();
      return CLICK_ID.test(text) ? text.toLowerCase() : '';
    }

    function fromCookie() {
      var match = String(document.cookie || '').match(
        new RegExp('(?:^|;\\s*)' + COOKIE + '=([^;]*)')
      );
      return match ? valid(decodeURIComponent(match[1])) : '';
    }

    function fromStorage() {
      try {
        return valid(window.localStorage.getItem(STORAGE_KEY));
      } catch (error) {
        return '';
      }
    }

    function remember(clickId) {
      // The cookie is what the Worker set and what a later page reads first;
      // localStorage is the copy that survives a browser clearing cookies
      // between the landing page and the eventual sign-up.
      var attributes =
        '; path=/; max-age=' + NINETY_DAYS_SECONDS + '; samesite=lax';
      if (window.location.protocol === 'https:') {
        attributes += '; secure';
      }
      try {
        document.cookie = COOKIE + '=' + encodeURIComponent(clickId) + attributes;
      } catch (error) {
        /* a browser refusing cookies still has the copy below */
      }
      try {
        window.localStorage.setItem(STORAGE_KEY, clickId);
      } catch (error) {
        /* private browsing: the cookie above is the only copy */
      }
    }

    var fromUrl = '';
    try {
      fromUrl = valid(new URLSearchParams(window.location.search).get(PARAM));
    } catch (error) {
      fromUrl = '';
    }

    // The URL wins: it is the click that is happening now, and it is what makes
    // a returning shopper's stored id current again.
    var clickId = fromUrl || fromCookie() || fromStorage();
    if (fromUrl) {
      remember(fromUrl);
    }

    // How `attribution-click-id-field` reads the value, so the resolution order
    // above lives in exactly one place.
    window.ccSourceClickId = clickId || null;
  })();
</script>
