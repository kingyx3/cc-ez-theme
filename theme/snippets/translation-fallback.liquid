{%- assign translated_value = translation_key | t -%}
{%- if translated_value == blank or translated_value == translation_key -%}
  {%- assign translated_value = fallback -%}
{%- endif -%}
{%- if escape_output -%}
  {{- translated_value | escape -}}
{%- else -%}
  {{- translated_value -}}
{%- endif -%}
