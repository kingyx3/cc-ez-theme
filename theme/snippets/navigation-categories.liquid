{% assign categories_handle = '' %}
{% for navigation_link in contents.main-menu.links %}
  {% assign navigation_title = navigation_link.title | downcase %}
  {% if navigation_title == 'categories' and contents[navigation_link.handle].links != '' %}
    {% assign categories_handle = navigation_link.handle %}
  {% endif %}
{% endfor %}

{% if categories_handle != '' %}
  {% assign category_links = contents[categories_handle].links %}
{% else %}
  {% assign category_links = contents.main-menu.links %}
{% endif %}

{% for navigation_link in category_links %}
  {% assign navigation_url = navigation_link.url | downcase %}
  {% assign navigation_title = navigation_link.title | downcase %}
  {% unless navigation_url contains 'wishlist' or navigation_title contains 'wishlist' or navigation_title == 'categories' or navigation_url contains '/pages/about-us' or navigation_title == 'about us' %}
    {% assign child_handle = navigation_link.handle %}
    {% assign child_links = contents[child_handle].links %}
    {% if navigation_mode == 'mobile' %}
      {% if child_links != '' %}
        <li>
          <details>
            <summary class="menu-drawer__menu-item list-menu__item link link--text focus-inset" role="button" aria-expanded="false">
              <span>{{ navigation_link.title | escape }}</span>
              {% include 'svg-definitions' with 'icon-arrow' %}
              {% include 'svg-definitions' with 'icon-caret' %}
            </summary>
            <div class="menu-drawer__submenu motion-reduce" tabindex="-1">
              <div class="menu-drawer__inner-submenu">
                <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                  {% include 'svg-definitions' with 'icon-arrow' %}
                  {{ navigation_link.title | escape }}
                </button>
                <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                  {% for child_link in child_links %}
                    {% assign child_url = child_link.url | downcase %}
                    {% assign child_title = child_link.title | downcase %}
                    {% unless child_url contains 'wishlist' or child_title contains 'wishlist' %}
                      <li>
                        <a href="{{ child_link.url }}" {% if child_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="menu-drawer__menu-item link link--text list-menu__item focus-inset">
                          {{ child_link.title | escape }}
                        </a>
                      </li>
                    {% endunless %}
                  {% endfor %}
                </ul>
              </div>
            </div>
          </details>
        </li>
      {% else %}
        <li>
          <a href="{{ navigation_link.url }}" {% if navigation_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
            {{ navigation_link.title | escape }}
          </a>
        </li>
      {% endif %}
    {% else %}
      {% if child_links != '' %}
        <li>
          <details-disclosure>
            <details>
              <summary class="header__menu-item list-menu__item link focus-inset">
                <a href="{{ navigation_link.url }}" {% if navigation_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ navigation_link.title | escape }}</a>
                {% include 'svg-definitions' with 'icon-caret' , class : 'rotate-90' %}
              </summary>
              <ul class="header__submenu list-menu list-menu--disclosure motion-reduce" role="list" tabindex="-1">
                {% for child_link in child_links %}
                  {% assign child_url = child_link.url | downcase %}
                  {% assign child_title = child_link.title | downcase %}
                  {% unless child_url contains 'wishlist' or child_title contains 'wishlist' %}
                    <li>
                      <a href="{{ child_link.url }}" {% if child_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="header__menu-item list-menu__item link link--text focus-inset caption-large">
                        {{ child_link.title | escape }}
                      </a>
                    </li>
                  {% endunless %}
                {% endfor %}
              </ul>
            </details>
          </details-disclosure>
        </li>
      {% else %}
        <li>
          <a href="{{ navigation_link.url }}" {% if navigation_link.new_page %} target="_blank" rel="noopener noreferrer"{% endif %} class="header__menu-item list-menu__item link link--text focus-inset caption-large">
            {{ navigation_link.title | escape }}
          </a>
        </li>
      {% endif %}
    {% endif %}
  {% endunless %}
{% endfor %}
