<div id="google-preferred-source-slot" class="google-preferred-source" hidden>
  <button
    id="google-preferred-source-button"
    type="button"
    class="google-preferred-source__button"
    aria-label="Add Cardboard Collective as a preferred source on Google"
  >
    <img
      class="google-preferred-source__icon"
      src="https://www.gstatic.com/images/branding/product/2x/googleg_48dp.png"
      width="20"
      height="20"
      loading="lazy"
      decoding="async"
      alt=""
      aria-hidden="true"
    >
    <span>Add us as a Preferred Source on Google</span>
  </button>
</div>

<style>
  .google-preferred-source {
    margin-top: 1.5rem;
  }

  .google-preferred-source__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    min-height: 44px;
    padding: 0.75rem 1.1rem;
    border: 1px solid #dadce0;
    border-radius: 999px;
    background: #fff;
    color: #202124;
    font: inherit;
    font-weight: 600;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(60, 64, 67, 0.12);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .google-preferred-source__button:hover {
    border-color: #bdc1c6;
    box-shadow: 0 2px 5px rgba(60, 64, 67, 0.2);
  }

  .google-preferred-source__button:active {
    transform: translateY(1px);
  }

  .google-preferred-source__button:focus-visible {
    outline: 3px solid rgba(26, 115, 232, 0.35);
    outline-offset: 2px;
  }

  .google-preferred-source__icon {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    object-fit: contain;
  }
</style>

<script>
  (function () {
    var slot = document.getElementById('google-preferred-source-slot');
    var button = document.getElementById('google-preferred-source-button');
    var socialLinks = document.querySelector('.footer__list-social');

    if (!slot || !button || !socialLinks) {
      if (slot) slot.remove();
      return;
    }

    socialLinks.insertAdjacentElement('afterend', slot);

    function trackPreferredSourceStart() {
      var eventParameters = {
        source: 'footer',
        domain: 'cardboard.sg'
      };

      if (typeof window.gtag === 'function') {
        window.gtag('event', 'preferred_source_start', eventParameters);
        return;
      }

      if (Array.isArray(window.dataLayer)) {
        window.dataLayer.push({
          event: 'preferred_source_start',
          source: eventParameters.source,
          domain: eventParameters.domain
        });
      }
    }

    (self.PREFERRED_SOURCE = self.PREFERRED_SOURCE || []).push(function (preferredSource) {
      preferredSource.init({
        theme: 'light'
      });

      button.addEventListener('click', function () {
        trackPreferredSourceStart();
        preferredSource.addPreferredSource();
      });

      slot.hidden = false;
    });
  })();
</script>
<script
  async
  preferred-sources-control="manual"
  src="https://news.google.com/swg/js/v1/publisher.js"
></script>
