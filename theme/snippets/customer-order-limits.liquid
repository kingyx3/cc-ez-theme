{% include 'customer-order-limit-config' %}

{% comment %}
  A truthy customer object is the sign-in check the rest of the theme uses for
  its account links, so it is the primary signal here too. The identity fields
  stay as extra positive signals: any one of them proving a signed-in customer
  is enough, and none of them can mark a customer as a guest.
{% endcomment %}
{% assign customer_order_limit_customer_authenticated = false %}
{% if customer %}
  {% assign customer_order_limit_customer_authenticated = true %}
{% endif %}
{% if customer.id != blank or customer.email != blank %}
  {% assign customer_order_limit_customer_authenticated = true %}
{% endif %}

{% assign customer_order_limit_handle_1_normalized = customer_order_limit_handle_1 | default: '' | strip | downcase %}
{% assign customer_order_limit_handle_2_normalized = customer_order_limit_handle_2 | default: '' | strip | downcase %}
{% assign customer_order_limit_handle_3_normalized = customer_order_limit_handle_3 | default: '' | strip | downcase %}
{% assign customer_order_limit_handle_4_normalized = customer_order_limit_handle_4 | default: '' | strip | downcase %}
{% assign customer_order_limit_handle_5_normalized = customer_order_limit_handle_5 | default: '' | strip | downcase %}
{% assign customer_order_limit_handle_6_normalized = customer_order_limit_handle_6 | default: '' | strip | downcase %}
{% assign customer_order_limit_handle_7_normalized = customer_order_limit_handle_7 | default: '' | strip | downcase %}
{% assign customer_order_limit_handle_8_normalized = customer_order_limit_handle_8 | default: '' | strip | downcase %}
{% assign customer_order_limit_handle_9_normalized = customer_order_limit_handle_9 | default: '' | strip | downcase %}
{% assign customer_order_limit_handle_10_normalized = customer_order_limit_handle_10 | default: '' | strip | downcase %}
{% assign customer_order_limit_handle_11_normalized = customer_order_limit_handle_11 | default: '' | strip | downcase %}
{% assign customer_order_limit_handle_12_normalized = customer_order_limit_handle_12 | default: '' | strip | downcase %}
{% assign customer_order_limit_handle_13_normalized = customer_order_limit_handle_13 | default: '' | strip | downcase %}
{% assign customer_order_limit_handle_14_normalized = customer_order_limit_handle_14 | default: '' | strip | downcase %}

{% assign customer_order_limit_purchased_1 = 0 %}
{% assign customer_order_limit_purchased_2 = 0 %}
{% assign customer_order_limit_purchased_3 = 0 %}
{% assign customer_order_limit_purchased_4 = 0 %}
{% assign customer_order_limit_purchased_5 = 0 %}
{% assign customer_order_limit_purchased_6 = 0 %}
{% assign customer_order_limit_purchased_7 = 0 %}
{% assign customer_order_limit_purchased_8 = 0 %}
{% assign customer_order_limit_purchased_9 = 0 %}
{% assign customer_order_limit_purchased_10 = 0 %}
{% assign customer_order_limit_purchased_11 = 0 %}
{% assign customer_order_limit_purchased_12 = 0 %}
{% assign customer_order_limit_purchased_13 = 0 %}
{% assign customer_order_limit_purchased_14 = 0 %}
{% assign customer_order_limit_cart_1 = 0 %}
{% assign customer_order_limit_cart_2 = 0 %}
{% assign customer_order_limit_cart_3 = 0 %}
{% assign customer_order_limit_cart_4 = 0 %}
{% assign customer_order_limit_cart_5 = 0 %}
{% assign customer_order_limit_cart_6 = 0 %}
{% assign customer_order_limit_cart_7 = 0 %}
{% assign customer_order_limit_cart_8 = 0 %}
{% assign customer_order_limit_cart_9 = 0 %}
{% assign customer_order_limit_cart_10 = 0 %}
{% assign customer_order_limit_cart_11 = 0 %}
{% assign customer_order_limit_cart_12 = 0 %}
{% assign customer_order_limit_cart_13 = 0 %}
{% assign customer_order_limit_cart_14 = 0 %}

{% if customer_order_limit_customer_authenticated %}
  {% for order in customer.orders %}
    {% unless order.is_cancelled %}
      {% for line_item in order.line_items %}
        {% assign customer_order_limit_line_handle = line_item.product.handle | default: line_item.handle | default: '' | strip | downcase %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_1_normalized %}
          {% assign customer_order_limit_purchased_1 = customer_order_limit_purchased_1 | plus: line_item.quantity %}
        {% endif %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_2_normalized %}
          {% assign customer_order_limit_purchased_2 = customer_order_limit_purchased_2 | plus: line_item.quantity %}
        {% endif %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_3_normalized %}
          {% assign customer_order_limit_purchased_3 = customer_order_limit_purchased_3 | plus: line_item.quantity %}
        {% endif %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_4_normalized %}
          {% assign customer_order_limit_purchased_4 = customer_order_limit_purchased_4 | plus: line_item.quantity %}
        {% endif %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_5_normalized %}
          {% assign customer_order_limit_purchased_5 = customer_order_limit_purchased_5 | plus: line_item.quantity %}
        {% endif %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_6_normalized %}
          {% assign customer_order_limit_purchased_6 = customer_order_limit_purchased_6 | plus: line_item.quantity %}
        {% endif %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_7_normalized %}
          {% assign customer_order_limit_purchased_7 = customer_order_limit_purchased_7 | plus: line_item.quantity %}
        {% endif %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_8_normalized %}
          {% assign customer_order_limit_purchased_8 = customer_order_limit_purchased_8 | plus: line_item.quantity %}
        {% endif %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_9_normalized %}
          {% assign customer_order_limit_purchased_9 = customer_order_limit_purchased_9 | plus: line_item.quantity %}
        {% endif %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_10_normalized %}
          {% assign customer_order_limit_purchased_10 = customer_order_limit_purchased_10 | plus: line_item.quantity %}
        {% endif %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_11_normalized %}
          {% assign customer_order_limit_purchased_11 = customer_order_limit_purchased_11 | plus: line_item.quantity %}
        {% endif %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_12_normalized %}
          {% assign customer_order_limit_purchased_12 = customer_order_limit_purchased_12 | plus: line_item.quantity %}
        {% endif %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_13_normalized %}
          {% assign customer_order_limit_purchased_13 = customer_order_limit_purchased_13 | plus: line_item.quantity %}
        {% endif %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_14_normalized %}
          {% assign customer_order_limit_purchased_14 = customer_order_limit_purchased_14 | plus: line_item.quantity %}
        {% endif %}
      {% endfor %}
    {% endunless %}
  {% endfor %}
{% endif %}

{% for cart_item in cart.items %}
  {% assign customer_order_limit_cart_handle = cart_item.product.handle | default: cart_item.handle | default: '' | strip | downcase %}
  {% if customer_order_limit_cart_handle == customer_order_limit_handle_1_normalized %}
    {% assign customer_order_limit_cart_1 = customer_order_limit_cart_1 | plus: cart_item.quantity %}
  {% endif %}
  {% if customer_order_limit_cart_handle == customer_order_limit_handle_2_normalized %}
    {% assign customer_order_limit_cart_2 = customer_order_limit_cart_2 | plus: cart_item.quantity %}
  {% endif %}
  {% if customer_order_limit_cart_handle == customer_order_limit_handle_3_normalized %}
    {% assign customer_order_limit_cart_3 = customer_order_limit_cart_3 | plus: cart_item.quantity %}
  {% endif %}
  {% if customer_order_limit_cart_handle == customer_order_limit_handle_4_normalized %}
    {% assign customer_order_limit_cart_4 = customer_order_limit_cart_4 | plus: cart_item.quantity %}
  {% endif %}
  {% if customer_order_limit_cart_handle == customer_order_limit_handle_5_normalized %}
    {% assign customer_order_limit_cart_5 = customer_order_limit_cart_5 | plus: cart_item.quantity %}
  {% endif %}
  {% if customer_order_limit_cart_handle == customer_order_limit_handle_6_normalized %}
    {% assign customer_order_limit_cart_6 = customer_order_limit_cart_6 | plus: cart_item.quantity %}
  {% endif %}
  {% if customer_order_limit_cart_handle == customer_order_limit_handle_7_normalized %}
    {% assign customer_order_limit_cart_7 = customer_order_limit_cart_7 | plus: cart_item.quantity %}
  {% endif %}
  {% if customer_order_limit_cart_handle == customer_order_limit_handle_8_normalized %}
    {% assign customer_order_limit_cart_8 = customer_order_limit_cart_8 | plus: cart_item.quantity %}
  {% endif %}
  {% if customer_order_limit_cart_handle == customer_order_limit_handle_9_normalized %}
    {% assign customer_order_limit_cart_9 = customer_order_limit_cart_9 | plus: cart_item.quantity %}
  {% endif %}
  {% if customer_order_limit_cart_handle == customer_order_limit_handle_10_normalized %}
    {% assign customer_order_limit_cart_10 = customer_order_limit_cart_10 | plus: cart_item.quantity %}
  {% endif %}
  {% if customer_order_limit_cart_handle == customer_order_limit_handle_11_normalized %}
    {% assign customer_order_limit_cart_11 = customer_order_limit_cart_11 | plus: cart_item.quantity %}
  {% endif %}
  {% if customer_order_limit_cart_handle == customer_order_limit_handle_12_normalized %}
    {% assign customer_order_limit_cart_12 = customer_order_limit_cart_12 | plus: cart_item.quantity %}
  {% endif %}
  {% if customer_order_limit_cart_handle == customer_order_limit_handle_13_normalized %}
    {% assign customer_order_limit_cart_13 = customer_order_limit_cart_13 | plus: cart_item.quantity %}
  {% endif %}
  {% if customer_order_limit_cart_handle == customer_order_limit_handle_14_normalized %}
    {% assign customer_order_limit_cart_14 = customer_order_limit_cart_14 | plus: cart_item.quantity %}
  {% endif %}
{% endfor %}

<script>
  window.customerOrderLimitsV2 = {
    customerAuthenticated: {{ customer_order_limit_customer_authenticated | json }},
    rules: {}
  };
</script>
{% include 'customer-order-limit-rule', rule_handle: customer_order_limit_handle_1_normalized, rule_maximum: customer_order_limit_maximum_1, rule_purchased: customer_order_limit_purchased_1, rule_cart_quantity: customer_order_limit_cart_1, rule_customer_authenticated: customer_order_limit_customer_authenticated %}
{% include 'customer-order-limit-rule', rule_handle: customer_order_limit_handle_2_normalized, rule_maximum: customer_order_limit_maximum_2, rule_purchased: customer_order_limit_purchased_2, rule_cart_quantity: customer_order_limit_cart_2, rule_customer_authenticated: customer_order_limit_customer_authenticated %}
