{% include 'customer-order-limit-rule', rule_handle: customer_order_limit_handle_13_normalized, rule_maximum: customer_order_limit_maximum_13, rule_purchased: customer_order_limit_purchased_13, rule_cart_quantity: customer_order_limit_cart_13, rule_customer_authenticated: customer_order_limit_customer_authenticated %}
