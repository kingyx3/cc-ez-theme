{% comment %}
  Customer purchase limits.

  Limits are configured one row per product in customer-order-limit-config.liquid,
  and each row counts and publishes itself through customer-order-limit-row. A
  prefix row limits every product whose handle starts with a given value, and
  publishes an ordinary row for each product it matches.
  This snippet only prepares what every row needs — sign-in state, the current
  time, the page's product identifiers, and the diagnostics that report what the
  order pass could actually read — and then renders the configuration.
{% endcomment %}

{% comment %}
  A truthy customer object is the sign-in check the rest of the theme uses for
  its account links, so it is the primary signal here too. The identity fields
  stay as extra positive signals: any one of them proving a signed-in customer
  is enough, and none of them can mark a customer as a guest.
{% endcomment %}
{% assign customer_order_limit_customer_authenticated = false %}
{% if customer %}
  {% assign customer_order_limit_customer_authenticated = true %}
{% endif %}
{% comment %}
  The identity fields are normalized to strings before comparison. Comparing a
  missing field with `blank` reads as "not blank" on some Liquid engines, which
  would mark every guest as signed in.
{% endcomment %}
{% assign customer_order_limit_customer_id = customer.id | default: '' | append: '' | strip %}
{% assign customer_order_limit_customer_email = customer.email | default: '' | append: '' | strip %}
{% if customer_order_limit_customer_id != '' or customer_order_limit_customer_email != '' %}
  {% assign customer_order_limit_customer_authenticated = true %}
{% endif %}

{% assign customer_order_limit_now_epoch = 'now' | date: '%s' | plus: 0 %}

{% comment %}
  Diagnostics pass. This counts what the storefront can see of the customer's
  order history and samples the identifiers each line item exposes; the counting
  against a configured limit happens per row. Without this, "the limit is not
  enforcing" cannot be told apart from "the storefront cannot see order history"
  without another release.
{% endcomment %}
{% assign customer_order_limit_orders_seen = 0 %}
{% assign customer_order_limit_lines_seen = 0 %}
{% assign customer_order_limit_sample = '' %}
{% assign customer_order_limit_sample_count = 0 %}
{% if customer_order_limit_customer_authenticated %}
  {% assign customer_order_limit_orders = customer.orders | default: customer.recent_orders %}
  {% for order in customer_order_limit_orders %}
    {% comment %}
      `order.is_cancelled` is an integer on EasyStore, not a boolean: this theme's
      own order list compares it with `== 1`. Liquid treats 0 as truthy, so
      an unless on the raw value skipped every order and reported nothing seen
      for every customer. The value is compared as a string.
    {% endcomment %}
    {% assign customer_order_limit_order_cancelled = order.is_cancelled | default: 0 | append: '' | strip | downcase %}
    {% unless customer_order_limit_order_cancelled == '1' or customer_order_limit_order_cancelled == 'true' %}
      {% assign customer_order_limit_orders_seen = customer_order_limit_orders_seen | plus: 1 %}
      {% assign customer_order_limit_lines = order.line_items | default: order.items %}
      {% for line_item in customer_order_limit_lines %}
        {% assign customer_order_limit_lines_seen = customer_order_limit_lines_seen | plus: 1 %}
        {% if customer_order_limit_sample_count < 5 %}
          {% assign customer_order_limit_line_handle = line_item.product.handle | default: line_item.handle | default: '' | append: '' | strip | downcase %}
          {% assign customer_order_limit_line_sku = line_item.sku | default: line_item.variant.sku | default: line_item.product.sku | default: '' | append: '' | strip | downcase %}
          {% assign customer_order_limit_line_quantity = line_item.quantity | default: line_item.qty | default: 0 | plus: 0 %}
          {% if customer_order_limit_line_handle == '' %}
            {% assign customer_order_limit_line_handle = '-no-handle-' %}
          {% endif %}
          {% if customer_order_limit_line_sku == '' %}
            {% assign customer_order_limit_line_sku = '-no-sku-' %}
          {% endif %}
          {% capture customer_order_limit_sample %}{{ customer_order_limit_sample }}{% if customer_order_limit_sample != '' %} {% endif %}{{ customer_order_limit_line_handle }}/{{ customer_order_limit_line_sku }}x{{ customer_order_limit_line_quantity }}{% endcapture %}
          {% assign customer_order_limit_sample_count = customer_order_limit_sample_count | plus: 1 %}
        {% endif %}
      {% endfor %}
    {% endunless %}
  {% endfor %}
{% endif %}

{% comment %}
  Order line items expose `variant_id` on every EasyStore store — this theme's own
  order pages read it — while a handle or SKU is not guaranteed. The current
  product's identifiers are published so purchase history can be matched by id
  when neither string matches, which keeps the limit enforced on products whose
  order lines carry no handle.
{% endcomment %}
{% assign customer_order_limit_page_handle = product.handle | default: '' | append: '' | strip | downcase %}
{% assign customer_order_limit_page_sku = product.sku | default: '' | append: '' | strip | downcase %}
{% assign customer_order_limit_page_product_id = product.id | default: '' | append: '' | strip %}
{% capture customer_order_limit_page_variant_ids %}
  {%- assign customer_order_limit_variant_count = 0 -%}
  {%- for variant in product.variants -%}
    {%- assign customer_order_limit_variant_id = variant.id | default: '' | append: '' | strip -%}
    {%- if customer_order_limit_variant_id != '' -%}
      {%- if customer_order_limit_variant_count > 0 -%},{%- endif -%}
      {{ customer_order_limit_variant_id | json }}
      {%- assign customer_order_limit_variant_count = customer_order_limit_variant_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{% endcapture %}
<script>
  window.customerOrderLimitsV2 = {
    customerAuthenticated: {{ customer_order_limit_customer_authenticated | json }},
    customerId: {{ customer_order_limit_customer_id | json }},
    pageProduct: {
      handle: {{ customer_order_limit_page_handle | json }},
      sku: {{ customer_order_limit_page_sku | json }},
      productId: {{ customer_order_limit_page_product_id | json }},
      variantIds: [{{ customer_order_limit_page_variant_ids | strip }}]
    },
    rules: {},
    /* Prefix limits report themselves here, one entry per configured prefix,
       with the handles the page could match against it. */
    prefixes: {},
    /* Read window.customerOrderLimitsV2.diagnostics in the console to see what
       the order pass could actually read: zero orders means the storefront
       cannot see order history, and identifiers show which value each line item
       exposes for matching. */
    diagnostics: {
      ordersSeen: {{ customer_order_limit_orders_seen | json }},
      lineItemsSeen: {{ customer_order_limit_lines_seen | json }},
      identifiers: {{ customer_order_limit_sample | strip | json }},
      renderedAt: {{ customer_order_limit_now_epoch | json }}
    }
  };
</script>
{% comment %}
  The configuration renders after the container above, because each row publishes
  its rule into window.customerOrderLimitsV2.rules.
{% endcomment %}
{% include 'customer-order-limit-config' %}
<script src="{{ 'customer-order-limits.js' | asset_url }}" defer="defer"></script>
