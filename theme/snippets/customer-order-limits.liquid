{% comment %}
  Purchase history pass. A line item is matched on either its product handle or
  its SKU, because a configured value such as 'MTG-HOB-SCN-EN-SET2' is both the
  storefront handle and the SKU, and order line items do not expose the same
  identifier on every EasyStore store. Matching only one of them counted zero
  units and let a customer reorder the same product forever.

  Blank identifiers are replaced with sentinels so an unconfigured slot can never
  match a line item that simply has no handle or no SKU.
{% endcomment %}
{% assign customer_order_limit_orders_seen = 0 %}
{% assign customer_order_limit_lines_seen = 0 %}
{% assign customer_order_limit_sample = '' %}
{% assign customer_order_limit_sample_count = 0 %}
{% if customer_order_limit_customer_authenticated %}
  {% assign customer_order_limit_orders = customer.orders | default: customer.recent_orders %}
  {% for order in customer_order_limit_orders %}
    {% unless order.is_cancelled %}
      {% assign customer_order_limit_orders_seen = customer_order_limit_orders_seen | plus: 1 %}
      {% comment %}
        Orders placed before a slot's refresh window no longer count. An order
        with no readable date counts as current, so an unexpected date format
        keeps the limit enforced instead of silently clearing it.
      {% endcomment %}
      {% assign customer_order_limit_order_epoch = order.created_at | date: '%s' | plus: 0 %}
      {% if customer_order_limit_order_epoch == 0 %}
        {% assign customer_order_limit_order_epoch = order.processed_at | date: '%s' | plus: 0 %}
      {% endif %}
      {% if customer_order_limit_order_epoch == 0 %}
        {% assign customer_order_limit_order_epoch = customer_order_limit_now_epoch %}
      {% endif %}
      {% assign customer_order_limit_lines = order.line_items | default: order.items %}
      {% for line_item in customer_order_limit_lines %}
        {% assign customer_order_limit_lines_seen = customer_order_limit_lines_seen | plus: 1 %}
        {% assign customer_order_limit_line_handle = line_item.product.handle | default: line_item.handle | default: '' | strip | downcase %}
        {% assign customer_order_limit_line_sku = line_item.sku | default: line_item.variant.sku | default: line_item.product.sku | default: '' | strip | downcase %}
        {% assign customer_order_limit_line_quantity = line_item.quantity | default: line_item.qty | default: 0 | plus: 0 %}
        {% if customer_order_limit_line_handle == blank %}
          {% assign customer_order_limit_line_handle = '-no-handle-' %}
        {% endif %}
        {% if customer_order_limit_line_sku == blank %}
          {% assign customer_order_limit_line_sku = '-no-sku-' %}
        {% endif %}
        {% if customer_order_limit_sample_count < 5 %}
          {% capture customer_order_limit_sample %}{{ customer_order_limit_sample }}{% if customer_order_limit_sample != blank %} {% endif %}{{ customer_order_limit_line_handle }}/{{ customer_order_limit_line_sku }}x{{ customer_order_limit_line_quantity }}{% endcapture %}
          {% assign customer_order_limit_sample_count = customer_order_limit_sample_count | plus: 1 %}
        {% endif %}
        {% assign customer_order_limit_line_match = false %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_1_normalized or customer_order_limit_line_sku == customer_order_limit_handle_1_normalized %}
          {% assign customer_order_limit_line_match = true %}
        {% endif %}
        {% if customer_order_limit_line_match and customer_order_limit_order_epoch >= customer_order_limit_window_1 %}
          {% assign customer_order_limit_purchased_1 = customer_order_limit_purchased_1 | plus: customer_order_limit_line_quantity %}
        {% endif %}
        {% assign customer_order_limit_line_match = false %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_2_normalized or customer_order_limit_line_sku == customer_order_limit_handle_2_normalized %}
          {% assign customer_order_limit_line_match = true %}
        {% endif %}
        {% if customer_order_limit_line_match and customer_order_limit_order_epoch >= customer_order_limit_window_2 %}
          {% assign customer_order_limit_purchased_2 = customer_order_limit_purchased_2 | plus: customer_order_limit_line_quantity %}
        {% endif %}
        {% assign customer_order_limit_line_match = false %}
        {% if customer_order_limit_line_handle == customer_order_limit_handle_3_normalized or customer_order_limit_line_sku == customer_order_limit_handle_3_normalized %}
          {% assign customer_order_limit_line_match = true %}
        {% endif %}
        {% if customer_order_limit_line_match and customer_order_limit_order_epoch >= customer_order_limit_window_3 %}
