{% include 'customer-order-limit-rule', rule_handle: customer_order_limit_handle_7_normalized, rule_maximum: customer_order_limit_maximum_7, rule_purchased: customer_order_limit_purchased_7, rule_cart_quantity: customer_order_limit_cart_7, rule_customer_authenticated: customer_order_limit_customer_authenticated %}
{% include 'customer-order-limit-rule', rule_handle: customer_order_limit_handle_8_normalized, rule_maximum: customer_order_limit_maximum_8, rule_purchased: customer_order_limit_purchased_8, rule_cart_quantity: customer_order_limit_cart_8, rule_customer_authenticated: customer_order_limit_customer_authenticated %}
{% include 'customer-order-limit-rule', rule_handle: customer_order_limit_handle_9_normalized, rule_maximum: customer_order_limit_maximum_9, rule_purchased: customer_order_limit_purchased_9, rule_cart_quantity: customer_order_limit_cart_9, rule_customer_authenticated: customer_order_limit_customer_authenticated %}
{% include 'customer-order-limit-rule', rule_handle: customer_order_limit_handle_10_normalized, rule_maximum: customer_order_limit_maximum_10, rule_purchased: customer_order_limit_purchased_10, rule_cart_quantity: customer_order_limit_cart_10, rule_customer_authenticated: customer_order_limit_customer_authenticated %}
{% include 'customer-order-limit-rule', rule_handle: customer_order_limit_handle_11_normalized, rule_maximum: customer_order_limit_maximum_11, rule_purchased: customer_order_limit_purchased_11, rule_cart_quantity: customer_order_limit_cart_11, rule_customer_authenticated: customer_order_limit_customer_authenticated %}
