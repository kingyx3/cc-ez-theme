{{ 'compact-spacing.css' | asset_url | stylesheet_tag }}
{{ 'card-navigation-polish.css' | asset_url | stylesheet_tag }}

{% comment %}
  Temporary unpublished-preview OTP event probe. It is inert unless the current
  browser session is explicitly enabled with ?cc_otp_probe=1. The probe is
  read-only with respect to EasyStore's OTP widget and never records OTP digits.
{% endcomment %}
<script src="{{ 'account-otp-diagnostic.js' | asset_url }}" defer="defer"></script>

{% comment %}
  Purchase-limit modules are only useful where a shopper can actually purchase.
  Product and cart pages always need them. Listing pages need them only when the
  global listing add-to-cart control is enabled. EasyStore may expose an unchecked
  setting as false, 0, or "0", and Liquid treats 0 as truthy, so normalize it the
  same way product-card.liquid does before deciding to ship purchase JavaScript.
{% endcomment %}
{% assign listing_purchase_controls_enabled = true %}
{% if settings.show_add_to_cart_button == false or settings.show_add_to_cart_button == 0 or settings.show_add_to_cart_button == '0' %}
  {% assign listing_purchase_controls_enabled = false %}
{% endif %}
{% assign purchase_controls_needed = false %}
{% if template contains 'product' or template contains 'cart' %}
  {% assign purchase_controls_needed = true %}
{% elsif listing_purchase_controls_enabled %}
  {% assign purchase_controls_needed = true %}
{% endif %}

{% if purchase_controls_needed %}
  <script src="{{ 'buy-now-limit-checkout.js' | asset_url }}" defer="defer"></script>
  {% comment %}
    Storefront pages do not need to render a customer's full order history before
    the document can be returned. `customer-order-limits.js` already treats a page
    with no inline line items as "history unknown", loads the authoritative account
    history in the background for each page, and holds purchase
    attempts until that history is known. Opt into that path here so navigation is
    not blocked by one full order-history pass per configured limit.

    Keep the original include shape because other purchase helpers use its position
    as a delivery invariant. `include` shares this scope on EasyStore, so the flag
    is set immediately before it and cleared immediately afterwards.
  {% endcomment %}
  {% assign defer_history = true %}
  {% include 'customer-order-limits' %}
  {% assign defer_history = false %}

  <script>
    window.purchaseCartQuantities = {};
    {% for item in cart.items %}
      window.purchaseCartQuantities[String({{ item.variant_id | json }})] =
        (window.purchaseCartQuantities[String({{ item.variant_id | json }})] || 0)
        + {{ item.quantity | default: 0 }};
    {% endfor %}
  </script>
  {% comment %}
    Deferred: it ran as a blocking request at the end of every page, holding up the
    end of parsing for 20KB that nothing on screen waits for. It patches
    `EasyStore.Action.addToCart` on a retry loop and enhances `product-form` through
    `customElements.whenDefined`, so neither hook depends on running during parse.
  {% endcomment %}
  <script src="{{ 'purchase-limit-feedback.js' | asset_url }}" defer="defer"></script>
{% endif %}

<script>
  EasyStore.Currencies.init({{ shop.enabled_currencies |json }}, {{ settings.is_server_side_currency_conversion }})
</script>

{% if settings.show_multiple_currencies %}

  <script>
    let page_template = '{{ template }}';

    if(document.querySelector('.currency-picker')) {
      EasyStore.Currencies.change(document.querySelector('.currency-picker').value)
      EasyStore.Currencies.convertAll() 
    }

    document.querySelectorAll('.currency-picker').forEach((el)=>{
      el.addEventListener('change',(event)=>{
        EasyStore.Currencies.change(event.target.value)

        {% if settings.is_server_side_currency_conversion == true %}
          if (page_template == 'cart') {
            const params = new URLSearchParams(window.location.search);
            params.set('delete_cache', 1);
            window.location.search = params;
          } else {
            window.location.reload();
          }

          return
        {% endif %}

        document.querySelectorAll('[name=currencies],[name=current_currency]').forEach((el)=>{
          el.value = event.target.value
        })

        if(page_template == 'cart') location.reload();
      })
    })
  </script>

{% endif %}
