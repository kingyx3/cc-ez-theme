{% comment %}
  Legacy rollout guard for the retired EasyStore "Click ID" customer attribute.

  Attribution no longer reads or writes this field. Source clicks are bound
  directly to EasyStore `customer.id` in Cloudflare D1, and HubSpot never receives
  a click UUID. This snippet only prevents an old machine-only attribute from
  appearing in customer forms while it is being removed from EasyStore admin.

  Once the legacy attribute has been deleted from EasyStore, this include becomes
  a no-op and can be removed in a later theme cleanup.
{% endcomment %}

{% assign attribution_click_id_setting = '' %}
{% for attribute_setting in shop.attribute_settings %}
  {% assign attribution_candidate_title = attribute_setting.title | default: '' | append: '' | downcase | strip %}
  {% if attribution_candidate_title == 'click id' or attribution_candidate_title == 'clickid' or attribution_candidate_title == 'cb_click_id' or attribution_candidate_title == 'source click id' or attribution_candidate_title == 'attribution click id' %}
    {% assign attribution_click_id_setting = attribute_setting.id %}
  {% endif %}
{% endfor %}

{% if attribution_click_id_setting != '' %}
  <style>
    .field:has(#DetailAttribute{{ attribution_click_id_setting }}),
    .grid__item:has(#DetailAttribute{{ attribution_click_id_setting }}) {
      display: none !important;
    }
  </style>
  <script>
    (function () {
      'use strict';
      function retireLegacyField() {
        var field = document.getElementById('DetailAttribute{{ attribution_click_id_setting }}');
        if (!field) return;
        field.removeAttribute('required');
        field.setAttribute('disabled', 'disabled');
        field.removeAttribute('name');
        var wrapper = field.closest('.field, .grid__item');
        if (wrapper) wrapper.setAttribute('hidden', 'hidden');
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', retireLegacyField);
      } else {
        retireLegacyField();
      }
    })();
  </script>
{% endif %}
