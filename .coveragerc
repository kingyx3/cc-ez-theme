[run]
branch = True
# The theme suite (tests/theme) measures only the theme tooling it gates:
# validation/packaging (theme_ci.py) and publishing (easystore_publish.py).
#
# The EasyStore -> HubSpot CRM sync scripts (scripts/crm) and the admin token
# rotation (scripts/auth) are not part of the theme package and are not
# exercised by tests/theme. They have their own gates: the CRM validation
# workflow, the focused order-attribution workflow and the token renewal
# workflow compile/test them on every relevant change. Measuring them here
# would only lower the theme suite's 100% requirement.
#
# tests/theme/test_source_attribution_capture.py reads the contact join script
# as text rather than importing it, precisely so the theme suite keeps its gate
# while still pinning the names the theme and the join have to agree on.
source = scripts/theme

[report]
fail_under = 100
show_missing = True
