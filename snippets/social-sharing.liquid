{% if template contains 'article' or template contains 'blog' %}
  {% assign permalinkURL = shop.url | append: article.url %}
  {% assign shareTitle = article.title | url_param_escape %}
{% elsif template contains 'product' %}
  {% assign permalinkURL = product.share_url %}
  {% assign shareTitle = product.title | url_param_escape %}
{% elsif template == 'password' %}
  {% assign permalinkURL = shop.url %}
  {% capture shareTitle %}{% unless shop.description == '' %}{{ shop.description | url_param_escape }}{% else %}{{ shop.name | url_param_escape }}{% endunless %}{% endcapture %}
{% elsif template == 'voucher' %}
  {% assign permalinkURL = voucher.details.link %}
  {% assign shareTitle = voucher.title | url_param_escape %}
{% endif %}

<share-button class="share-button">
  <button class="share-button__button hidden">
    {% if social-sharing == 'float-icon' %}
      <span class="button-circle">
        {% include 'svg-definitions' with 'icon-share' %}
      </span>
    {% else %}
      {% include 'svg-definitions' with 'icon-share' %}
      {{ 'general.share' | t }}
    {% endif %}
  </button>
  <details>
    <summary class="share-button__button">
      {% if social-sharing == 'float-icon' %}
        <span class="button-circle">
          {% include 'svg-definitions' with 'icon-share' %}
        </span>
      {% else %}
        {% include 'svg-definitions' with 'icon-share' %}
        {{ 'general.share' | t }}
      {% endif %}
    </summary>
    <div id="Product-share-id" class="share-button__fallback motion-reduce {% if social-sharing == 'float-icon' %} float-bottom-modal {% endif %}">

      <div class="social-sharing-icons" data-permalink="{{ permalinkURL }}">
        <div class="sharing-icons-label"><small>{{ 'general.social.share' | t }}</small></div>

        <a target="_blank" href="//www.facebook.com/sharer.php?u={{ permalinkURL }}" class="share-icon-button">
          {% include 'svg-definitions' with 'icon-facebook' %}
        </a>

        <a target="_blank" href="//twitter.com/share?text={{ shareTitle }}&amp;url={{ permalinkURL }}" class="share-icon-button">
          {% include 'svg-definitions' with 'icon-twitter' %}
        </a>

        {% if product.featured_image or article.image %}

          <a target="_blank" href="//pinterest.com/pin/create/button/?url={{ permalinkURL }}&amp;media={% if template contains 'product' %}{{ product | img_url: 'social-share' }}{% else %}{{ article | img_url: 'social-share' }}{% endif %}&amp;description={{ shareTitle }}" class="share-icon-button">
            {% include 'svg-definitions' with 'icon-pinterest' %}
          </a>

        {% endif %}
        
        <a target="_blank" href="//social-plugins.line.me/lineit/share?url={{ permalinkURL }}" class="share-icon-button">
          {% include 'svg-definitions' with 'icon-line' %}
        </a>

        {% app_snippet 'product/share' %}
      </div>

      <div class="share-button_copy-wrapper">
        <div class="field">
          <span id="ShareMessage-id" class="share-button__message hidden" role="status">
          </span>
          <input type="text"
                class="field__input"
                id="url"
                value="{{ permalinkURL }}"
                placeholder="{{ 'general.social.share_url' | t }}"
                onclick="this.select();"
                readonly
          >
          <label class="field__label" for="url">{{ 'general.social.share_url' | t }}</label>
        </div>
        <button class="share-button__close hidden no-js-hidden">
          {% include 'svg-definitions' with 'icon-close' %}
          <span class="visually-hidden">{{ 'general.share.close' | t }}</span>
        </button>
        <button class="share-button__copy no-js-hidden">
          {% include 'svg-definitions' with 'icon-clipboard' %}
          <span class="visually-hidden">{{ 'general.share.copy_to_clipboard' | t }}</span>
        </button>
      </div>
      
    </div>
    <div class="modal-overlay float-bottom-modal-overlay large-up-hide"></div>
  </details>
</share-button>
<script src="{{ 'share.js' | asset_url }}" defer="defer"></script>


