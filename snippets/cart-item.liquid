<tr class="cart-item" id="CartItem-{{item.id}}{{forloop.index}}">
  <td class="cart-item__media">
     <a href="{{ item.url }}">
       <img class="cart-item__image" src="{{ item.image_url }}" alt="{{ item.title | escape }}" loading="lazy" width="100" height="100">
     </a>
  </td>
  <td class="cart-item__details">
     <a href="{{ item.url }}" class="cart-item__name break">{{ item.name | escape }}</a>
     <dl>
       {% unless item.variant_name contains 'Default' %}
         <div class="product-option">
           {{ item.variant_name }}
         </div>
       {% endunless %}

       {% assign propertySize = item.properties | size %}
       {% if propertySize > 0 %}
         {% for p in item.properties %}
           {% if p.last != blank %}
             <div class="product-option">
               <dt>{{ p.first }}: </dt>
               <dd>
                 {% comment %}
                   Check if there was an uploaded file associated
                 {% endcomment %}
                  {% assign attachments = p.last | split: ',' %}
                  {% for attachment in attachments %}
                    {% if forloop.first == false %}
                      <span>, </span>
                    {% endif %}
                    {% assign upload_str = 'uploads' |  prepend: '/'  %}
                    {% if attachment contains upload_str %}
                      <a target="_blank" href="{{ attachment }}">{{ attachment | split: '/' | last }}</a>
                    {% else %}
                      {{ attachment }}
                    {% endif %}
                  {% endfor %}
               </dd>
             </div>
           {% endif %}
         {% endfor %}
       {% endif %}
       
       {% if item.is_bundle == true and item.item_components.size > 0 %}
       <div class="product-option">
        <div class="product-bundle__toggle" data-target="bundle-content-{{ item.id }}">
          <span>{{ 'cart.general.bundle_with' | t:item.item_components.size }}</span>
          <span class="chevron-icon">
            {% include 'svg-definitions' with 'icon-caret' %}
          </span>
        </div>
       </div>
       <div id="bundle-content-{{ item.id }}" class="product-bundle__content" style="display: none;">
          <ul>
            {% for component in item.item_components %}
              <li class="product-bundle__item">
                <div class="product-bundle__image">
                  <img class="cart-item__image" src="{{ component.image_url }}" alt="{{ component.product_name | escape }}" loading="lazy" width="50" height="50">
                </div>
                <div class="product-bundle__details">
                  <div class="product-bundle__name break">{{ component.quantity }} x {{ component.product_name | escape }}</div>
                  {% unless component.variant_name contains 'Default' %}
                    <div>
                      {{ component.variant_name }}
                    </div>
                  {% endunless %}
                </div>
              </li>
            {% endfor %}
          </ul>
       </div>
       {% endif %}
     </dl>


     <ul class="discounts list-unstyled" role="list" aria-label="Discount">
      {% for discount_allocation in item.line_level_discount_allocations %}
       <li class="discounts__discount">
        <svg class="icon icon-discount color-foreground-text" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21.8,12s0-.07,0-.11a1.92,1.92,0,0,0-.63-1.29c0-.06-.06-.08-1.67-1.69V7a5.24,5.24,0,0,0-.08-1.07,1.74,1.74,0,0,0-.34-.71,1.22,1.22,0,0,0-.17-.15L18.86,5a1.67,1.67,0,0,0-.94-.46h0a5.37,5.37,0,0,0-.72-.06H15.12c-.86-.86-1.31-1.3-1.57-1.53l0,0A1.93,1.93,0,0,0,12,2.2h0l-.13,0a2.06,2.06,0,0,0-1.37.7h0L8.88,4.49H6.8a2.18,2.18,0,0,0-1.74.59,1.16,1.16,0,0,0-.17.18,2.38,2.38,0,0,0-.4,1.54V8.88c-.93.93-1.39,1.39-1.62,1.66h0a2,2,0,0,0-.67,1.33s0,.07,0,.11v0l0,.13a2.06,2.06,0,0,0,.7,1.37h0l1.6,1.61v2.14a2.23,2.23,0,0,0,.45,1.54,1,1,0,0,0,.15.14.27.27,0,0,0,.07.08,1.26,1.26,0,0,0,.47.31A3.4,3.4,0,0,0,7,19.51H8.88c.86.86,1.31,1.31,1.57,1.53v0A1.89,1.89,0,0,0,12,21.8h.17a1.51,1.51,0,0,0,.9-.31,17.46,17.46,0,0,0,2.08-2H17a4.46,4.46,0,0,0,1.1-.1,1.74,1.74,0,0,0,.82-.47,1.41,1.41,0,0,0,.38-.51,3.28,3.28,0,0,0,.2-1.42V15.12c1-1,1.35-1.35,1.52-1.54h0A2.09,2.09,0,0,0,21.8,12V12Zm-1.5.16a1.63,1.63,0,0,1-.32.39s0,0,0,0l-1.71,1.72a.75.75,0,0,0-.22.53V17a2.9,2.9,0,0,1-.06.79.47.47,0,0,0-.1.1.44.44,0,0,1-.1.06A4.05,4.05,0,0,1,17,18h-2.2a.75.75,0,0,0-.53.22c-1.66,1.66-2,2-2.06,2a.27.27,0,0,1-.09.06h-.26a2,2,0,0,1-.38-.3l0,0L9.72,18.23A.75.75,0,0,0,9.19,18H7A3.31,3.31,0,0,1,6.23,18c-.06-.06-.11-.12-.17-.17A1.28,1.28,0,0,1,6,17.26V14.81a.75.75,0,0,0-.22-.53L4,12.49l0,0a1.23,1.23,0,0,1-.27-.35v0a1.41,1.41,0,0,0,0-.2h0a2.35,2.35,0,0,1,.24-.3l0-.05,1.79-1.8A.75.75,0,0,0,6,9.19V6.82c0-.42.06-.59,0-.59l.07-.07.1-.1A1.69,1.69,0,0,1,6.8,6H9.19a.75.75,0,0,0,.53-.22L11.51,4l0,0a1.23,1.23,0,0,1,.35-.27h.24a1.5,1.5,0,0,1,.38.3l0,0,1.74,1.73a.75.75,0,0,0,.53.22h2.37l.44,0h0l.13,0a.87.87,0,0,0,.17.16v0A5.55,5.55,0,0,1,18,7V9.19a.75.75,0,0,0,.22.53L20,11.54a1.62,1.62,0,0,1,.26.32v0a1.41,1.41,0,0,0,0,.2ZM15.9,8.5a.75.75,0,0,1,0,1.06L9.69,15.77a.76.76,0,0,1-1.07,0,.75.75,0,0,1,0-1.06L14.84,8.5A.75.75,0,0,1,15.9,8.5Zm-6.82,2a1,1,0,1,1,1.45,0A1,1,0,0,1,9.08,10.47Zm6.22,3.32a1,1,0,1,1-1.45,0A1,1,0,0,1,15.3,13.79Z"/></svg>
        {{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money: cart.currency }})
       </li>
      {% endfor %}
     </ul>
  </td>
  <td class="cart-item__totals right medium-hide large-up-hide">
     <div class="loading-overlay hidden">
        <div class="loading-overlay__spinner">
           <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
              <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
           </svg>
        </div>
     </div>
     <div class="cart-item__price-wrapper">
        {% if item.original_line_price > item.final_line_price %}
          <dd>
            <s class="cart-item__old-price price price--end">
             {{ item.original_line_price | money: cart.currency }}
            </s>
          </dd>
        {% endif %}
        <span class="price price--end">
         {{ item.final_line_price | money: cart.currency }}
        </span>
     </div>
  </td>
  <td class="cart-item__quantity">
     <label class="visually-hidden" for="Quantity-1">
       {{ 'cart.label.quantity' | t }}
     </label>

     <input type="hidden" name="ids[]" value="{{ item.variant_id }}">
     <input type="hidden" name="item_ids[]" value="{{item.id}}">

     {% if item.is_quantity_editable %}
      <quantity-input class="quantity">
        <button class="quantity__button no-js-hidden" name="minus" type="button">
            {% include 'svg-definitions' with 'icon-minus' %}
        </button>

        <input 
          class="quantity__input" 
          type="number" 
          name="updates[]" 
          value="{{ item.quantity }}" min="0" 
          aria-label="Quantity for {{ item.title | escape }}" 
          id="Quantity-{{item.id}}{{forloop.index}}"
          data-index="{{item.id}}{{forloop.index}}">

        <button class="quantity__button no-js-hidden" name="plus" type="button">
          {% include 'svg-definitions' with 'icon-plus' %}
        </button>
      </quantity-input>
    {% else %}
      <quantity-input class="quantity">
        <input 
          class="quantity__input" 
          type="number" 
          name="updates[]" 
          value="{{ item.quantity }}" min="0" 
          aria-label="Quantity for {{ item.title | escape }}" 
          id="Quantity-{{item.id}}{{forloop.index}}"
          data-index="{{item.id}}{{forloop.index}}"
          readonly>
      </quantity-input>
    {% endif %}
    {% if item.is_removeable %}
      <cart-remove-button id="RemoveItem-{{item.id}}{{forloop.index}}" data-index="{{item.id}}{{forloop.index}}" class="cart-action-icon">
          <a class="button button--tertiary" data-variant-id="{{item.variant_id}}" data-quantity="{{item.quantity}}" data-item-id="{{item.id}}{{forloop.index}}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true" focusable="false" role="presentation" class="icon icon-remove">
                <path d="M14 3h-3.53a3.07 3.07 0 00-.6-1.65C9.44.82 8.8.5 8 .5s-1.44.32-1.87.85A3.06 3.06 0 005.53 3H2a.5.5 0 000 1h1.25v10c0 .28.22.5.5.5h8.5a.5.5 0 00.5-.5V4H14a.5.5 0 000-1zM6.91 1.98c.23-.29.58-.48 1.09-.48s.85.19 1.09.48c.2.24.3.6.36 1.02h-2.9c.05-.42.17-.78.36-1.02zm4.84 11.52h-7.5V4h7.5v9.5z" fill="currentColor"></path>
                <path d="M6.55 5.25a.5.5 0 00-.5.5v6a.5.5 0 001 0v-6a.5.5 0 00-.5-.5zM9.45 5.25a.5.5 0 00-.5.5v6a.5.5 0 001 0v-6a.5.5 0 00-.5-.5z" fill="currentColor"></path>
            </svg>
          </a>
      </cart-remove-button>
      {% if item.is_quantity_editable %}
        <cart-edit-button id="EditItem-{{item.id}}{{forloop.index}}" data-index="{{item.id}}{{forloop.index}}" class="cart-action-icon hide">
            <a class="button button--tertiary" data-product-handle="{{item.handle}}" data-product-id="{{item.product_id}}" data-variant-id="{{item.variant_id}}" data-quantity="{{item.quantity}}" data-item-id="{{item.id}}{{forloop.index}}" data-variant-name="{{item.variant_name}}" data-properties="{{item.properties | json | escape}}">
              {% include 'svg-definitions' with 'icon-edit' %}
            </a>
        </cart-edit-button>
      {% endif %}
    {% endif %}
  </td>
  <td class="cart-item__totals right small-hide">
     <div class="loading-overlay hidden">
        <div class="loading-overlay__spinner">
           <svg aria-hidden="true" focusable="false" role="presentation" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
              <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
           </svg>
        </div>
     </div>
     <div class="cart-item__price-wrapper">
       {% if item.original_line_price > item.final_line_price %}
         <dd>
           <s class="cart-item__old-price price price--end">
             {{ item.original_line_price | money: cart.currency }}
           </s>
         </dd>
       {% endif %}
       <span class="price price--end">
         {{ item.final_line_price | money: cart.currency }}
        </span>
     </div>
  </td>
</tr>
